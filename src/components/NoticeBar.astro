---
import { NOTICE } from '../data/notice';
const n = NOTICE;
---

{
	n && (
		<div class="notice" id="notice" role="status" data-id={n.id} data-until={n.until ?? ''} hidden>
			<span class="nt">{n.text}</span>
			{n.link && <a href={n.link}>{n.linkText ?? '자세히 보기'}</a>}
			<button type="button" id="notice-x" aria-label="공지 닫기">×</button>
		</div>
	)
}

<style>
	.notice { display: flex; gap: 0.8rem; align-items: center; justify-content: center; background: #0e2150; color: #fff; padding: 0.55rem 2.6rem 0.55rem 1rem; font-size: 0.88rem; line-height: 1.45; position: relative; text-align: center; flex-wrap: wrap; }
	.notice[hidden] { display: none; }
	.notice a { color: #ffd84a; font-weight: 700; text-decoration: underline; white-space: nowrap; }
	.notice button { position: absolute; right: 0.6rem; top: 50%; transform: translateY(-50%); background: transparent; border: 0; color: #fff; font-size: 1.5rem; line-height: 1; width: 2rem; height: 2rem; cursor: pointer; }
</style>

<script>
	const el = document.getElementById('notice');
	if (el) {
		const id = el.dataset.id ?? '';
		const until = el.dataset.until ?? '';
		const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul' }).format(new Date());
		let closed = false;
		try {
			closed = localStorage.getItem('notice-closed') === id;
		} catch {}
		if (!closed && (!until || today <= until)) el.hidden = false;
		document.getElementById('notice-x')?.addEventListener('click', () => {
			el.hidden = true;
			try {
				localStorage.setItem('notice-closed', id);
			} catch {}
		});
	}
</script>
