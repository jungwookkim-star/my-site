---
import Icon from './Icon.astro';
import AskSheet from './AskSheet.astro';
import SearchBox from './SearchBox.astro';
import { SITE_TITLE, PHONE, PHONE_LINK, HOURS, BUSINESS_INFO, BIZ_ADDRESS, EMAIL, SELF_ACTIVATION_URL, KAKAO_URL } from '../consts';
const today = new Date();
---

<footer>
	<div class="ft-wrap">
		<div class="ft-brand">
			<strong class="ft-name">{SITE_TITLE}</strong>
			<p>{BUSINESS_INFO}</p>
			<p><a href="/about/#verified">앤텔레콤 사전승낙 온라인 판매점</a> (승낙일 2026.9.29)</p>
			<p>사업장 주소: {BIZ_ADDRESS}</p>
			<p>전화 <a href={PHONE_LINK}>{PHONE}</a></p>
			<p>이메일 <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
			<p>운영시간 {HOURS}</p>
		</div>
		<nav class="ft-links" aria-label="사이트 안내">
			<div>
				<h3>개통 안내</h3>
				<a href="/guide/">개통 과정 안내</a>
				<a href="/faq/">자주 묻는 질문</a>
				<a href="/region/">전국 지역별 개통 안내</a>
				<a href="/glossary/">용어 설명</a>
			</div>
			<div>
				<h3>도구와 정보</h3>
				<a href="/plans/">요금제 비교</a>
				<a href="/saving/">요금 절약 계산기</a>
				<a href="/overage/">초과 요금 계산기</a>
				<a href="/my-note/">내 개통 노트</a>
				<a href="/second-number/">세컨드 번호</a>
				<a href="/blog/">블로그</a>
				<a href="https://blog.naver.com/connect_mobile" target="_blank" rel="noopener">네이버 블로그</a>
			</div>
			<div>
				<h3>약관과 안내</h3>
				<a href="/about/">센터 소개</a>
				<a href="/terms/">이용·환불·해지 안내</a>
				<a href="/privacy/">개인정보·방문 통계 안내</a>
			</div>
			<div>
				<h3>Language</h3>
				<a href="/en/" hreflang="en" lang="en">English</a>
				<a href="/zh/" hreflang="zh-CN" lang="zh-CN">中文</a>
				<a href="/vi/" hreflang="vi" lang="vi">Tiếng Việt</a>
			</div>
		</nav>
	</div>
	<div class="ft-bottom">
		<div class="ft-btns"><button type="button" class="fs-btn" id="fs-btn" aria-pressed="false">가 글자 크게 보기</button> <button type="button" class="fs-btn" id="theme-btn" aria-pressed="false">어두운 화면으로 보기</button> <button type="button" class="fs-btn" id="pwa-btn" hidden>홈 화면에 추가</button></div>
		<p>&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
	</div>
</footer>
<div class="sticky-cta">
	<a class="call" href={PHONE_LINK}><Icon name="phone" />전화</a>
	<a class="kakao" href={KAKAO_URL} target="_blank" rel="noopener" data-ask="sticky_bar"><Icon name="chat" />카톡</a>
	<a class="self" href={SELF_ACTIVATION_URL} target="_blank" rel="noopener"><Icon name="rocket" />셀프개통</a>
</div>
<AskSheet />
<SearchBox />
<button type="button" class="to-top" id="to-top" aria-label="맨 위로" hidden>↑</button>
<style>
	.fs-btn { border: 1.5px solid rgb(var(--gray)); background: transparent; color: inherit; font: inherit; font-weight: 700; padding: 0.35rem 1rem; border-radius: 999px; cursor: pointer; margin: 0.4rem 0; }
	.fs-btn[aria-pressed='true'] { background: #0f1219; color: #fff; border-color: #0f1219; }
	html[data-theme='dark'] .fs-btn[aria-pressed='true'] { background: #dfe5ff; color: #0d1224; border-color: #dfe5ff; }
	.to-top { position: fixed; right: 1rem; bottom: 1.2rem; z-index: 45; width: 44px; height: 44px; border: 0; border-radius: 50%; background: #0f1219; color: #fff; font-size: 1.2rem; font-weight: 800; cursor: pointer; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28); opacity: 0.9; }
	.to-top:hover { opacity: 1; transform: translateY(-2px); }
	@media (max-width: 720px) { .to-top { bottom: 5.4rem; right: 0.8rem; width: 40px; height: 40px; } }
	.sticky-cta { display: none; }
	@media (max-width: 720px) {
		footer { padding-bottom: 6em !important; }
		.sticky-cta {
			display: flex; gap: 0.5rem; position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
			padding: 0.6rem 0.8rem calc(0.6rem + env(safe-area-inset-bottom)); background: var(--surface);
			box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.12);
		}
		.sticky-cta a { flex: 1; text-align: center; padding: 0.75rem 0; border-radius: 999px; font-weight: 700; text-decoration: none; color: #fff; }
		.sticky-cta .call { background: var(--accent); }
		.sticky-cta .kakao { background: #fee500; color: #191919; }
		.sticky-cta .self { background: #d92d20; flex: 1.4; }
	}
	footer {
		margin-top: 2rem;
		padding: 2.4rem 1rem 3rem;
		background: var(--surface-3);
		color: rgb(var(--gray-dark));
		font-size: 0.85rem;
		line-height: 1.6;
	}
	.ft-wrap { max-width: 960px; margin: 0 auto; display: grid; grid-template-columns: 1.25fr 2fr; gap: 2rem 3rem; text-align: left; }
	.ft-name { display: block; font-size: 1.05rem; color: var(--black, var(--ink)); margin-bottom: 0.5rem; }
	footer p { margin: 0.15em 0; color: rgb(var(--gray)); }
	footer a { color: inherit; }
	.ft-brand a { text-decoration: underline; }
	.ft-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 1.4rem 1.2rem; align-content: start; }
	.ft-links h3 { margin: 0 0 0.5rem; font-size: 0.82rem; color: var(--accent); letter-spacing: 0.02em; }
	.ft-links a { display: block; padding: 0.22rem 0; text-decoration: none; color: rgb(var(--gray-dark)); }
	.ft-links a:hover { color: var(--accent); text-decoration: underline; }
	.ft-bottom { max-width: 960px; margin: 1.8rem auto 0; padding-top: 1.2rem; border-top: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.6rem; }
	.ft-bottom p { margin: 0; }
	.ft-btns { display: flex; gap: 0.5rem; flex-wrap: wrap; }
	@media (max-width: 720px) {
		.ft-wrap { grid-template-columns: 1fr; gap: 1.6rem; }
		.ft-links { grid-template-columns: 1fr 1fr; }
		.ft-bottom { flex-direction: column; align-items: flex-start; }
	}
</style>

<script>
	const targets = document.querySelectorAll<HTMLElement>(
		'.plan, .card, .who > div, .flow li, .stats li, a.post, .feat figure, main details, .nposts li, .final, .post-cta',
	);
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
	if ('IntersectionObserver' in window && !reduce) {
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((e) => {
					if (e.isIntersecting) {
						e.target.classList.add('in');
						io.unobserve(e.target);
					}
				});
			},
			{ threshold: 0.08 },
		);
		targets.forEach((el) => {
			if (el.getBoundingClientRect().top < window.innerHeight) return;
			el.classList.add('rv');
			io.observe(el);
		});
	}
</script>

<script>
	import { SELF_ACTIVATION_URL, KAKAO_URL } from '../consts';

	// 주요 버튼 클릭을 Google Analytics 이벤트로 기록합니다.
	function track(name: string, params: Record<string, string> = {}) {
		const gtag = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
		if (gtag) gtag('event', name, { page_path: location.pathname, ...params });
	}

	document.addEventListener('click', (e) => {
		const el = e.target as HTMLElement;
		const ask = el.closest<HTMLElement>('.ask');
		if (ask) return track('plan_inquiry', { plan_name: ask.dataset.plan ?? '' });
		const a = el.closest<HTMLAnchorElement>('a[href]');
		if (!a || a.hasAttribute('data-ask')) return;
		const href = a.getAttribute('href') ?? '';
		const where = a.closest('.post-tools') ? 'blog_tools' : a.closest('.elig') ? 'checker' : a.closest('.sv') ? 'calculator' : a.closest('.ask-sheet') ? 'ask_sheet' : a.closest('.sticky-cta') ? 'sticky_bar' : a.closest('.mascot-link') ? 'mascot' : a.closest('.hero') ? 'hero' : a.closest('.final') ? 'bottom' : 'page';
		if (href.startsWith('/saving')) track('tool_click', { tool: 'calculator', from: where, from_page: location.pathname });
		else if (href.startsWith('/#check')) track('tool_click', { tool: 'checker', from: where, from_page: location.pathname });
		else if (href.startsWith(SELF_ACTIVATION_URL)) track('self_activation_click', { where });
		else if (href.startsWith(KAKAO_URL)) track('kakao_click', { where });
		else if (href.includes('blog.naver.com')) track('naver_blog_click', { where: a.dataset.nf ?? where });
		else if (href.startsWith('tel:')) track('phone_click', { where });
	});
</script>

<script>
	// 맨 위로 버튼: 충분히 내려왔을 때만 보입니다.
	const topBtn = document.getElementById('to-top');
	if (topBtn) {
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let ticking = false;
		const sync = () => {
			topBtn.hidden = window.scrollY < 900;
			ticking = false;
		};
		window.addEventListener('scroll', () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(sync);
			}
		}, { passive: true });
		topBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }));
		sync();
	}

	// PC에서는 전화 링크가 동작하지 않으므로, 누르면 번호를 복사해 줍니다. (폰은 그대로 전화 연결)
	const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
	if (canHover) {
		document.addEventListener('click', (e) => {
			const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="tel:"]');
			if (!a) return;
			e.preventDefault();
			const num = a.getAttribute('href')!.replace('tel:', '').replace(/^(\d{3})(\d{4})(\d{4})$/, '$1-$2-$3');
			const done = (msg: string) => {
				document.getElementById('copy-toast')?.remove();
				const t = document.createElement('div');
				t.id = 'copy-toast';
				t.setAttribute('role', 'status');
				t.textContent = msg;
				t.style.cssText = 'position:fixed;left:50%;bottom:2rem;transform:translateX(-50%);z-index:200;background:rgba(15,18,25,.92);color:#fff;padding:.8rem 1.2rem;border-radius:12px;font-size:.9rem';
				document.body.appendChild(t);
				setTimeout(() => t.remove(), 2800);
			};
			navigator.clipboard.writeText(num).then(
				() => done(`전화번호 ${num} 가 복사됐어요. 휴대폰으로 걸어 주세요.`),
				() => done(`전화번호는 ${num} 입니다.`),
			);
			const g = (window as unknown as { gtag?: (...x: unknown[]) => void }).gtag;
			if (g) g('event', 'phone_copy', { page_path: location.pathname });
		});
	}
</script>

<script>
	// 어두운 화면 켜기/끄기: 고른 적이 없으면 기기 설정을 따르고, 고르면 이 브라우저에 기억합니다.
	const tb = document.getElementById('theme-btn');
	if (tb) {
		const root = document.documentElement;
		const isDark = () => (root.getAttribute('data-theme') ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark';
		const paint = () => {
			tb.setAttribute('aria-pressed', String(isDark()));
			tb.textContent = isDark() ? '밝은 화면으로 보기' : '어두운 화면으로 보기';
		};
		paint();
		tb.addEventListener('click', () => {
			const next = isDark() ? 'light' : 'dark';
			root.setAttribute('data-theme', next);
			try { localStorage.setItem('theme', next); } catch { /* 저장 못 해도 이번 방문에는 적용됩니다 */ }
			paint();
			const g = (window as unknown as { gtag?: (...x: unknown[]) => void }).gtag;
			if (g) g('event', 'theme_toggle', { page_path: location.pathname, theme: next });
		});
	}
</script>

<script>
	// 글자 크게 보기 켜기/끄기 (선택은 이 브라우저에 기억됩니다)
	const fs = document.getElementById('fs-btn');
	if (fs) {
		const root = document.documentElement;
		const paint = () => {
			const on = root.classList.contains('bigtext');
			fs.setAttribute('aria-pressed', String(on));
			fs.textContent = on ? '가 글자 기본 크기로' : '가 글자 크게 보기';
		};
		paint();
		fs.addEventListener('click', () => {
			root.classList.toggle('bigtext');
			try { localStorage.setItem('bigtext', root.classList.contains('bigtext') ? '1' : '0'); } catch { /* 저장 못 해도 이번 방문에는 적용됩니다 */ }
			paint();
		});
	}

	// 이어보기: 마지막으로 본 안내 페이지를 기억해 두었다가 홈에서 보여줍니다.
	const path = location.pathname;
	const KEEP = ['/blog/', '/guide/', '/plans/', '/second-number/', '/region/', '/saving/', '/faq/'];
	const isHome = path === '/';
	try {
		if (!isHome && path !== '/blog/' && path !== '/region/' && KEEP.some((k) => path.startsWith(k))) {
			const title = document.title.split('|')[0].split(/[:：]/)[0].trim();
			localStorage.setItem('resume', JSON.stringify({ u: path, t: title, at: Date.now() }));
		}
		const box = document.getElementById('resume') as HTMLAnchorElement | null;
		if (isHome && box) {
			const r = JSON.parse(localStorage.getItem('resume') ?? 'null');
			if (r && r.u && Date.now() - r.at < 14 * 86400000) {
				box.href = r.u;
				box.textContent = `이어서 보기: ${String(r.t).slice(0, 38)} ›`;
				box.hidden = false;
			}
		}
	} catch { /* 저장소를 못 쓰면 이어보기만 생략 */ }
</script>

<script>
	// 홈 화면에 추가: 브라우저가 설치를 허용할 때만 버튼이 보입니다. (아이폰은 공유 메뉴에서 직접 추가)
	type InstallEvent = Event & { prompt: () => Promise<void>; userChoice: Promise<{ outcome: string }> };
	const pwa = document.getElementById('pwa-btn') as HTMLButtonElement | null;
	let deferred: InstallEvent | null = null;
	window.addEventListener('beforeinstallprompt', (e) => {
		e.preventDefault();
		deferred = e as InstallEvent;
		if (pwa) pwa.hidden = false;
	});
	pwa?.addEventListener('click', async () => {
		if (!deferred) return;
		await deferred.prompt();
		const choice = await deferred.userChoice;
		const g = (window as unknown as { gtag?: (...x: unknown[]) => void }).gtag;
		if (g) g('event', 'pwa_install_prompt', { outcome: choice.outcome });
		deferred = null;
		pwa.hidden = true;
	});
</script>

<style is:global>
	.fb { margin-top: 0.8rem; display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; font-size: 0.85rem; color: rgb(var(--gray)); }
	.fb button { border: 1.5px solid var(--line); background: var(--surface); font: inherit; font-size: 0.85rem; font-weight: 700; padding: 0.3rem 0.9rem; border-radius: 999px; cursor: pointer; color: rgb(var(--gray-dark)); }
	.fb button:hover { border-color: var(--accent); color: var(--accent); }
	.fb a { color: var(--accent); font-weight: 700; }
</style>

<script>
	import { KAKAO_URL } from '../consts';
	// FAQ 답변을 펼치면 "도움이 됐나요?"를 한 번 묻고, 결과를 방문 통계(GA4)에만 기록합니다.
	document.addEventListener(
		'toggle',
		(e) => {
			const d = e.target as HTMLDetailsElement;
			if (!(d instanceof HTMLDetailsElement) || !d.open || d.dataset.fb) return;
			if (!d.closest('.fg, #faq')) return;
			const answer = d.querySelector(':scope > p');
			const q = d.querySelector(':scope > summary')?.textContent?.trim();
			if (!answer || !q) return;
			d.dataset.fb = '1';
			const box = document.createElement('div');
			box.className = 'fb';
			const label = document.createElement('span');
			label.textContent = '도움이 됐나요?';
			const yes = document.createElement('button');
			yes.type = 'button';
			yes.textContent = '👍 네';
			const no = document.createElement('button');
			no.type = 'button';
			no.textContent = '👎 아니요';
			box.append(label, yes, no);
			d.appendChild(box);
			const send = (helpful: boolean) => {
				const g = (window as unknown as { gtag?: (...x: unknown[]) => void }).gtag;
				if (g) g('event', 'faq_feedback', { page_path: location.pathname, question: q.slice(0, 60), helpful: helpful ? 'yes' : 'no' });
				box.textContent = '';
				if (helpful) {
					box.textContent = '의견 고마워요!';
				} else {
					const t = document.createElement('span');
					t.textContent = '의견 고마워요. 더 궁금한 점은 ';
					const a = document.createElement('a');
					a.href = `${KAKAO_URL}/chat`;
					a.target = '_blank';
					a.rel = 'noopener';
					a.textContent = '카톡으로 물어봐 주세요';
					box.append(t, a);
				}
			};
			yes.addEventListener('click', () => send(true));
			no.addEventListener('click', () => send(false));
		},
		true,
	);
</script>
