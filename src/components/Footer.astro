---
import Icon from './Icon.astro';
import { SITE_TITLE, PHONE, PHONE_LINK, HOURS, BUSINESS_INFO, BIZ_ADDRESS, EMAIL, SELF_ACTIVATION_URL, KAKAO_URL } from '../consts';
const today = new Date();
---

<footer>
	<p><strong>{SITE_TITLE}</strong></p>
	<p>{BUSINESS_INFO}</p>
	<p>사업장 주소: {BIZ_ADDRESS}</p>
	<p>전화 <a href={PHONE_LINK}>{PHONE}</a> · 이메일 <a href={`mailto:${EMAIL}`}>{EMAIL}</a> · {HOURS}</p>
	<p><a href="/guide">개통 과정 안내</a> · <a href="/faq">자주 묻는 질문</a> · <a href="/glossary">용어 설명</a> · <a href="/terms">이용·환불·해지 안내</a> · <a href="/privacy">개인정보·방문 통계 안내</a> · <a href="/region/">전국 지역별 개통 안내</a> · <a href="https://blog.naver.com/juadsl01" target="_blank" rel="noopener">네이버 블로그</a></p>
	<p>&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
</footer>
<div class="sticky-cta">
	<a class="call" href={PHONE_LINK}><Icon name="phone" />전화</a>
	<a class="kakao" href={KAKAO_URL} target="_blank" rel="noopener"><Icon name="chat" />카톡</a>
	<a class="self" href={SELF_ACTIVATION_URL} target="_blank" rel="noopener"><Icon name="rocket" />셀프개통</a>
</div>
<style>
	.sticky-cta { display: none; }
	@media (max-width: 720px) {
		footer { padding-bottom: 6em !important; }
		.sticky-cta {
			display: flex; gap: 0.5rem; position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
			padding: 0.6rem 0.8rem calc(0.6rem + env(safe-area-inset-bottom)); background: #fff;
			box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.12);
		}
		.sticky-cta a { flex: 1; text-align: center; padding: 0.75rem 0; border-radius: 999px; font-weight: 700; text-decoration: none; color: #fff; }
		.sticky-cta .call { background: var(--accent); }
		.sticky-cta .kakao { background: #fee500; color: #191919; }
		.sticky-cta .self { background: #ff3b30; flex: 1.4; }
	}
	footer {
		padding: 2em 1em 4em 1em;
		background: transparent;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.85rem;
	}
	footer p { margin: 0.2em 0; }
</style>

<script>
	const targets = document.querySelectorAll<HTMLElement>(
		'.plan, .card, .who > div, .flow li, .stats li, .feat figure, main details, .nposts li, .final, .post-cta',
	);
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
	if ('IntersectionObserver' in window && !reduce) {
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((e) => {
					if (e.isIntersecting) {
						e.target.classList.add('in');
						io.unobserve(e.target);
					}
				});
			},
			{ threshold: 0.08 },
		);
		targets.forEach((el) => {
			if (el.getBoundingClientRect().top < window.innerHeight) return;
			el.classList.add('rv');
			io.observe(el);
		});
	}
</script>

<script>
	import { SELF_ACTIVATION_URL, KAKAO_URL } from '../consts';

	// 주요 버튼 클릭을 Google Analytics 이벤트로 기록합니다.
	function track(name: string, params: Record<string, string> = {}) {
		const gtag = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
		if (gtag) gtag('event', name, { page_path: location.pathname, ...params });
	}

	document.addEventListener('click', (e) => {
		const el = e.target as HTMLElement;
		const ask = el.closest<HTMLElement>('.ask');
		if (ask) return track('plan_inquiry', { plan_name: ask.dataset.plan ?? '' });
		const a = el.closest<HTMLAnchorElement>('a[href]');
		if (!a) return;
		const href = a.getAttribute('href') ?? '';
		const where = a.closest('.sticky-cta') ? 'sticky_bar' : a.closest('.hero') ? 'hero' : a.closest('.final') ? 'bottom' : 'page';
		if (href.startsWith(SELF_ACTIVATION_URL)) track('self_activation_click', { where });
		else if (href.startsWith(KAKAO_URL)) track('kakao_click', { where });
		else if (href.startsWith('tel:')) track('phone_click', { where });
	});
</script>
