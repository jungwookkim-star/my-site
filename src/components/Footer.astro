---
import { SITE_TITLE, PHONE, PHONE_LINK, ADDRESS, HOURS, BUSINESS_INFO } from '../consts';
const today = new Date();
---

<footer>
	<p><strong>{SITE_TITLE}</strong></p>
	<p>전화 <a href={PHONE_LINK}>{PHONE}</a> · {HOURS}</p>
	<p>{ADDRESS}</p>
	<p>{BUSINESS_INFO}</p>
	<p><a href="/region/">전국 지역별 개통 안내</a></p>
	<p>&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
</footer>
<style>
	footer {
		padding: 2em 1em 4em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.85rem;
	}
	footer p { margin: 0.2em 0; }
</style>
