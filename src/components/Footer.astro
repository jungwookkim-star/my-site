---
import Icon from './Icon.astro';
import AskSheet from './AskSheet.astro';
import SearchBox from './SearchBox.astro';
import { SITE_TITLE, PHONE, PHONE_LINK, HOURS, BUSINESS_INFO, BIZ_ADDRESS, EMAIL, SELF_ACTIVATION_URL, KAKAO_URL } from '../consts';
const today = new Date();
---

<footer>
	<p><strong>{SITE_TITLE}</strong></p>
	<p>{BUSINESS_INFO}</p>
	<p><a href="/about/#verified">앤텔레콤 사전승낙 온라인 판매점</a> (승낙일 2026.9.29)</p>
	<p>사업장 주소: {BIZ_ADDRESS}</p>
	<p>전화 <a href={PHONE_LINK}>{PHONE}</a> · 이메일 <a href={`mailto:${EMAIL}`}>{EMAIL}</a> · {HOURS}</p>
	<p><a href="/guide/">개통 과정 안내</a> · <a href="/faq/">자주 묻는 질문</a> · <a href="/saving/">요금 절약 계산기</a> · <a href="/second-number/">세컨드 번호</a> · <a href="/en/" hreflang="en" lang="en">English</a> · <a href="/glossary/">용어 설명</a> · <a href="/terms/">이용·환불·해지 안내</a> · <a href="/privacy/">개인정보·방문 통계 안내</a> · <a href="/region/">전국 지역별 개통 안내</a> · <a href="https://blog.naver.com/connect_mobile" target="_blank" rel="noopener">네이버 블로그</a></p>
	<p>&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
</footer>
<div class="sticky-cta">
	<a class="call" href={PHONE_LINK}><Icon name="phone" />전화</a>
	<a class="kakao" href={KAKAO_URL} target="_blank" rel="noopener" data-ask="sticky_bar"><Icon name="chat" />카톡</a>
	<a class="self" href={SELF_ACTIVATION_URL} target="_blank" rel="noopener"><Icon name="rocket" />셀프개통</a>
</div>
<AskSheet />
<SearchBox />
<button type="button" class="to-top" id="to-top" aria-label="맨 위로" hidden>↑</button>
<style>
	.to-top { position: fixed; right: 1rem; bottom: 1.2rem; z-index: 45; width: 44px; height: 44px; border: 0; border-radius: 50%; background: #0f1219; color: #fff; font-size: 1.2rem; font-weight: 800; cursor: pointer; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28); opacity: 0.9; }
	.to-top:hover { opacity: 1; transform: translateY(-2px); }
	@media (max-width: 720px) { .to-top { bottom: 5.4rem; right: 0.8rem; width: 40px; height: 40px; } }
	.sticky-cta { display: none; }
	@media (max-width: 720px) {
		footer { padding-bottom: 6em !important; }
		.sticky-cta {
			display: flex; gap: 0.5rem; position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
			padding: 0.6rem 0.8rem calc(0.6rem + env(safe-area-inset-bottom)); background: #fff;
			box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.12);
		}
		.sticky-cta a { flex: 1; text-align: center; padding: 0.75rem 0; border-radius: 999px; font-weight: 700; text-decoration: none; color: #fff; }
		.sticky-cta .call { background: var(--accent); }
		.sticky-cta .kakao { background: #fee500; color: #191919; }
		.sticky-cta .self { background: #d92d20; flex: 1.4; }
	}
	footer {
		padding: 2em 1em 4em 1em;
		background: transparent;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.85rem;
	}
	footer p { margin: 0.2em 0; }
</style>

<script>
	const targets = document.querySelectorAll<HTMLElement>(
		'.plan, .card, .who > div, .flow li, .stats li, a.post, .feat figure, main details, .nposts li, .final, .post-cta',
	);
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
	if ('IntersectionObserver' in window && !reduce) {
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((e) => {
					if (e.isIntersecting) {
						e.target.classList.add('in');
						io.unobserve(e.target);
					}
				});
			},
			{ threshold: 0.08 },
		);
		targets.forEach((el) => {
			if (el.getBoundingClientRect().top < window.innerHeight) return;
			el.classList.add('rv');
			io.observe(el);
		});
	}
</script>

<script>
	import { SELF_ACTIVATION_URL, KAKAO_URL } from '../consts';

	// 주요 버튼 클릭을 Google Analytics 이벤트로 기록합니다.
	function track(name: string, params: Record<string, string> = {}) {
		const gtag = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
		if (gtag) gtag('event', name, { page_path: location.pathname, ...params });
	}

	document.addEventListener('click', (e) => {
		const el = e.target as HTMLElement;
		const ask = el.closest<HTMLElement>('.ask');
		if (ask) return track('plan_inquiry', { plan_name: ask.dataset.plan ?? '' });
		const a = el.closest<HTMLAnchorElement>('a[href]');
		if (!a || a.hasAttribute('data-ask')) return;
		const href = a.getAttribute('href') ?? '';
		const where = a.closest('.post-tools') ? 'blog_tools' : a.closest('.elig') ? 'checker' : a.closest('.sv') ? 'calculator' : a.closest('.ask-sheet') ? 'ask_sheet' : a.closest('.sticky-cta') ? 'sticky_bar' : a.closest('.mascot-link') ? 'mascot' : a.closest('.hero') ? 'hero' : a.closest('.final') ? 'bottom' : 'page';
		if (href.startsWith('/saving')) track('tool_click', { tool: 'calculator', from: where, from_page: location.pathname });
		else if (href.startsWith('/#check')) track('tool_click', { tool: 'checker', from: where, from_page: location.pathname });
		else if (href.startsWith(SELF_ACTIVATION_URL)) track('self_activation_click', { where });
		else if (href.startsWith(KAKAO_URL)) track('kakao_click', { where });
		else if (href.startsWith('tel:')) track('phone_click', { where });
	});
</script>

<script>
	// 맨 위로 버튼: 충분히 내려왔을 때만 보입니다.
	const topBtn = document.getElementById('to-top');
	if (topBtn) {
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let ticking = false;
		const sync = () => {
			topBtn.hidden = window.scrollY < 900;
			ticking = false;
		};
		window.addEventListener('scroll', () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(sync);
			}
		}, { passive: true });
		topBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }));
		sync();
	}

	// PC에서는 전화 링크가 동작하지 않으므로, 누르면 번호를 복사해 줍니다. (폰은 그대로 전화 연결)
	const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
	if (canHover) {
		document.addEventListener('click', (e) => {
			const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="tel:"]');
			if (!a) return;
			e.preventDefault();
			const num = a.getAttribute('href')!.replace('tel:', '').replace(/^(\d{3})(\d{4})(\d{4})$/, '$1-$2-$3');
			const done = (msg: string) => {
				document.getElementById('copy-toast')?.remove();
				const t = document.createElement('div');
				t.id = 'copy-toast';
				t.setAttribute('role', 'status');
				t.textContent = msg;
				t.style.cssText = 'position:fixed;left:50%;bottom:2rem;transform:translateX(-50%);z-index:200;background:rgba(15,18,25,.92);color:#fff;padding:.8rem 1.2rem;border-radius:12px;font-size:.9rem';
				document.body.appendChild(t);
				setTimeout(() => t.remove(), 2800);
			};
			navigator.clipboard.writeText(num).then(
				() => done(`전화번호 ${num} 가 복사됐어요. 휴대폰으로 걸어 주세요.`),
				() => done(`전화번호는 ${num} 입니다.`),
			);
			const g = (window as unknown as { gtag?: (...x: unknown[]) => void }).gtag;
			if (g) g('event', 'phone_copy', { page_path: location.pathname });
		});
	}
</script>
