---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE, PHONE, KAKAO_URL, GA_ID, NAVER_WA_ID, EMAIL } from '../consts';
import { Font } from 'astro:assets';
import { existsSync } from 'node:fs';
import { ogKey } from '../lib/ogKey';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	jsonLd?: object | object[];
	locale?: string;
	alternates?: { hreflang: string; href: string }[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image, jsonLd, locale = 'ko_KR', alternates = [] } = Astro.props;
// 페이지별 공유 미리보기 이미지(public/og/<키>.jpg)가 있으면 그것을, 없으면 기본 이미지를 씁니다.
const pageOg = `/og/${ogKey(Astro.url.pathname)}.jpg`;
const hasPageOg = existsSync(`public${pageOg}`);
const ogImage = image ? new URL(image.src, Astro.url) : new URL(hasPageOg ? pageOg : '/og-default.png', Astro.site ?? Astro.url);
const site = Astro.site?.origin ?? 'https://connectmobile.kr';
const business = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: '커넥트모바일 선후불개통센터',
	alternateName: '커넥트모바일',
	url: site,
	logo: site + '/logo-512.png',
	telephone: PHONE,
	email: EMAIL,
	address: { '@type': 'PostalAddress', addressCountry: 'KR', addressRegion: '서울특별시', addressLocality: '금천구', streetAddress: '가산동 234-34' },
	areaServed: { '@type': 'Country', name: '대한민국' },
	sameAs: [KAKAO_URL, 'https://blog.naver.com/connect_mobile'],
	contactPoint: { '@type': 'ContactPoint', telephone: PHONE, contactType: 'customer service', availableLanguage: 'Korean', hoursAvailable: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '09:00', closes: '22:00' } },
};
const schemas = [business, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- Pretendard(SIL OFL)를 우리 서버에서 직접 제공합니다. 외부 CDN 연결 없이 글꼴 CSS를 받습니다. -->
<link rel="stylesheet" href="/fonts/pretendard/pretendard.css" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" sizes="192x192" href="/logo-512.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#2337ff" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />

<!-- Structured data -->
{schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
<meta property="og:locale" content={locale} />
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
<meta property="og:site_name" content="커넥트모바일" />

<!-- Google Analytics (실제 사이트에서만 동작) -->
<script is:inline>
	try { if (localStorage.getItem('bigtext') === '1') document.documentElement.classList.add('bigtext'); } catch (e) {}
</script>
<script is:inline define:vars={{ GA_ID }}>
	if (location.hostname === 'connectmobile.kr' || location.hostname === 'www.connectmobile.kr') {
		var s = document.createElement('script');
		s.async = true;
		s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
		document.head.appendChild(s);
		window.dataLayer = window.dataLayer || [];
		window.gtag = function () { window.dataLayer.push(arguments); };
		window.gtag('js', new Date());
		window.gtag('config', GA_ID);
	}
</script>

<!-- 네이버 애널리틱스 (실제 사이트에서만 동작) -->
<script is:inline define:vars={{ NAVER_WA_ID }}>
	if (location.hostname === 'connectmobile.kr' || location.hostname === 'www.connectmobile.kr') {
		window.wcs_add = window.wcs_add || {};
		window.wcs_add['wa'] = NAVER_WA_ID;
		var w = document.createElement('script');
		w.async = true;
		w.src = 'https://wcs.pstatic.net/wcslog.js';
		w.onload = function () {
			if (window.wcs && window.wcs_do) window.wcs_do();
		};
		document.head.appendChild(w);
	}
</script>
