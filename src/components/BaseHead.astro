---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE, PHONE, KAKAO_URL, GA_ID, NAVER_WA_ID } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	jsonLd?: object | object[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage, jsonLd } = Astro.props;
const site = Astro.site?.origin ?? 'https://connectmobile.kr';
const business = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: '커넥트모바일 선후불개통센터',
	alternateName: '커넥트모바일',
	url: site,
	telephone: PHONE,
	areaServed: { '@type': 'Country', name: '대한민국' },
	sameAs: [KAKAO_URL, 'https://blog.naver.com/juadsl01'],
	contactPoint: { '@type': 'ContactPoint', telephone: PHONE, contactType: 'customer service', availableLanguage: 'Korean' },
};
const schemas = [business, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link
	rel="stylesheet"
	href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />

<!-- Structured data -->
{schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
<meta property="og:locale" content="ko_KR" />
<meta property="og:site_name" content="커넥트모바일" />

<!-- Google Analytics (실제 사이트에서만 동작) -->
<script is:inline define:vars={{ GA_ID }}>
	if (location.hostname === 'connectmobile.kr' || location.hostname === 'www.connectmobile.kr') {
		var s = document.createElement('script');
		s.async = true;
		s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
		document.head.appendChild(s);
		window.dataLayer = window.dataLayer || [];
		window.gtag = function () { window.dataLayer.push(arguments); };
		window.gtag('js', new Date());
		window.gtag('config', GA_ID);
	}
</script>

<!-- 네이버 애널리틱스 (실제 사이트에서만 동작) -->
<script is:inline define:vars={{ NAVER_WA_ID }}>
	if (location.hostname === 'connectmobile.kr' || location.hostname === 'www.connectmobile.kr') {
		window.wcs_add = window.wcs_add || {};
		window.wcs_add['wa'] = NAVER_WA_ID;
		var w = document.createElement('script');
		w.async = true;
		w.src = 'https://wcs.pstatic.net/wcslog.js';
		w.onload = function () {
			if (window.wcs && window.wcs_do) window.wcs_do();
		};
		document.head.appendChild(w);
	}
</script>
