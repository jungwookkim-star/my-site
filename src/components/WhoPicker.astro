---
// 요금제를 고르기 전에 "누구의 폰인지"부터 고르게 합니다. 고르면 그 사람에게 맞는 개통 방법과 준비물, 다음 행동만 보여 줍니다.
// 사실 근거: 외국인과 미성년자는 대면 개통만(사이트 글 foreigner-minor-activation), 셀프개통은 만 19세 이상 내국인과 간편인증 1가지(가이드), 세컨드 번호는 신규가입(second-number).
const people = [
	{
		key: 'me',
		label: '내 폰',
		sub: '만 19세 이상 내국인',
		route: '셀프개통으로 진행해요',
		lines: ['간편인증 수단 1가지(카카오, 토스, 네이버, PASS 등)와 신분증을 준비해 주세요.', '유심은 편의점에서 8,800원에 사거나, 서울, 수도권, 광역시, 제주는 퀵 배송을 받을 수 있어요.', '유심을 받으면 약 10분이면 접수까지 끝나요.'],
		actions: [
			{ t: '요금제 찾기', href: '#finder', primary: true },
			{ t: '셀프개통 가능 확인', href: '#check' },
		],
	},
	{
		key: 'parents',
		label: '부모님 폰',
		sub: '통화 위주로 쓰세요',
		route: '부모님 명의로 개통해요. 안면인증 때 부모님이 옆에 계셔야 해요',
		lines: ['부모님 폰은 부모님 명의로 개통돼서, 안면인증과 본인인증을 할 때 부모님이 직접 하셔야 해요. 신분증과 간편인증 수단도 부모님 것이 필요해요.', '통화 위주라면 데이터가 적은 저렴한 요금제나 시니어, 복지 요금제부터 보세요.', '함께 계시기 어렵거나 인증이 어려우시면 카톡이나 전화로 진행 방법을 안내해 드려요.'],
		actions: [
			{ t: '부모님 요금제 보기', href: '/blog/senior-welfare-plans/', primary: true },
			{ t: '카톡으로 물어보기', ask: true },
		],
	},
	{
		key: 'foreigner',
		label: '외국인 가족, 지인',
		sub: '외국인 등록 또는 여권',
		route: '대면 개통만 가능해요. 방문 전 예약이 필수예요',
		lines: ['외국인은 셀프개통의 안면인증이 진행되지 않아 사업장을 방문해서 개통해요.', '준비물은 신분증, 유심비 1만원, 요금 충전비, 사용할 휴대폰이에요.', '가까운 사업장은 지역별 안내에서 확인하고, 예약할 때 희망 지역과 날짜를 알려 주세요.'],
		actions: [
			{ t: '대면 개통 방법 보기', href: '/blog/foreigner-minor-activation/', primary: true },
			{ t: '지역별 사업장 보기', href: '#regions' },
		],
	},
	{
		key: 'minor',
		label: '자녀(미성년자)',
		sub: '만 19세 미만',
		route: '대면 개통만 가능해요. 방문 전 예약이 필수예요',
		lines: ['미성년자는 서류를 직접 확인해야 해서 셀프개통을 할 수 없어요.', '법정대리인 서류가 필요하니 어떤 서류가 필요한지 예약할 때 먼저 확인해 보세요.', '개통할 지역과 가능한 날짜를 알려 주시면 사업장을 안내해 드려요.'],
		actions: [
			{ t: '서류와 예약 방법 보기', href: '/blog/foreigner-minor-activation/', primary: true },
			{ t: '지역별 사업장 보기', href: '#regions' },
		],
	},
	{
		key: 'second',
		label: '두 번째 번호',
		sub: '업무용, 인증용, 중고거래용',
		route: '신규가입으로 번호를 하나 더 만들어요',
		lines: ['쓰던 번호는 그대로 두고, 새 번호를 따로 만드는 방식이에요.', '인증 문자만 받는다면 가장 저렴한 요금제로도 충분한 경우가 많아요.', '폰 하나에 번호 두 개를 쓰는 방법(듀얼심, eSIM)도 함께 안내하고 있어요.'],
		actions: [
			{ t: '세컨드 번호 만들기', href: '/second-number/', primary: true },
			{ t: '요금제 찾기', href: '#finder' },
		],
	},
];
---

<div class="who-pick" id="who-pick">
	<p class="wp-q" id="wp-q">먼저, 누가 쓸 폰인가요?</p>
	<div class="wp-chips" role="group" aria-labelledby="wp-q">
		{
			people.map((p) => (
				<button type="button" class="wp-chip" data-who={p.key} aria-pressed="false">
					<strong>{p.label}</strong>
					<small>{p.sub}</small>
				</button>
			))
		}
	</div>
	{
		people.map((p) => (
			<div class="wp-card" data-card={p.key} hidden>
				<p class="wp-route">{p.route}</p>
				<ul>
					{p.lines.map((l) => (
						<li>{l}</li>
					))}
				</ul>
				<div class="wp-actions">
					{p.actions.map((a) =>
						a.ask ? (
							<a class="wp-btn" href="http://pf.kakao.com/_QKvfX/chat" data-ask={`who_${p.key}`}>
								{a.t}
							</a>
						) : (
							<a class={a.primary ? 'wp-btn primary' : 'wp-btn'} href={a.href} data-who-go={p.key}>
								{a.t}
							</a>
						),
					)}
				</div>
			</div>
		))
	}
</div>

<style>
	.who-pick { max-width: 760px; margin: 0 auto 1.4rem; }
	.wp-q { margin: 0 0 0.6rem; text-align: center; font-weight: 800; font-size: 1.02rem; color: rgb(var(--gray-dark)); }
	.wp-chips { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; }
	.wp-chips .wp-chip:last-child { grid-column: 1 / -1; }
	@media (min-width: 720px) {
		.wp-chips { grid-template-columns: repeat(5, 1fr); }
		.wp-chips .wp-chip:last-child { grid-column: auto; }
	}
	.wp-chip { border: 2px solid rgb(var(--gray-light)); background: #fff; border-radius: 14px; padding: 0.65rem 0.8rem; font: inherit; text-align: left; cursor: pointer; transition: border-color 0.15s, background 0.15s; }
	.wp-chip strong { display: block; font-size: 0.95rem; }
	.wp-chip small { display: block; margin-top: 0.1rem; font-size: 0.76rem; color: rgb(var(--gray)); }
	.wp-chip:hover { border-color: var(--accent); background: #f3f5ff; }
	.wp-chip[aria-pressed='true'] { border-color: var(--accent); background: #eef1ff; box-shadow: 0 0 0 1px var(--accent) inset; }
	.wp-card { margin-top: 0.8rem; background: #fff; border-radius: 16px; box-shadow: var(--box-shadow); padding: 1rem 1.2rem 1.1rem; animation: wpin 0.22s ease-out; }
	.wp-card[hidden] { display: none; }
	.wp-route { margin: 0 0 0.5rem; font-weight: 800; font-size: 1rem; color: var(--accent); }
	.wp-card ul { margin: 0; padding-left: 1.1rem; font-size: 0.9rem; line-height: 1.6; color: rgb(var(--gray-dark)); }
	.wp-card li + li { margin-top: 0.25rem; }
	.wp-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.9rem; }
	.wp-btn { display: inline-block; padding: 0.55rem 1.1rem; border-radius: 999px; font-weight: 700; font-size: 0.88rem; text-decoration: none; background: rgb(var(--gray-light)); color: inherit; }
	.wp-btn.primary { background: var(--accent); color: #fff; }
	@keyframes wpin { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
	@media (prefers-reduced-motion: reduce) { .wp-card { animation: none; } }
</style>

<script>
	const root = document.getElementById('who-pick');
	if (root) {
		const chips = root.querySelectorAll<HTMLButtonElement>('.wp-chip');
		const cards = root.querySelectorAll<HTMLElement>('.wp-card');
		const track = (name: string, params: Record<string, string>) => {
			const g = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
			if (g) g('event', name, { page_path: location.pathname, ...params });
		};
		chips.forEach((chip) =>
			chip.addEventListener('click', () => {
				const key = chip.dataset.who ?? '';
				const same = chip.getAttribute('aria-pressed') === 'true';
				chips.forEach((c) => c.setAttribute('aria-pressed', String(!same && c === chip)));
				cards.forEach((c) => (c.hidden = same || c.dataset.card !== key));
				if (!same) track('who_pick', { who: key });
			}),
		);
		root.addEventListener('click', (e) => {
			const go = (e.target as HTMLElement).closest<HTMLElement>('[data-who-go]');
			if (go) track('who_go', { who: go.dataset.whoGo ?? '', to: go.getAttribute('href') ?? '' });
		});
	}
</script>
