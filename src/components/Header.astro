---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';
import NoticeBar from './NoticeBar.astro';
---

<a class="skip" href="#main">본문 바로가기</a>
<NoticeBar />
<header>
	<nav>
		<div class="brand"><a href="/" aria-label={SITE_TITLE}><Logo /></a></div>
		<div class="internal-links">
			<HeaderLink href="/">홈</HeaderLink>
			<HeaderLink href="/plans/">요금제</HeaderLink>
			<a href="/faq/">FAQ</a>
			<HeaderLink href="/region/">지역별</HeaderLink>
			<HeaderLink href="/blog/">블로그</HeaderLink>
			<HeaderLink href="/about/">센터 소개</HeaderLink>
			<button type="button" class="search-btn" data-search-open aria-label="사이트 검색"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg></button>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	.brand {
		margin: 0;
		font-size: 1em;
	}
	.brand a,
	.brand a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	@media (max-width: 720px) {
		nav { justify-content: center; }
		.brand { width: 100%; text-align: center; padding-top: 0.6em; font-size: 1.05em; }
		.internal-links { display: flex; justify-content: center; width: 100%; }
		nav a { padding: 0.6em 0.45em; font-size: 0.92rem; white-space: nowrap; }
		.search-btn { padding: 0.6em 0.4em; }
	}
	.internal-links { display: flex; align-items: center; }
	.search-btn { border: 0; background: transparent; color: var(--black); cursor: pointer; padding: 0.6em 0.5em; display: inline-flex; align-items: center; }
	.search-btn:hover { color: var(--accent); }
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
</style>
