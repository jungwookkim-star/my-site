---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';
---

<header>
	<nav>
		<h2><a href="/" aria-label={SITE_TITLE}><Logo /></a></h2>
		<div class="internal-links">
			<HeaderLink href="/">홈</HeaderLink>
			<HeaderLink href="/plans">요금제</HeaderLink>
			<a href="/faq">FAQ</a>
			<HeaderLink href="/region">지역별</HeaderLink>
			<HeaderLink href="/blog">블로그</HeaderLink>
			<HeaderLink href="/about">센터 소개</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	@media (max-width: 720px) {
		nav { justify-content: center; }
		h2 { width: 100%; text-align: center; padding-top: 0.6em; font-size: 1.05em; }
		.internal-links { display: flex; justify-content: center; width: 100%; }
		nav a { padding: 0.6em 0.6em; font-size: 0.95rem; }
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
</style>
