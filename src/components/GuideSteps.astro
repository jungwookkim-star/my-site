---
import { guideSteps } from '../data/guideSteps';
import { KAKAO_URL, KAKAO_CHAT_URL } from '../consts';
---

<section class="gs" id="screens">
	<h2 class="sec">셀프개통 화면, 이렇게 따라 하세요</h2>
	<p class="sub">실제 개통 화면을 {guideSteps.length}단계로 정리했어요. 옆으로 넘기며 순서대로 확인하세요.</p>

	<div class="gs-card">
		<div class="gs-bar">
			<span class="gs-count" id="gs-count" aria-live="polite">1 / {guideSteps.length}단계</span>
			<span class="gs-prog" aria-hidden="true"><i id="gs-prog" style={`width:${100 / guideSteps.length}%`}></i></span>
		</div>

		<ol class="gs-track" id="gs-track" tabindex="0" aria-label="셀프개통 화면 단계별 안내">
			{
				guideSteps.map((s, i) => (
					<li class="gs-slide" data-i={i} id={`screen-${s.n}`}>
						<div class="gs-figs">
							{s.imgs.map((src) => (
								<img src={`/guide/${src}`} alt={`${s.n}단계 화면: ${s.title}`} width="560" height="1000" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
							))}
						</div>
						<div class="gs-text">
							<span class="gs-n">{s.n}단계</span>
							<h3>{s.title}</h3>
							<p>{s.desc}</p>
							<div class="gs-act">
								<button type="button" class="gs-copy" data-n={s.n}>이 단계 링크 복사</button>
								<a class="gs-stuck" href={KAKAO_CHAT_URL} target="_blank" rel="noopener" data-n={s.n} data-t={s.title}>여기서 막혔어요 (카톡)</a>
							</div>
							{s.n === guideSteps.length && (
								<a class="gs-ch" href={`${KAKAO_URL}/friend`} target="_blank" rel="noopener">카카오 채널 추가하기</a>
							)}
						</div>
					</li>
				))
			}
		</ol>

		<div class="gs-nav">
			<button type="button" id="gs-prev" aria-label="이전 단계" disabled>‹ 이전</button>
			<button type="button" id="gs-next" aria-label="다음 단계">다음 ›</button>
		</div>
	</div>

	<details class="gs-list">
		<summary>{guideSteps.length}단계 한눈에 보기</summary>
		<ol>
			{guideSteps.map((s, i) => <li><button type="button" data-jump={i}>{s.title}</button></li>)}
		</ol>
	</details>
	<p class="gs-note">화면은 앤텔레콤 셀프개통 기준이며, 사정에 따라 바뀔 수 있어요. 막히면 바로 <a href={KAKAO_URL} target="_blank" rel="noopener">카카오톡</a>으로 물어보세요. (이미지 속 개인정보는 가렸어요.)</p>
</section>

<style>
	.gs { margin-top: 3rem; }
	.gs-card { max-width: 860px; margin: 1.2rem auto 0; background: var(--surface); border-radius: 22px; box-shadow: var(--box-shadow); overflow: hidden; }
	.gs-bar { display: flex; align-items: center; gap: 0.8rem; padding: 0.9rem 1.2rem; border-bottom: 1px solid #e8ecff; }
	.gs-count { font-weight: 800; font-size: 0.92rem; color: var(--accent); white-space: nowrap; }
	.gs-prog { flex: 1; height: 6px; border-radius: 999px; background: var(--surface-2); overflow: hidden; }
	.gs-prog i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #5b6bff, #2337ff); transition: width 0.25s; }
	.gs-track { list-style: none; margin: 0; padding: 0; display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; outline-offset: -3px; }
	.gs-track::-webkit-scrollbar { display: none; }
	.gs-slide { flex: 0 0 100%; scroll-snap-align: start; display: grid; grid-template-columns: auto 1fr; gap: 1.4rem 2rem; align-items: center; padding: 1.4rem 1.6rem; box-sizing: border-box; }
	.gs-figs { display: flex; gap: 0.8rem; justify-content: center; }
	.gs-figs img { width: auto; max-width: 100%; height: auto; max-height: 520px; margin: 0; border-radius: 14px; background: var(--surface-3); }
	.gs-text { min-width: 0; }
	.gs-n { display: inline-block; background: var(--surface-2); color: var(--accent); font-weight: 800; font-size: 0.82rem; padding: 0.2rem 0.8rem; border-radius: 999px; }
	.gs-text h3 { margin: 0.5rem 0 0.4rem; font-size: 1.3rem; line-height: 1.35; }
	.gs-text p { margin: 0; color: rgb(var(--gray-dark)); font-size: 1rem; line-height: 1.7; }
	.gs-act { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
	.gs-copy { border: 0; background: transparent; color: rgb(var(--gray-dark)); font: inherit; font-size: 0.85rem; font-weight: 700; text-decoration: underline; cursor: pointer; padding: 0.4rem 0.3rem; }
	.gs-copy:hover { color: var(--accent); }
	.gs-stuck { background: #fee500; color: #191919; font-size: 0.85rem; font-weight: 800; text-decoration: none; padding: 0.45rem 1rem; border-radius: 999px; }
	.gs-ch { display: inline-block; margin-top: 0.9rem; background: #fee500; color: #191919; font-weight: 800; text-decoration: none; padding: 0.6rem 1.3rem; border-radius: 999px; }
	.gs-nav { display: flex; justify-content: space-between; gap: 0.6rem; padding: 0.8rem 1.2rem 1.1rem; }
	.gs-nav button { flex: 1; max-width: 200px; border: 0; background: var(--accent); color: #fff; font: inherit; font-weight: 800; padding: 0.7rem 1rem; border-radius: 999px; cursor: pointer; }
	.gs-nav button:last-child { margin-left: auto; }
	.gs-nav button:disabled { background: var(--surface-2); color: #9aa3cf; cursor: default; }
	.gs-list { max-width: 860px; margin: 1rem auto 0; background: var(--surface); border-radius: 14px; box-shadow: var(--box-shadow); padding: 0.8rem 1.2rem; }
	.gs-list summary { cursor: pointer; font-weight: 700; min-height: 2rem; }
	.gs-list ol { margin: 0.6rem 0 0; padding-left: 1.4rem; display: grid; gap: 0.1rem 1.5rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
	.gs-list button { border: 0; background: none; font: inherit; color: var(--accent); text-align: left; cursor: pointer; padding: 0.3rem 0; text-decoration: underline; }
	.gs-note { max-width: 860px; margin: 0.8rem auto 0; font-size: 0.82rem; color: rgb(var(--gray)); text-align: center; }
	@media (max-width: 720px) {
		.gs-slide { grid-template-columns: 1fr; padding: 1rem 1rem 0.4rem; }
		.gs-figs { flex-direction: column; align-items: center; }
		.gs-figs img { max-height: 460px; }
		.gs-text h3 { font-size: 1.15rem; }
	}
</style>

<script>
	const track = document.getElementById('gs-track');
	const count = document.getElementById('gs-count');
	const prog = document.getElementById('gs-prog');
	const prev = document.getElementById('gs-prev') as HTMLButtonElement | null;
	const next = document.getElementById('gs-next') as HTMLButtonElement | null;
	if (track && count && prog && prev && next) {
		const total = track.children.length;
		let cur = 0;
		let maxSeen = 0;
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const go = (i: number) => {
			const t = Math.max(0, Math.min(total - 1, i));
			// 한두 단계 이동은 부드럽게, 멀리 건너뛸 때는 바로 이동합니다.
			const far = Math.abs(t - cur) > 1;
			track.scrollTo({ left: t * track.clientWidth, behavior: reduce || far ? 'auto' : 'smooth' });
		};
		const gtag = (...a: unknown[]) => {
			const g = (window as unknown as { gtag?: (...x: unknown[]) => void }).gtag;
			if (g) g(...a);
		};
		const paint = () => {
			const i = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
			if (i === cur && count.textContent) return;
			cur = Math.max(0, Math.min(total - 1, i));
			count.textContent = `${cur + 1} / ${total}단계`;
			prog.style.width = `${((cur + 1) / total) * 100}%`;
			prev.disabled = cur === 0;
			next.disabled = cur === total - 1;
			if (cur + 1 > maxSeen) {
				maxSeen = cur + 1;
				if ([5, 10, 15, 20].includes(maxSeen)) gtag('event', 'guide_screens_step', { page_path: location.pathname, step: String(maxSeen) });
			}
		};
		let raf = 0;
		track.addEventListener('scroll', () => {
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(paint);
		}, { passive: true });
		prev.addEventListener('click', () => go(cur - 1));
		next.addEventListener('click', () => go(cur + 1));
		track.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1); }
			else if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1); }
		});
		document.querySelectorAll<HTMLButtonElement>('[data-jump]').forEach((b) => b.addEventListener('click', () => {
			go(Number(b.dataset.jump));
			document.getElementById('screens')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
		}));
		window.addEventListener('resize', () => go(cur));
		// 주소가 #screen-숫자 이면 그 단계를 바로 보여 줍니다. (막힘 도움 칩, 공유 링크용)
		const fromHash = () => {
			const m = location.hash.match(/^#screen-([0-9]+)$/);
			if (!m) return;
			const n = Number(m[1]);
			if (n < 1 || n > total) return;
			track.scrollTo({ left: (n - 1) * track.clientWidth, behavior: 'auto' });
			// 이미 같은 위치라 스크롤 이벤트가 안 올 수 있으니 표시를 직접 갱신합니다.
			requestAnimationFrame(paint);
			setTimeout(paint, 250);
			document.getElementById('screens')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
		};
		const toast = (msg: string) => {
			document.getElementById('gs-toast')?.remove();
			const d = document.createElement('div');
			d.id = 'gs-toast';
			d.setAttribute('role', 'status');
			d.textContent = msg;
			d.style.cssText = 'position:fixed;left:50%;bottom:5.5rem;transform:translateX(-50%);z-index:200;background:rgba(15,18,25,.92);color:#fff;padding:.8rem 1.2rem;border-radius:12px;font-size:.9rem;max-width:calc(100% - 2rem);text-align:center;line-height:1.5';
			document.body.appendChild(d);
			setTimeout(() => d.remove(), 3500);
		};
		document.addEventListener('click', (e) => {
			const el = e.target as HTMLElement;
			const copyBtn = el.closest<HTMLElement>('.gs-copy');
			if (copyBtn) {
				const url = `${location.origin}/guide/#screen-${copyBtn.dataset.n}`;
				navigator.clipboard.writeText(url).then(() => toast(`${copyBtn.dataset.n}단계 링크가 복사됐어요. 카톡으로 보내 보세요.`), () => toast('주소: ' + url));
				gtag('event', 'guide_step_link_copy', { page_path: location.pathname, step: copyBtn.dataset.n ?? '' });
				return;
			}
			const stuck = el.closest<HTMLElement>('.gs-stuck');
			if (stuck) {
				const text = `개통 ${stuck.dataset.n}단계(${stuck.dataset.t})에서 막혔어요.
(막힌 화면이나 문구:  )`;
				navigator.clipboard.writeText(text).then(() => toast('막힌 단계가 복사됐어요. 카톡 채팅창에 붙여넣기 해 주세요.'), () => {});
				gtag('event', 'guide_step_stuck', { page_path: location.pathname, step: stuck.dataset.n ?? '' });
			}
		});
		window.addEventListener('hashchange', fromHash);
		setTimeout(fromHash, 150);
		setTimeout(paint, 400);
	}
</script>
