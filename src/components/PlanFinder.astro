---
import PlanCards from './PlanCards.astro';
import { ktPrepaid, lgPrepaid, type PrepaidPlan } from '../data/prepaidPlans';
import { postpaidPartners } from '../data/postpaidPlans';

// 사용량 단계: 1 통화·문자 위주 / 2 가벼운 인터넷 / 3 영상·SNS 많이
const prepaidTier: Record<string, number> = {
	'선불 LTE 기본1': 1,
	'선불 300MB 라이트': 2,
	'LTE 선불 396 10.3GB': 3,
	'LTE 선불 459 20.3GB': 3,
	'LTE 선불선택 770': 3,
	'LTE 비디오': 3,
	'L망 선불 기본1': 1,
	'L망 선불 데이터 2.5GB': 2,
	'L망 선불 300분': 1,
	'L망 선불 300M 라이트': 2,
	'L망 선불 396 10.3GB': 3,
	'L망 5G 선불 20GB+': 3,
};
const alddeulTier = (tier: string) => (/일2GB|100GB/.test(tier) ? 3 : 2);
const won = (p: PrepaidPlan) => Number(p.price.replace(/[^0-9]/g, ''));
// 월 데이터량(GB) 추정: 기본 제공량 + 일 제공량 x 30
const gbOf = (p: PrepaidPlan) => {
	const gb = p.data.match(/([\d.]+)\s*GB/);
	const mb = p.data.match(/([\d.]+)\s*MB/);
	const daily = p.data.match(/일\s*(\d+)\s*GB/);
	const base = gb ? Number(gb[1]) : mb ? Number(mb[1]) / 1000 : 0;
	return base + (daily ? Number(daily[1]) * 30 : 0);
};

interface Item {
	plan: PrepaidPlan;
	kind: 'prepaid' | 'alddeul';
	tier: number;
	price: number;
	gb: number;
}

const items: Item[] = [];
for (const p of [...ktPrepaid, ...lgPrepaid]) {
	items.push({ plan: p, kind: 'prepaid', tier: prepaidTier[p.name] ?? 2, price: won(p), gb: gbOf(p) });
}

// 알뜰 요금제는 조건(요금·데이터)이 같은 제휴처끼리 한 카드로 묶습니다.
const groups = new Map<string, { partners: string[]; tier: string; plan: PrepaidPlan }>();
for (const partner of postpaidPartners) {
	for (const p of partner.plans) {
		const tier = p.name.slice(partner.name.length + 1);
		const sig = `${tier}|${p.price}|${p.data}|${p.note ?? ""}`;
		const g = groups.get(sig);
		if (g) g.partners.push(partner.name);
		else groups.set(sig, { partners: [partner.name], tier, plan: p });
	}
}
for (const g of groups.values()) {
	items.push({
		plan: {
			...g.plan,
			name: `${g.partners.join('·')} ${g.tier}`,
			note: [g.plan.note, g.partners.length > 1 ? '제휴처별 혜택은 상담 시 안내해 드립니다.' : ''].filter(Boolean).join(' / ') || undefined,
		},
		kind: 'alddeul',
		tier: alddeulTier(g.tier),
		price: won(g.plan),
		gb: gbOf(g.plan),
	});
}
---

<div class="finder" id="finder-box">
	<div class="f-head">
		<span class="f-step" aria-live="polite"></span>
		<button type="button" class="f-back" hidden>← 이전</button>
	</div>
	<h3 class="f-q"></h3>
	<div class="f-opts"></div>
	<div class="f-result" hidden>
		<p class="f-msg"></p>
		<div class="f-cards"></div>
		<div class="f-actions">
			<button type="button" class="f-retry">다시 찾아보기</button>
		</div>
	</div>
</div>

<template id="finder-pool">
	{
		items.map((i) => (
			<div data-kind={i.kind} data-tier={i.tier} data-price={i.price} data-gb={i.gb}>
				<PlanCards plans={[i.plan]} />
			</div>
		))
	}
</template>

<style is:global>
	.finder { background: #fff; border-radius: 18px; box-shadow: var(--box-shadow); padding: 1.6rem 1.4rem; max-width: 640px; margin: 0 auto; }
	.f-head { display: flex; justify-content: space-between; align-items: center; min-height: 1.6rem; }
	.f-step { font-size: 0.8rem; font-weight: 700; color: var(--accent); }
	.f-back { border: 0; background: none; font: inherit; font-size: 0.85rem; color: rgb(var(--gray)); cursor: pointer; }
	.f-q { margin: 0.4rem 0 1rem; font-size: 1.25rem; line-height: 1.4; text-align: center; }
	.f-opts { display: grid; gap: 0.6rem; }
	.f-opts button { border: 2px solid rgb(var(--gray-light)); background: #fff; border-radius: 14px; padding: 0.9rem 1rem; font: inherit; font-weight: 700; font-size: 0.98rem; cursor: pointer; text-align: left; transition: border-color 0.15s, background 0.15s; }
	.f-opts button small { display: block; font-weight: 400; color: rgb(var(--gray)); font-size: 0.8rem; margin-top: 0.15rem; }
	.f-opts button:hover { border-color: var(--accent); background: #f3f5ff; }
	.f-msg { text-align: center; margin: 0.4rem 0 1rem; font-size: 0.92rem; color: rgb(var(--gray-dark)); }
	.f-cards { display: grid; gap: 0.9rem; }
	.f-actions { text-align: center; margin-top: 1.2rem; }
	.f-retry { border: 0; background: rgb(var(--gray-light)); border-radius: 999px; padding: 0.55rem 1.3rem; font: inherit; font-weight: 700; cursor: pointer; }
</style>

<script>
	type Step = { q: string; key: 'usage' | 'budget' | 'benefit'; opts: { v: string; label: string; sub?: string }[] };
	const steps: Step[] = [
		{
			q: '주로 어떻게 쓰세요?',
			key: 'usage',
			opts: [
				{ v: '1', label: '통화·문자 위주예요', sub: '데이터는 거의 안 써요' },
				{ v: '2', label: '가볍게 인터넷을 써요', sub: '메신저, 검색, 지도 정도' },
				{ v: '3', label: '영상·SNS를 많이 봐요', sub: '데이터를 넉넉하게 쓰고 싶어요' },
			],
		},
		{
			q: '한 달 예산은 어느 정도인가요?',
			key: 'budget',
			opts: [
				{ v: 'low', label: '2만 원 이하' },
				{ v: 'mid', label: '2만 ~ 4만 원' },
				{ v: 'high', label: '4만 원 이상도 괜찮아요' },
			],
		},
		{
			q: '제휴 혜택도 받고 싶으세요?',
			key: 'benefit',
			opts: [
				{ v: 'yes', label: '네, 혜택이 있으면 좋아요', sub: '네이버페이·CU·다이소·올리브영 등 (알뜰 요금제)' },
				{ v: 'no', label: '아니요, 상관없어요', sub: '선불·알뜰 모두 보여주세요' },
			],
		},
	];
	const caps: Record<string, number> = { low: 20000, mid: 40000, high: Infinity };

	const root = document.getElementById('finder-box');
	const pool = document.getElementById('finder-pool') as HTMLTemplateElement | null;
	if (root && pool) {
		const stepEl = root.querySelector<HTMLElement>('.f-step')!;
		const backEl = root.querySelector<HTMLButtonElement>('.f-back')!;
		const qEl = root.querySelector<HTMLElement>('.f-q')!;
		const optsEl = root.querySelector<HTMLElement>('.f-opts')!;
		const resultEl = root.querySelector<HTMLElement>('.f-result')!;
		const msgEl = root.querySelector<HTMLElement>('.f-msg')!;
		const cardsEl = root.querySelector<HTMLElement>('.f-cards')!;
		const retryEl = root.querySelector<HTMLButtonElement>('.f-retry')!;

		const items = Array.from(pool.content.children).map((el) => ({
			el: el as HTMLElement,
			kind: (el as HTMLElement).dataset.kind!,
			tier: Number((el as HTMLElement).dataset.tier),
			price: Number((el as HTMLElement).dataset.price),
			gb: Number((el as HTMLElement).dataset.gb),
		}));

		let i = 0;
		let answers: Record<string, string> = {};

		const track = (params: Record<string, string>) => {
			const g = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
			if (g) g('event', 'finder_result', { page_path: location.pathname, ...params });
		};

		function showStep() {
			const s = steps[i];
			resultEl.hidden = true;
			qEl.hidden = false;
			optsEl.hidden = false;
			stepEl.textContent = `${i + 1} / ${steps.length}`;
			backEl.hidden = i === 0;
			qEl.textContent = s.q;
			optsEl.innerHTML = '';
			s.opts.forEach((o) => {
				const b = document.createElement('button');
				b.type = 'button';
				b.innerHTML = o.label + (o.sub ? `<small>${o.sub}</small>` : '');
				b.addEventListener('click', () => {
					answers[s.key] = o.v;
					if (i < steps.length - 1) {
						i++;
						showStep();
					} else showResult();
				});
				optsEl.appendChild(b);
			});
		}

		function showResult() {
			const usage = Number(answers.usage);
			const cap = caps[answers.budget];
			const wantBenefit = answers.benefit === 'yes';
			const cands = items
				.filter((it) => it.price <= cap && (!wantBenefit || it.kind === 'alddeul'))
				.sort((a, b) => Math.abs(a.tier - usage) - Math.abs(b.tier - usage) || (usage === 3 ? b.gb - a.gb || a.price - b.price : a.price - b.price))
				.slice(0, 3);

			qEl.hidden = true;
			optsEl.hidden = true;
			backEl.hidden = true;
			stepEl.textContent = '추천 결과';
			resultEl.hidden = false;
			cardsEl.innerHTML = '';
			const exact = cands.length > 0 && cands.every((c) => c.tier === usage);
			msgEl.textContent = cands.length === 0
				? '조건에 딱 맞는 요금제를 찾지 못했어요. 카카오톡이나 전화로 문의해 주시면 맞는 요금제를 찾아 드립니다.'
				: exact
					? '선택하신 조건에 맞는 요금제예요.'
					: '예산 안에서 가장 가까운 요금제를 골랐어요. 예산을 조금 늘리면 선택지가 더 넓어져요.';
			cands.forEach((c) => cardsEl.appendChild(c.el.cloneNode(true)));
			track({ usage: answers.usage, budget: answers.budget, benefit: answers.benefit, count: String(cands.length) });
			root!.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		}

		backEl.addEventListener('click', () => {
			if (i > 0) {
				i--;
				showStep();
			}
		});
		retryEl.addEventListener('click', () => {
			i = 0;
			answers = {};
			showStep();
		});
		showStep();
	}
</script>
