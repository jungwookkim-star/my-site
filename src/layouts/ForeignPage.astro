---
import BaseHead from '../components/BaseHead.astro';
import { items } from '../lib/planItems';
import { REGIONS } from '../data/regions';
import { FOREIGN_LANGS, type ForeignLang } from '../data/foreignLang';
import { PHONE, PHONE_LINK, KAKAO_URL, REPRESENTATIVE, BIZ_ADDRESS } from '../consts';

interface Props {
	lang: ForeignLang;
}
const { lang: t } = Astro.props;

// 요금은 사이트의 요금제 데이터에서 읽어 옵니다. (요금이 바뀌면 이 페이지도 같이 바뀝니다)
const priceOf = (name: string) => items.find((i) => i.plan.name === name)?.plan.price.replace('원', '') ?? null;
const planRows = [
	{ net: 'KT', name: '선불 LTE 기본1' },
	{ net: 'KT', name: '선불 300MB 라이트' },
	{ net: 'KT', name: 'LTE 선불 396 10.3GB' },
	{ net: 'KT', name: 'LTE 선불 459 20.3GB' },
	{ net: 'LG', name: 'L망 선불 기본1' },
	{ net: 'LG', name: 'L망 선불 데이터 2.5GB' },
	{ net: 'LG', name: 'L망 선불 396 10.3GB' },
	{ net: 'LG', name: 'L망 5G 선불 20GB+' },
]
	.map((r) => ({ ...r, price: priceOf(r.name), desc: t.planDesc[r.name] }))
	.filter((r) => r.price && r.desc);

const withCenter = REGIONS.filter((r) => r.centers.length > 0);
const site = 'https://connectmobile.kr';
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	inLanguage: t.htmlLang,
	mainEntity: t.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const alternates = [
	{ hreflang: 'ko', href: `${site}/` },
	{ hreflang: 'en', href: `${site}/en/` },
	...FOREIGN_LANGS.map((l) => ({ hreflang: l.htmlLang, href: `${site}/${l.code}/` })),
	{ hreflang: 'x-default', href: `${site}/` },
];
const msgLines = ['외국인 방문 개통 예약 문의드립니다.', '성함:', '연락처:', '방문 희망 지역:', '방문 희망 날짜와 시간:', '선택한 요금제:'];
---

<!doctype html>
<html lang={t.htmlLang}>
	<head>
		<BaseHead title={t.title} description={t.description} locale={t.locale} alternates={alternates} jsonLd={[faqSchema]} />
		<style is:global>
					.en-top { background: var(--surface); box-shadow: 0 2px 8px rgba(var(--black), 5%); }
					.en-top > div { max-width: 960px; margin: 0 auto; padding: 0.7rem 1rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
					.en-top a.brand { display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none; color: rgb(var(--black)); font-weight: 800; letter-spacing: -0.01em; }
					.en-top a.brand img { width: 2.2rem; height: 2.2rem; margin: 0; border-radius: 10px; }
					.en-top a.ko { font-weight: 700; font-size: 0.9rem; text-decoration: none; padding: 0.4rem 0.9rem; border-radius: 999px; box-shadow: inset 0 0 0 2px var(--accent); }
					.en { width: auto; max-width: 860px; margin: 0 auto; padding: 1rem 1rem 3rem; font-size: 1rem; line-height: 1.65; word-break: normal; }
					.en h1, .en h2, .en h3 { word-break: normal; text-wrap: balance; }
					.en-hero { text-align: center; padding: 2.2rem 0 1rem; }
					.en-hero .tag { display: inline-block; background: var(--surface-2); color: var(--accent); font-weight: 800; font-size: 0.82rem; padding: 0.3rem 0.9rem; border-radius: 999px; }
					.en-hero h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0.8rem 0 0.6rem; background: linear-gradient(90deg, #1b2bd6, #6d3df0); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
					.en-hero p { color: rgb(var(--gray-dark)); margin: 0 auto; max-width: 560px; }
					.en-cta { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; margin-top: 1.4rem; }
					.en-cta .btn { display: inline-block; padding: 0.75rem 1.4rem; border-radius: 999px; font-weight: 800; text-decoration: none; background: var(--accent); color: #fff; box-shadow: 0 4px 12px rgba(35, 55, 255, 0.25); }
					.en-cta .btn.alt { background: #fee500; color: #191919; box-shadow: 0 4px 12px rgba(254, 229, 0, 0.45); }
					.en-cta .btn.ghost { background: var(--surface); color: var(--accent); box-shadow: inset 0 0 0 2px var(--accent); }
					.en-sec { margin-top: 3rem; }
					.en-sec h2 { font-size: 1.5rem; text-align: center; margin-bottom: 1rem; }
					.en-card { background: var(--surface); border-radius: 18px; box-shadow: var(--box-shadow); padding: 1.3rem 1.4rem; border: 1px solid rgba(var(--gray), 0.1); }
					.en-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.9rem; }
					.en-facts .en-card strong { display: block; font-size: 1.05rem; margin-bottom: 0.25rem; }
					.en-facts .en-card p { margin: 0; font-size: 0.92rem; color: rgb(var(--gray-dark)); }
					.en-steps { list-style: none; counter-reset: s; margin: 0; padding: 0; display: grid; gap: 0.8rem; }
					.en-steps li { counter-increment: s; position: relative; padding: 1rem 1.2rem 1rem 3.6rem; background: var(--surface); border-radius: 16px; box-shadow: var(--box-shadow); }
					.en-steps li::before { content: counter(s); position: absolute; left: 1rem; top: 1rem; width: 2rem; height: 2rem; border-radius: 50%; background: var(--accent); color: #fff; font-weight: 800; display: grid; place-items: center; }
					.en-steps b { display: block; }
					.en-table { width: 100%; border-collapse: collapse; background: var(--surface); border-radius: 16px; overflow: hidden; box-shadow: var(--box-shadow); font-size: 0.92rem; }
					.en-table th, .en-table td { text-align: left; padding: 0.7rem 0.9rem; border-bottom: 1px solid rgb(var(--gray-light)); vertical-align: top; }
					.en-table th { background: var(--surface-3); font-size: 0.82rem; }
					.en-table td.price { font-weight: 800; color: var(--accent); white-space: nowrap; }
					.en-note { font-size: 0.85rem; color: rgb(var(--gray)); margin: 0.8rem 0 0; }
					.en-msg { background: var(--surface-3); border: 1px dashed var(--line); border-radius: 14px; padding: 1rem 1.2rem; font-size: 0.95rem; white-space: pre-line; margin: 0 0 0.8rem; }
					.en-copy { font: inherit; font-weight: 800; border: 0; border-radius: 999px; padding: 0.55rem 1.2rem; background: var(--accent); color: #fff; cursor: pointer; }
					.en-regions { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-top: 0.8rem; }
					.en-regions a { padding: 0.35rem 0.9rem; border-radius: 999px; background: var(--surface); box-shadow: var(--box-shadow); font-size: 0.88rem; font-weight: 700; text-decoration: none; color: rgb(var(--gray-dark)); }
					.en details { background: var(--surface); border-radius: 14px; box-shadow: var(--box-shadow); padding: 0.85rem 1.2rem; margin-bottom: 0.7rem; }
					.en summary { cursor: pointer; font-weight: 700; }
					.en details p { margin: 0.6rem 0 0; font-size: 0.93rem; }
					.en-foot { background: linear-gradient(rgba(var(--gray-light), 50%), #fff); padding: 2rem 1rem 3rem; text-align: center; color: rgb(var(--gray)); font-size: 0.85rem; }
					.en-foot p { margin: 0.2rem 0; }
					@media (max-width: 720px) {
						.en-table th, .en-table td { padding: 0.6rem 0.6rem; font-size: 0.86rem; }
						.en-cta .btn { flex: 1 1 100%; text-align: center; }
					}
				</style>
	</head>
	<body>
		<div class="en-top">
			<div>
				<a class="brand" href={`/${t.code}/`}><img src="/brand/mark.png" alt="" width="36" height="36" />{t.brand}</a>
				<a class="ko" href="/" hreflang="ko" lang="ko">한국어</a>
			</div>
		</div>

		<main class="en" id="main">
			<section class="en-hero">
				<span class="tag">{t.tag}</span>
				<h1>{t.h1}</h1>
				<p>{t.lead}</p>
				<div class="en-cta">
					<a class="btn alt" href={KAKAO_URL} target="_blank" rel="noopener">{t.ctaKakao}</a>
					<a class="btn ghost" href={PHONE_LINK}>{t.ctaCall} {PHONE}</a>
				</div>
			</section>

			<section class="en-sec">
				<h2>{t.factsTitle}</h2>
				<div class="en-facts">
					{t.facts.map((f) => <div class="en-card"><strong>{f.t}</strong><p>{f.d}</p></div>)}
				</div>
			</section>

			<section class="en-sec">
				<h2>{t.howTitle}</h2>
				<ol class="en-steps">
					{t.steps.map((s) => <li><b>{s.b}</b>{s.d}</li>)}
				</ol>
			</section>

			<section class="en-sec">
				<h2>{t.tmplTitle}</h2>
				<p class="en-note" style="text-align:center;margin:0 0 0.8rem">{t.tmplNote}</p>
				<div class="en-msg" id="en-msg">{msgLines.map((l, i) => <Fragment>{l}{i < msgLines.length - 1 && <br />}</Fragment>)}</div>
				<div class="en-cta" style="margin-top:0">
					<button type="button" class="en-copy" id="en-copy" data-copy={t.copy} data-copied={t.copied} data-manual={t.copyManual}>{t.copy}</button>
					<a class="btn alt" href={KAKAO_URL} target="_blank" rel="noopener" style="padding:0.55rem 1.2rem">{t.openKakao}</a>
				</div>
			</section>

			<section class="en-sec">
				<h2>{t.plansTitle}</h2>
				<table class="en-table">
					<thead><tr><th>{t.thNet}</th><th>{t.thPlan}</th><th>{t.thPrice}</th></tr></thead>
					<tbody>
						{planRows.map((r) => <tr><td>{t.nets[r.net as 'KT' | 'LG']}</td><td>{r.desc}</td><td class="price">{r.price} {t.krw}</td></tr>)}
					</tbody>
				</table>
				<p class="en-note">{t.plansNote} <a href="/plans/" hreflang="ko">→ 요금제 페이지 (한국어)</a></p>
			</section>

			<section class="en-sec">
				<h2>{t.whereTitle}</h2>
				<div class="en-card">
					<p style="margin:0">{t.whereGasan}</p>
					<p style="margin:0.7rem 0 0">{t.whereOther}</p>
					<div class="en-regions">
						{withCenter.map((r) => <a href={`/region/${r.slug}/`} hreflang="ko">{t.regionNames[r.slug] ?? r.name}</a>)}
					</div>
					<p class="en-note" style="text-align:center">{t.regionNote}</p>
				</div>
			</section>

			<section class="en-sec">
				<h2>{t.faqTitle}</h2>
				{t.faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
			</section>
		</main>

		<footer class="en-foot">
			<p><strong>Connect Mobile (커넥트모바일)</strong> · {t.footBiz}</p>
			<p>{t.footReg}{REPRESENTATIVE}</p>
			<p>{BIZ_ADDRESS}</p>
			<p>{PHONE} · {t.footHours}</p>
			<p><a href="/">{t.koSite}</a> · <a href="/en/" hreflang="en">English</a>{FOREIGN_LANGS.filter((l) => l.code !== t.code).map((l) => <Fragment> · <a href={`/${l.code}/`} hreflang={l.htmlLang}>{l.label}</a></Fragment>)}</p>
		</footer>

		<script>
			const btn = document.getElementById('en-copy');
			const msg = document.getElementById('en-msg');
			btn?.addEventListener('click', async () => {
				const text = (msg?.innerText ?? '').trim();
				const label = btn.dataset.copy ?? '';
				try {
					await navigator.clipboard.writeText(text);
					btn.textContent = btn.dataset.copied ?? '';
				} catch {
					const r = document.createRange();
					if (msg) { r.selectNodeContents(msg); const s = getSelection(); s?.removeAllRanges(); s?.addRange(r); }
					btn.textContent = btn.dataset.manual ?? '';
				}
				setTimeout(() => { btn.textContent = label; }, 2500);
			});

			// 외국어 페이지의 문의 클릭도 기록합니다.
			const track = (name: string) => {
				const gtag = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
				if (gtag) gtag('event', name, { page_path: location.pathname, where: 'foreign_lang' });
			};
			document.addEventListener('click', (e) => {
				const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
				if (!a) return;
				const h = a.getAttribute('href') ?? '';
				if (h.startsWith('tel:')) track('phone_click');
				else if (h.includes('pf.kakao.com')) track('kakao_click');
			});
		</script>
	</body>
</html>
