---
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { PHONE, PHONE_LINK, KAKAO_URL, SELF_ACTIVATION_URL } from '../consts';
import { categoryOf } from '../data/blogCategories';

type Props = CollectionEntry<'blog'>['data'] & { id?: string; seoTitle?: string; headings?: { depth: number; slug: string; text: string }[] };

const { title, description, pubDate, updatedDate, heroImage, id: currentId, headings = [], category: explicitCat, seoTitle } = Astro.props;
const isPost = !!currentId;
const category = categoryOf(currentId ?? '', explicitCat);
const toc = headings.filter((h) => h.depth === 2);
const all = (await getCollection('blog'))
	.filter((p) => p.id !== currentId)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const same = all.filter((p) => categoryOf(p.id, p.data.category) === category);
const others = all.filter((p) => categoryOf(p.id, p.data.category) !== category);
const related = [...same, ...others].slice(0, 3);
---

<html lang="ko">
	<head>
		<BaseHead
			title={seoTitle ?? title}
			description={description}
			jsonLd={{
				'@context': 'https://schema.org',
				'@type': 'Article',
				headline: title,
				description,
				datePublished: pubDate.toISOString(),
				dateModified: (updatedDate ?? pubDate).toISOString(),
				inLanguage: 'ko',
				author: { '@type': 'Organization', name: '커넥트모바일' },
				publisher: { '@type': 'Organization', name: '커넥트모바일 선후불개통센터' },
			}}
		/>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1.3;
			}
			.prose { font-size: 1.02rem; line-height: 1.85; }
			.prose :global(h2) { margin-top: 2.2rem; font-size: 1.5rem; }
			.prose :global(h3) { margin-top: 1.6rem; font-size: 1.2rem; }
			.prose :global(p) { margin-bottom: 1.2em; }
			.prose :global(img) { max-width: 100%; height: auto; border-radius: 12px; }
			.prose :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-size: 0.92rem; margin: 1rem 0 1.5rem; -webkit-overflow-scrolling: touch; }
			.prose :global(th), .prose :global(td) { border-bottom: 1px solid rgb(var(--gray-light)); padding: 0.55rem 0.7rem; text-align: left; vertical-align: top; }
			.prose :global(th) { background: #eef1ff; color: var(--accent-dark); white-space: nowrap; }
			.prose :global(td) { min-width: 5em; }
			.cat { display: inline-block; margin-bottom: 0.6rem; padding: 0.4rem 1rem; border-radius: 999px; background: #eef1ff; color: var(--accent); font-size: 0.8rem; font-weight: 800; text-decoration: none; }
			.toc { background: #fff; border-radius: 14px; box-shadow: var(--box-shadow); padding: 1rem 1.3rem; margin: 0 0 1.5rem; line-height: 1.5; }
			.toc strong { display: block; margin-bottom: 0.4rem; color: rgb(var(--black)); }
			.toc ol { margin: 0; padding-left: 1.2rem; font-size: 0.93rem; }
			.toc li { margin-bottom: 0.25rem; }
			.toc a { text-decoration: none; color: rgb(var(--gray-dark)); }
			.toc a:hover { color: var(--accent); text-decoration: underline; }
			.prose :global(h2) { scroll-margin-top: 4.5rem; }
			.related { margin-top: 3rem; }
			.related h3 { margin: 0 0 1rem; font-size: 1.15rem; }
			.rel-grid { display: grid; gap: 0.8rem; }
			.rel-grid a { display: block; background: #fff; border-radius: 14px; box-shadow: var(--box-shadow); padding: 1rem 1.2rem; text-decoration: none; transition: translate 0.15s; }
			.rel-grid a:hover { translate: 0 -3px; }
			.rel-grid strong { display: block; color: rgb(var(--black)); font-size: 0.98rem; line-height: 1.4; }
			.rel-grid span { display: block; margin-top: 0.3rem; color: rgb(var(--gray)); font-size: 0.85rem; line-height: 1.5; }
			.post-cta { text-align: center; background: #fff; border-radius: 16px; box-shadow: var(--box-shadow); padding: 1.8rem 1rem; margin-top: 3rem; }
			.post-cta h3 { margin: 0 0 0.3rem; }
			.post-cta p { margin: 0 0 1rem; color: rgb(var(--gray)); font-size: 0.9rem; }
			.post-cta .row { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; }
			.post-cta a { padding: 0.65rem 1.3rem; border-radius: 999px; font-weight: 700; text-decoration: none; color: #fff; background: var(--accent); }
			.post-cta a.self { background: #ff3b30; }
			.post-cta a.kakao { background: #fee500; color: #191919; }
			@media (max-width: 720px) { .post-cta .row { flex-direction: column; } }
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="main">
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={title} />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										최종 수정 <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						{isPost && <a class="cat" href={`/blog/#${encodeURIComponent(category)}`}>{category}</a>}
						<h1>{title}</h1>
						<hr />
					</div>
					{toc.length >= 3 && (
						<nav class="toc" aria-label="목차">
							<strong>목차</strong>
							<ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
						</nav>
					)}
					<slot />
					{isPost && <section class="related">
						<h3>같이 읽으면 좋은 글</h3>
						<div class="rel-grid">
							{related.map((p) => (
								<a href={`/blog/${p.id}/`}>
									<strong>{p.data.title}</strong>
									<span>{p.data.description}</span>
								</a>
							))}
						</div>
					</section>}
					<div class="post-cta">
						<h3>개통이 궁금하세요?</h3>
						<p>바로 셀프개통을 진행하거나, 전화·카카오톡으로 편하게 문의하세요.</p>
						<div class="row">
							<a class="self" href={SELF_ACTIVATION_URL} target="_blank" rel="noopener"><Icon name="rocket" />셀프개통 바로가기</a>
							<a href={PHONE_LINK}><Icon name="phone" />{PHONE}</a>
							<a class="kakao" href={KAKAO_URL} target="_blank" rel="noopener"><Icon name="chat" />카카오톡 문의</a>
						</div>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
