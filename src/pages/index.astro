---
import Icon from '../components/Icon.astro';
import PlanCards from '../components/PlanCards.astro';
import PlanFinder from '../components/PlanFinder.astro';
import HeroArt from '../components/HeroArt.astro';
import HomeStats from '../components/HomeStats.astro';
import HoursBadge from '../components/HoursBadge.astro';
import StuckHelp from '../components/StuckHelp.astro';
import Reviews from '../components/Reviews.astro';
import ChannelAdd from '../components/ChannelAdd.astro';
import TrustStrip from '../components/TrustStrip.astro';
import EligibilityCheck from '../components/EligibilityCheck.astro';
import { ktPrepaid, lgPrepaid } from '../data/prepaidPlans';
import { postpaidPartners } from '../data/postpaidPlans';
import { ktPrepaidMore, lgPrepaidMore, ktPostpaid, lgPostpaid } from '../data/morePlans';
import { homeFaqs, faqGroups } from '../data/faqs';
const allPlanPrices = [...ktPrepaid, ...lgPrepaid, ...ktPrepaidMore, ...lgPrepaidMore, ...ktPostpaid, ...lgPostpaid, ...postpaidPartners.flatMap((x) => x.plans)]
	.map((x) => Number(x.price.replace(/[^0-9]/g, '')))
	.filter((n) => n > 0);
const heroMinPrice = Math.min(...allPlanPrices).toLocaleString('ko-KR');
import { REGIONS } from '../data/regions';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, PHONE, PHONE_LINK, KAKAO_URL, SELF_ACTIVATION_URL, HOURS, HOLIDAY_NOTE } from '../consts';

import { getCollection } from 'astro:content';
import { getNaverPosts, NAVER_BLOG_URL } from '../lib/naverBlog';
const naverPosts = await getNaverPosts(10);

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id),
);
const latestPosts = allPosts.slice(0, 3);
const fmtDate = (d: Date) => d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });

const ALIASES: Record<string, string[]> = { seoul: ['가산', '가산동', '가산디지털단지', '구로디지털단지', '신도림'], gyeonggi: ['판교', '일산', '분당', '광교'], busan: ['서면', '센텀'] };
const regionIndex = [{ t: '가산', label: '서울 가산동', slug: 'seoul/gasan' }, { t: '가산동', label: '서울 가산동', slug: 'seoul/gasan' }, { t: '가산디지털단지', label: '서울 가산동', slug: 'seoul/gasan' }].concat(REGIONS.flatMap((r) => [
	{ t: r.name, label: r.name, slug: r.slug },
	{ t: r.full, label: r.name, slug: r.slug },
	...r.cities.map((c) => ({ t: c.replace(/\(.*\)/, ''), label: `${r.name} ${c}`, slug: r.slug })),
	...(ALIASES[r.slug] ?? []).filter((a) => !['가산', '가산동', '가산디지털단지'].includes(a)).map((a) => ({ t: a, label: `${r.name} ${a}`, slug: r.slug })),
]));
const popularPrepaid = [...ktPrepaid].filter((p) => ['LTE 선불 396 10.3GB', 'LTE 선불 459 20.3GB'].includes(p.name));
const popularPostpaid = postpaidPartners.flatMap((p) => p.plans).filter((p) => ['밀리의서재 7GB+', '네이버페이 10GB+', '다이소 10GB+'].includes(p.name));

// 홈에는 가장 자주 묻는 6개만 보여 주고, 나머지는 FAQ 페이지로 안내합니다. (화면과 구조화 데이터가 같은 목록을 씁니다)
const homeKeep = ['개통하려면 무엇이 필요한가요?', '유심은 어떻게 받나요?', '셀프개통은 얼마나 걸리나요?', '미납이나 연체 이력이 있어도 개통되나요?', '약정이나 위약금이 있나요?', '외국인이나 미성년자도 개통할 수 있나요?'];
const faqs = homeFaqs.filter((f) => homeKeep.includes(f.q));
const faqTotal = faqGroups.reduce((n, g) => n + g.items.length, 0);
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title="선불폰 개통·알뜰폰 셀프개통 | 커넥트모바일"
			description="KT망·LG망 선불폰·알뜰 요금제 개통. 유심 준비 후 10분 셀프개통, 미납·연체 상담 가능, 외국인·미성년자는 대면 개통. 약정·위약금 없는 알뜰폰 개통센터입니다."
			jsonLd={[faqSchema]}
			alternates={[
				{ hreflang: 'ko', href: 'https://connectmobile.kr/' },
				{ hreflang: 'en', href: 'https://connectmobile.kr/en/' },
				{ hreflang: 'x-default', href: 'https://connectmobile.kr/' },
			]}
		/>
		<style>
			.hero { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 1.5rem; align-items: center; text-align: left; padding: 2.5rem 0 1rem; }
			.hero-text .chips, .hero-text .cta, .hero-text .trust { justify-content: flex-start; }
			@media (max-width: 720px) {
				.hero { grid-template-columns: 1fr; text-align: center; padding-top: 1.5rem; }
				.hero-text .chips, .hero-text .cta, .hero-text .trust { justify-content: center; }
			}
			.hero .badge { display: inline-block; background: #eef1ff; color: var(--accent); font-weight: 700; padding: 0.3rem 0.9rem; border-radius: 999px; font-size: 0.85rem; }
			.hero h1 { font-size: 2.2rem; margin: 0.8rem 0 0.5rem; }
			.hero p { color: rgb(var(--gray)); margin: 0; }
				.trust { display: flex; gap: 0.4rem 1.2rem; justify-content: center; flex-wrap: wrap; margin-top: 1.4rem; font-size: 0.85rem; color: rgb(var(--gray)); }
				.trust b { color: rgb(var(--gray-dark)); }
			.chips { display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; margin-top: 1.2rem; }
			.chips span { background: #fff; box-shadow: var(--box-shadow); padding: 0.3rem 0.9rem; border-radius: 999px; font-weight: 700; font-size: 0.85rem; }
			.cta { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem; }
			.btn { display: inline-block; padding: 0.7rem 1.4rem; border-radius: 999px; text-decoration: none; font-weight: 700; background: var(--accent); color: #fff; }
			.btn.alt { background: #fee500; color: #191919; }
				.btn.self { background: #d92d20; color: #fff; }
			.btn.ghost { background: #fff; color: var(--accent); box-shadow: inset 0 0 0 2px var(--accent); }
			section { margin-top: 4rem; }
			h2.sec { text-align: center; margin-bottom: 0.3rem; }
			.sub { text-align: center; color: rgb(var(--gray)); margin: 0 0 1.5rem; font-size: 0.9rem; }
			.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
			.card { display: flex; flex-direction: column; background: #fff; border-radius: 14px; padding: 1.4rem; box-shadow: var(--box-shadow); text-decoration: none; color: inherit; transition: transform 0.15s; }
			.card:hover { transform: translateY(-4px); }
			.card .tag { font-size: 0.78rem; font-weight: 700; color: rgb(var(--gray)); }
			.card .go { margin-top: auto; padding-top: 1rem; font-weight: 700; color: var(--accent); }
			.card.pre .go { color: #0b7a70; }
			.btn.lg { font-size: 1.15rem; padding: 1rem 2.4rem; }
			.btn.sm { font-size: 0.9rem; padding: 0.5rem 1.1rem; box-shadow: none; }
			.sub-cta { margin-top: 0.8rem; }
			.card h3 { margin-top: 0; }
			.card p, .card li { font-size: 0.9rem; }
			.card ul { padding-left: 1.1rem; margin: 0.5rem 0 0; }
			.card.pre { border-top: 5px solid #0b7a70; }
			.card.post { border-top: 5px solid var(--accent); }
			.ways { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 1rem; max-width: 860px; margin: 0 auto; }
			.way { background: #fff; border-radius: 16px; box-shadow: var(--box-shadow); padding: 1.3rem 1.4rem; border-top: 5px solid var(--accent); display: flex; flex-direction: column; align-items: flex-start; }
			.way.visit { border-top-color: #0b9a8d; }
			.wtag { font-size: 0.78rem; font-weight: 800; color: var(--accent); background: #eef1ff; padding: 0.2rem 0.7rem; border-radius: 999px; }
			.way.visit .wtag { color: #0b7a70; background: #e3f6f3; }
			.way h3 { margin: 0.7rem 0 0.5rem; font-size: 1.2rem; }
			.way ul { margin: 0 0 1rem; padding-left: 1.1rem; font-size: 0.92rem; color: rgb(var(--gray-dark)); flex: 1; }
			.way li { margin-bottom: 0.3rem; }
			.way li a { color: var(--accent); font-weight: 700; }
			.who { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; }
			.who div { background: #fff; border-radius: 12px; box-shadow: var(--box-shadow); padding: 1.1rem 1.2rem; }
			.who p { margin: 0.4rem 0 0; font-size: 0.88rem; color: rgb(var(--gray-dark)); }
			.flow { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
			.flow li { position: relative; text-align: center; padding: 0 0.4rem; }
			.flow li:not(:last-child)::after { content: ''; position: absolute; top: 31px; left: calc(50% + 40px); right: calc(-50% + 40px); border-top: 2px dashed #aab6ff; }
			.fi { display: inline-flex; align-items: center; justify-content: center; width: 62px; height: 62px; border-radius: 50%; background: linear-gradient(135deg, #2337ff, #7c3aed); color: #fff; font-size: 1.7rem; box-shadow: 0 8px 20px rgba(35, 55, 255, 0.28); margin-bottom: 0.7rem; }
			.fi :global(.ic) { margin: 0; width: 1em; height: 1em; }
			.flow small { display: block; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; color: var(--accent); }
			.flow strong { display: block; font-size: 1.08rem; margin: 0.1rem 0 0.3rem; }
			.flow p { margin: 0 0 0.6rem; font-size: 0.88rem; color: rgb(var(--gray-dark)); line-height: 1.55; }
			.ft { display: inline-block; background: #fff; border: 1px solid #d9defa; color: var(--accent); font-size: 0.78rem; font-weight: 700; padding: 0.15rem 0.7rem; border-radius: 999px; }
			@media (max-width: 720px) {
				.flow { grid-template-columns: 1fr; gap: 1.4rem; }
				.flow li { text-align: left; padding-left: 5rem; min-height: 62px; }
				.fi { position: absolute; left: 0; top: 0; margin: 0; width: 56px; height: 56px; font-size: 1.5rem; }
				.flow li:not(:last-child)::after { top: 62px; bottom: -1.4rem; left: 27px; right: auto; border-top: 0; border-left: 2px dashed #aab6ff; }
			}
			.prepcards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 1rem; max-width: 820px; margin: 0 auto; }
			.prepcards img { width: 100%; height: auto; border-radius: 16px; box-shadow: var(--box-shadow); margin: 0; display: block; }
			.rsearch { position: relative; max-width: 420px; margin: 0 auto 1.1rem; }
			.rsearch input { width: 100%; padding: 0.7rem 1rem; border: 2px solid #dfe3f0; border-radius: 999px; font-size: 1rem; background: #fff; }
			.rsearch input:focus { outline: none; border-color: var(--accent); }
			.rsearch ul { list-style: none; margin: 0.4rem 0 0; padding: 0.3rem; position: absolute; left: 0; right: 0; z-index: 5; background: #fff; border-radius: 12px; box-shadow: var(--box-shadow); }
			.rsearch li a { display: block; padding: 0.55rem 0.8rem; border-radius: 8px; text-decoration: none; color: var(--black); }
			.rsearch li a:hover, .rsearch li a.on { background: #eef1ff; }
			.rsearch li.none { padding: 0.55rem 0.8rem; color: rgb(var(--gray)); font-size: 0.9rem; }
			.rbtns { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(120px, 45%), 1fr)); gap: 0.6rem; }
			.rbtns a { display: flex; flex-direction: column; align-items: center; gap: 0.1rem; padding: 0.75rem 0.4rem; background: #fff; border-radius: 12px; box-shadow: var(--box-shadow); text-decoration: none; color: var(--black); transition: transform 0.15s, background 0.15s; }
			.rbtns a:hover { transform: translateY(-2px); background: #eef1ff; }
			.rbtns strong { font-size: 1.05rem; }
			.rbtns span { font-size: 0.75rem; color: rgb(var(--gray)); }
			.posts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 1rem; }
			.post { display: flex; flex-direction: column; background: #fff; border-radius: 14px; box-shadow: var(--box-shadow); padding: 1.1rem 1.25rem; text-decoration: none; color: inherit; transition: transform 0.15s; }
			.post:hover { transform: translateY(-3px); }
			.post .pd { font-size: 0.78rem; color: rgb(var(--gray)); }
			.post strong { display: block; margin: 0.3rem 0 0.4rem; font-size: 1.02rem; line-height: 1.4; color: rgb(var(--black)); }
			.post p { margin: 0 0 0.8rem; font-size: 0.86rem; color: rgb(var(--gray-dark)); line-height: 1.55; flex: 1; }
			.post .more { font-size: 0.85rem; font-weight: 700; color: var(--accent); }
			.post .more :global(.ic) { margin: 0 0 0 0.35em; }
			.ftabs { display: flex; gap: 0.5rem; justify-content: center; margin-bottom: 1.2rem; }
			.ftabs button { border: 0; padding: 0.55rem 1.4rem; border-radius: 999px; background: #fff; box-shadow: var(--box-shadow); font: inherit; font-weight: 700; cursor: pointer; }
			.ftabs button.on { background: var(--accent); color: #fff; }
			.fpanel[hidden] { display: none; }
			.qnav { display: flex; gap: 0.5rem; justify-content: center; overflow-x: auto; margin: 1.2rem auto 0; padding: 0.2rem 0.2rem 0.5rem; scrollbar-width: none; }
			.qnav::-webkit-scrollbar { display: none; }
			.qnav a { flex: 0 0 auto; padding: 0.45rem 1rem; border-radius: 999px; background: #fff; color: var(--accent); font-size: 0.88rem; font-weight: 700; text-decoration: none; box-shadow: var(--box-shadow), inset 0 0 0 1.5px #d7ddff; }
			.qnav a:hover { background: #eef1ff; }
			@media (max-width: 720px) { .qnav { justify-content: flex-start; } }
			#tools, #faq { position: relative; }
			.sec-mascot { display: none; }
			@media (min-width: 960px) {
				.sec-mascot { display: block; position: absolute; right: 1.5rem; top: -0.4rem; width: 104px; pointer-events: none; }
				.sec-mascot img { width: 100%; height: auto; margin: 0; display: block; filter: drop-shadow(0 8px 12px rgba(20, 40, 120, 0.22)); }
				.sec-mascot span { position: absolute; right: 84px; top: 0.4rem; background: #fff; color: #0e2150; font-size: 0.78rem; font-weight: 800; line-height: 1.35; padding: 0.5rem 0.8rem; border-radius: 14px; box-shadow: 0 6px 16px rgba(20, 40, 120, 0.16); white-space: nowrap; text-align: left; animation: bubblebob 3.4s ease-in-out infinite; }
				.sec-mascot span::after { content: ''; position: absolute; right: -6px; top: 14px; width: 12px; height: 12px; background: #fff; border-radius: 2px; transform: rotate(45deg); }
			}
			@media (prefers-reduced-motion: reduce) { .sec-mascot span { animation: none !important; } }
			.ttabs { display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.2rem; }
			.ttabs button { border: 0; padding: 0.65rem 1.4rem; border-radius: 999px; background: #fff; box-shadow: var(--box-shadow); font: inherit; font-weight: 700; cursor: pointer; }
			.ttabs button.on { background: var(--accent); color: #fff; }
			.tpanel[hidden] { display: none; }
			.hs { position: relative; }
			.hs :global(.plan-grid) { display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0.4rem 0.3rem 1rem; scrollbar-width: thin; -webkit-overflow-scrolling: touch; }
			.hs :global(.plan) { flex: 0 0 min(310px, 82%); scroll-snap-align: start; }
			.go .ic, .btn.ghost .ic { margin: 0 0 0 0.4em; }
			.feat { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem; }
			.feat figure { margin: 0; position: relative; }
			.feat img { width: 100%; height: auto; border-radius: 12px; box-shadow: var(--box-shadow); margin: 0; }
			.feat figcaption { position: absolute; top: 8px; left: 8px; background: #d92d20; color: #fff; font-size: 0.75rem; font-weight: 700; padding: 0.15rem 0.6rem; border-radius: 999px; }
			details { background: #fff; border-radius: 12px; box-shadow: var(--box-shadow); padding: 0.9rem 1.2rem; margin-bottom: 0.7rem; }
			summary { cursor: pointer; font-weight: 700; }
			.faq details > summary, details > summary { min-height: 2.6rem; }
			details p { margin: 0.6rem 0 0; font-size: 0.92rem; color: rgb(var(--gray-dark)); }
			.nposts { list-style: none; padding: 0; margin: 0 0 1.5rem; }
			.nposts li { display: flex; align-items: center; gap: 0.8rem; background: #fff; border-radius: 14px; box-shadow: var(--box-shadow); padding: 0.75rem 1.1rem; margin-bottom: 0.6rem; font-size: 0.95rem; transition: transform 0.15s; }
			.nposts li:hover { transform: translateY(-2px); }
			.nmark { flex: 0 0 auto; width: 1.7rem; height: 1.7rem; border-radius: 8px; background: #03c75a; color: #fff; font-weight: 900; font-size: 0.95rem; display: grid; place-items: center; }
			.nposts a { flex: 1; min-width: 0; color: var(--black); text-decoration: none; font-weight: 700; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
			.nposts a:hover { color: var(--accent); }
			.nposts time { color: rgb(var(--gray)); font-size: 0.78rem; white-space: nowrap; flex: 0 0 auto; }
			.final { position: relative; overflow: hidden; display: grid; align-items: center; text-align: center; color: #fff; border-radius: 22px; box-shadow: 0 16px 40px rgba(15, 40, 140, 0.28); padding: 2.4rem 1.2rem 0;
				background: radial-gradient(700px 320px at 85% 0%, rgba(120, 190, 255, 0.4), transparent 60%), radial-gradient(500px 300px at 5% 100%, rgba(47, 123, 255, 0.45), transparent 65%), linear-gradient(135deg, #0b1d4d 0%, #123f9e 55%, #1c63e0 100%); }
			.final h2 { margin: 0 0 0.5rem; color: #fff; font-size: 1.9rem; }
			.final p { color: rgba(255, 255, 255, 0.88); margin: 0 0 1.2rem; }
			.final small { color: rgba(255, 255, 255, 0.72); }
			.final .stars { z-index: 0; top: 0; left: 0; width: 100%; transform: none; border-radius: inherit; }
			.final-in { position: relative; z-index: 1; padding-bottom: 2rem; }
			.final .btn:not(.self):not(.alt) { background: #fff; color: #0b1d4d; }
			.final-mascot { position: relative; z-index: 1; justify-self: center; width: 150px; margin-top: -0.5rem; line-height: 0; }
			.final-mascot img { width: 100%; height: auto; margin: 0; display: block; filter: drop-shadow(0 12px 18px rgba(0, 10, 50, 0.45)); transition: transform 0.2s; }
			.final-mascot:hover img { transform: translateY(-4px) scale(1.02); }
			@media (min-width: 721px) {
				.final { grid-template-columns: 1fr 240px; text-align: left; padding: 2.8rem 2.4rem 0 2.8rem; min-height: 340px; }
				.final-in { padding-bottom: 2.8rem; }
				.final .cta { justify-content: flex-start; }
				.final-mascot { width: 240px; align-self: end; margin-top: 0; margin-right: -0.4rem; }
			}
			.svband { display: flex; align-items: center; gap: 0.4rem 1.2rem; flex-wrap: wrap; max-width: 860px; margin: 2.5rem auto 0; padding: 1rem 1.3rem; border-radius: 18px; background: linear-gradient(135deg, #eef1ff, #f3ecff); border: 1px solid rgba(35, 55, 255, 0.14); text-decoration: none; color: inherit; transition: transform 0.2s, box-shadow 0.2s; }
			.svband:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(35, 55, 255, 0.14); }
			.svb-t { font-weight: 800; }
			.svb-d { flex: 1 1 14rem; font-size: 0.9rem; color: rgb(var(--gray-dark)); }
			.svb-go { font-weight: 800; color: var(--accent); white-space: nowrap; }
			.fold { max-width: 860px; margin: 2.2rem auto 0; padding: 0.4rem 1.2rem; }
			.fold > summary { padding: 0.8rem 0; font-size: 1.02rem; list-style: none; display: flex; align-items: center; gap: 0.2rem; }
			.fold > summary::-webkit-details-marker { display: none; }
			.fold > summary::after { content: '+'; margin-left: auto; font-size: 1.4rem; font-weight: 400; color: var(--accent); }
			.fold[open] > summary::after { content: '–'; }
			.fold[open] { padding-bottom: 1.2rem; }
			.fold > summary .ic { color: var(--accent); }
			@media (max-width: 720px) {
				.who, .posts { display: flex; gap: 0.8rem; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0.3rem 0.2rem 0.9rem; -webkit-overflow-scrolling: touch; scrollbar-width: thin; }
				.who > div { flex: 0 0 80%; scroll-snap-align: start; }
				.posts > .post { flex: 0 0 78%; scroll-snap-align: start; }
				.nposts li:nth-child(n + 6) { display: none; }
				.nposts li { flex-direction: column; gap: 0.2rem; }
				.rbtns { grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
				.rbtns a { padding: 0.6rem 0.2rem; }
				.rbtns span { display: none; }
				section { margin-top: 3rem; }
			}
			/* 첫 화면(압축형 + 마스코트) */
			.hb .hero-text { position: relative; }
			.hb-cta { margin-top: 1.1rem; display: grid; gap: 0.6rem; max-width: 460px; }
			.hb-cta .btn.lg { text-align: center; }
			.hb-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
			.hb-row .btn { text-align: center; box-shadow: none; }
			.hb-note { margin: 0.7rem 0 0; font-size: 0.8rem; color: rgb(var(--gray)); }
			.hb :global(.hours) { margin-top: 0.8rem; }
			.mini-mascot { display: none; }
			.statswrap :global(.stats) { margin-top: 1.2rem; }
			@media (max-width: 720px) {
				.hb { padding: 1.1rem 0 0.4rem; gap: 0; }
				.hb h1 { font-size: 1.85rem; margin: 0.6rem 0 0.4rem; }
				.hb :global(.hero-art) { display: none; }
				.hb-cta { max-width: none; }
				.hb :global(.hours) { display: flex; flex-direction: row; flex-wrap: wrap; gap: 0.2rem 1rem; justify-content: flex-start; padding: 0.5rem 0.8rem; font-size: 0.8rem; }
				.hb :global(.hours .row b) { min-width: 0; }
				.statswrap :global(.stats) { grid-template-columns: repeat(4, 1fr); gap: 0.4rem; margin-top: 0.9rem; }
				.statswrap :global(.stats li) { padding: 0.55rem 0.15rem; border-radius: 12px; }
				.statswrap :global(.stats b) { font-size: 0.98rem; }
				.statswrap :global(.stats span) { font-size: 0.66rem; display: block; line-height: 1.3; }
				.statswrap :global(.partners) { flex-wrap: nowrap; overflow-x: auto; justify-content: flex-start; padding-bottom: 0.3rem; margin-top: 0.8rem; }
				.statswrap :global(.pchip), .statswrap :global(.plabel) { white-space: nowrap; }
				.hc .hero-text { text-align: left; }
				.hc h1 { padding-right: 116px; }
				.hc .badge { margin-top: 0.2rem; }
				.hc p { padding-right: 116px; font-size: 0.92rem; }
				.hc .hb-cta { margin-top: 2.9rem; }
				.mini-mascot { display: block; position: absolute; right: -2px; top: 1.5rem; width: 106px; text-decoration: none; }
				.mini-mascot img { width: 100%; height: auto; margin: 0; display: block; filter: drop-shadow(0 6px 10px rgba(20, 40, 120, 0.22)); }
				.mini-mascot span { position: absolute; right: 6px; top: -1.8rem; font-size: 0.72rem; background: #fff; color: #0e2150; font-size: 0.66rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 10px; box-shadow: 0 4px 12px rgba(20, 40, 120, 0.18); white-space: nowrap; animation: bubblebob 3.4s ease-in-out infinite; }
				.mini-mascot span::after { content: ''; position: absolute; right: 26px; bottom: -5px; width: 10px; height: 10px; background: #fff; border-radius: 2px; transform: rotate(45deg); }
				.hc .hb-note { text-align: left; }
			}

			@keyframes bubblebob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
			@media (prefers-reduced-motion: reduce) { .mini-mascot span { animation: none !important; } }
			.resume { display: block; width: fit-content; max-width: 100%; margin: 1rem auto 0; padding: 0.55rem 1.1rem; border-radius: 999px; background: #fff; color: var(--accent); font-size: 0.9rem; font-weight: 700; text-decoration: none; box-shadow: var(--box-shadow); box-sizing: border-box; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			.resume[hidden] { display: none; }
			.stars { display: none; }
			@media (min-width: 721px) {
				.stars { display: block; position: absolute; z-index: -1; top: -54px; bottom: 0; left: 50%; width: 100vw; transform: translateX(-50%); overflow: hidden; pointer-events: none; border-radius: 0 0 56px 56px / 0 0 36px 36px; }
				.stars i { position: absolute; width: 190px; height: 2px; border-radius: 2px; opacity: 0; background: linear-gradient(90deg, transparent, rgba(180, 220, 255, 0.5) 70%, #fff); filter: drop-shadow(0 0 5px rgba(170, 215, 255, 0.95)); transform: rotate(148deg); animation: shoot 12s linear infinite; }
				.stars i:nth-child(1) { left: 78%; top: 3%; animation-delay: 1s; }
				.stars i:nth-child(2) { left: 52%; top: 1%; animation-delay: 4.5s; animation-duration: 14s; width: 150px; }
				.stars i:nth-child(3) { left: 92%; top: 22%; animation-delay: 7.5s; animation-duration: 11s; width: 220px; }
				.stars i:nth-child(4) { left: 66%; top: 12%; animation-delay: 10s; animation-duration: 13s; width: 170px; }
				.stars i:nth-child(n+5) { display: none; }
				.stars::before { content: ''; position: absolute; top: 0; left: 0; width: 2px; height: 2px; border-radius: 50%; background: #fff; animation: twinkle 4s ease-in-out infinite;
					box-shadow: 8vw 40px 0 #fff, 17vw 150px 0 #cfe4ff, 29vw 60px 0 #fff, 41vw 120px 0 #cfe4ff, 55vw 30px 0 #fff, 63vw 170px 0 #fff, 72vw 90px 0 #cfe4ff, 81vw 20px 0 #fff, 90vw 140px 0 #cfe4ff, 96vw 70px 0 #fff, 35vw 210px 0 #cfe4ff, 12vw 250px 0 #fff; }
			}
			@keyframes twinkle { 0%, 100% { opacity: 0.25; } 50% { opacity: 0.9; } }
			@keyframes shoot {
				0% { opacity: 0; transform: translate(0, 0) rotate(148deg); }
				1% { opacity: 1; }
				6% { opacity: 1; }
				8% { opacity: 0; transform: translate(-560px, 350px) rotate(148deg); }
				100% { opacity: 0; transform: translate(-560px, 350px) rotate(148deg); }
			}
			@media (prefers-reduced-motion: reduce) { .stars { display: none !important; } }

			/* PC 첫 화면: 브랜드 파랑 히어로 + 큰 마스코트 */
			.hero-big { display: none; }
			@media (min-width: 721px) {
				:global(html) { overflow-x: clip; }
				.hb { position: relative; padding: 3.2rem 0 5.2rem; min-height: 470px; grid-template-columns: 1.1fr 0.9fr; }
				.hb::before { content: ''; position: absolute; z-index: -1; top: -54px; bottom: 0; left: 50%; width: 100vw; transform: translateX(-50%); border-radius: 0 0 56px 56px / 0 0 36px 36px;
					background: radial-gradient(900px 420px at 85% 10%, rgba(120, 190, 255, 0.45), transparent 60%), radial-gradient(600px 360px at 8% 100%, rgba(47, 123, 255, 0.5), transparent 65%), linear-gradient(135deg, #0b1d4d 0%, #123f9e 55%, #1c63e0 100%); }
				.hb :global(.hero-art) { display: none; }
				.hb .badge { background: rgba(255, 255, 255, 0.16); color: #fff; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35); }
				.hb h1 { background: none; -webkit-background-clip: border-box; background-clip: border-box; -webkit-text-fill-color: #fff; color: #fff; font-size: 3rem; line-height: 1.2; letter-spacing: -0.02em; margin: 1rem 0 0.8rem; }
				.hb p { color: rgba(255, 255, 255, 0.88); font-size: 1.08rem; }
				.hb .hb-note { color: rgba(255, 255, 255, 0.78); font-size: 0.82rem; }
				.hb .hb-note a { color: #fff; }
				.hb-cta { max-width: 500px; margin-top: 1.5rem; }
				.hb-cta .btn.lg { box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28); }
				.hb :global(.hours) { box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18); }
				.hero-big { display: block; position: relative; justify-self: center; align-self: end; width: min(100%, 330px); text-decoration: none; margin-bottom: -5.2rem; z-index: 1; }
				.hero-big img { width: 100%; height: auto; display: block; margin: 0; filter: drop-shadow(0 18px 28px rgba(0, 10, 50, 0.45)); animation: bigwave 5s ease-in-out infinite; transform-origin: 50% 90%; }
				.hero-big:hover img { animation: none; transform: scale(1.03); }
				.hb-waves { position: absolute; left: -22%; top: -18%; width: 150%; height: auto; z-index: -1; pointer-events: none; }
				.hb-bubble { position: absolute; left: -27%; top: 14%; animation: bubblebob 3.4s ease-in-out infinite; background: #fff; color: #0e2150; font-size: 0.86rem; font-weight: 800; line-height: 1.4; padding: 0.7rem 1rem; border-radius: 16px; box-shadow: 0 10px 26px rgba(0, 10, 50, 0.3); text-align: left; }
				.hb-bubble::after { content: ''; position: absolute; right: -9px; bottom: 14px; width: 18px; height: 18px; background: #fff; border-radius: 3px; transform: rotate(45deg) skew(8deg, 8deg); }
				.hero-big:hover .hb-bubble { animation-play-state: paused; }
				
				@keyframes bigwave { 0%, 100% { transform: rotate(-1deg); } 50% { transform: rotate(1.5deg); } }
				.statswrap { position: relative; z-index: 2; margin-top: -2.6rem; }
				.statswrap :global(.stats) { margin-top: 0; }
			}
			@media (min-width: 721px) and (prefers-reduced-motion: reduce) { .hero-big img, .hb-bubble { animation: none; } }
		</style>
	</head>
	<body>
		<Header />
		<main id="main" class="wide">
			<div class="hero hb hc">
				<div class="stars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
				<div class="hero-text">
					<a class="mini-mascot" data-ask="mascot_mobile" href={KAKAO_URL} target="_blank" rel="noopener" aria-label="궁금한 점 고르고 상담하기"><span>뭐가 궁금하세요?</span><img src="/brand/mascot.webp" alt="" width="209" height="360" fetchpriority="high" /></a>
					<span class="badge">약정 0원, 위약금 0원</span>
					<h1>월 {heroMinPrice}원부터,<br />약정 없이 시작하세요</h1>
					<p>선불폰과 알뜰폰을 비대면으로, KT망과 LG망 중에 고르세요.</p>
					<div class="hb-cta">
						<a class="btn self lg" href={SELF_ACTIVATION_URL} target="_blank" rel="noopener"><Icon name="rocket" />셀프개통 바로가기</a>
						<div class="hb-row">
							<a class="btn sm alt" href={KAKAO_URL} target="_blank" rel="noopener"><Icon name="chat" />카카오톡 문의</a>
							<a class="btn sm ghost" href={PHONE_LINK}><Icon name="phone" />전화 상담</a>
						</div>
					</div>
					<HoursBadge />
					<p class="hb-note"><a href="/about/#verified">앤텔레콤 사전승낙 판매점</a>이에요.<br />외국인과 미성년자는 예약 후 대면 개통이에요.</p>
				</div>
				<HeroArt />
				<a class="hero-big" data-ask="mascot_pc" href={KAKAO_URL} target="_blank" rel="noopener" aria-label="궁금한 점 고르고 상담하기">
					<svg class="hb-waves" viewBox="0 0 400 400" aria-hidden="true"><g fill="none" stroke="#fff" stroke-linecap="round"><path d="M70 150a190 190 0 0 1 260 0" stroke-width="10" opacity="0.18"/><path d="M105 190a135 135 0 0 1 190 0" stroke-width="10" opacity="0.28"/><path d="M140 230a80 80 0 0 1 120 0" stroke-width="10" opacity="0.4"/></g><circle cx="200" cy="270" r="10" fill="#fff" opacity="0.5"/></svg>
					<span class="hb-bubble">어떤 게 궁금하세요?<br />저를 눌러 골라보세요!</span>
					<img src="/brand/mascot-lg.webp" alt="" width="371" height="640" loading="eager" />
				</a>
			</div>
			<div class="statswrap"><HomeStats /></div>
			<a class="resume" id="resume" href="/plans/" hidden></a>

			<nav class="qnav" aria-label="홈 바로가기">
				<a href="#finder">요금제 찾기</a>
				<a href="#check">셀프개통 가능 확인</a>
				<a href="#steps">개통 절차</a>
				<a href="#regions">지역별 안내</a>
				<a href="#faq">자주 묻는 질문</a>
			</nav>

			<section id="tools">
				<div class="sec-mascot" aria-hidden="true"><span>어떤 게 맞을지<br />같이 골라봐요!</span><img src="/brand/mascot.webp" alt="" width="104" height="179" loading="lazy" /></div>
				<h2 class="sec">내게 맞게 골라 드릴게요</h2>
				<div class="ttabs" role="tablist" aria-label="도우미 선택">
					<button type="button" role="tab" aria-selected="true" data-tt="finder" class="on">내게 맞는 요금제 찾기</button>
					<button type="button" role="tab" aria-selected="false" data-tt="check">나는 셀프개통이 될까?</button>
				</div>
				<div class="tpanel" id="finder" data-tp="finder" role="tabpanel">
					<p class="sub">질문 3개에 답하면 알맞은 요금제를 추천해 드려요.</p>
					<PlanFinder />
				</div>
				<div class="tpanel" id="check" data-tp="check" role="tabpanel" hidden>
					<p class="sub">4가지만 눌러 보세요. 셀프개통인지, 방문 개통인지 바로 알려 드려요.</p>
					<EligibilityCheck />
				<details class="fold" id="who">
					<summary><Icon name="user" />상황별로 자세히 보기</summary>
					<p class="sub" style="margin-top:0.8rem">상황이 달라도 먼저 편하게 문의해 주세요.</p>
					<div class="who">
					<div><strong><Icon name="wallet" />미납이나 연체가 있어요</strong><p>선불 요금제는 다른 통신사 미납이 있어도 개통할 수 있는 것으로 안내됩니다. 알뜰(후불)은 조건이 달라 상담이 필요합니다.</p></div>
					<div><strong><Icon name="globe" />외국인이에요</strong><p>외국인은 대면 개통만 가능해요. 가산 사업장은 방문 전에 꼭 예약해야 하고, 전국 대면 사업장은 지역별 안내에서 확인하고 예약해 주세요.</p></div>
					<div><strong><Icon name="user" />미성년자예요</strong><p>미성년자는 대면 개통만 가능해요. 법정대리인 서류가 필요하고, 방문 전에 꼭 예약해 주세요.</p></div>
					<div><strong><Icon name="phone" />번호가 하나 더 필요해요</strong><p>업무용이나 인증용 두 번째 번호를 쓰던 번호 그대로 두고 만들 수 있어요. <a href="/second-number/">세컨드 번호 보기</a></p></div>
					<div><strong><Icon name="badge" />약정이 부담돼요</strong><p>약정과 위약금 없이 필요한 기간만 사용할 수 있습니다.</p></div>
				</div>
				</details>
				</div>
			</section>

			<section id="featured" class="band">
				<h2 class="sec">인기 요금제</h2>
				<p class="sub">선불은 396, 459 요금제가 가장 인기 있어요. 알뜰 요금제는 제휴처별로 비교해 보세요. 옆으로 넘겨 보세요.</p>
				<div class="ftabs" role="tablist" aria-label="요금제 종류">
					<button type="button" role="tab" aria-selected="true" data-t="pre" class="on">선불 요금제</button>
					<button type="button" role="tab" aria-selected="false" data-t="post">알뜰 요금제</button>
				</div>
				<div class="fpanel" data-p="pre" role="tabpanel">
					<div class="hs"><PlanCards plans={popularPrepaid} /></div>
				</div>
				<div class="fpanel" data-p="post" role="tabpanel" hidden>
					<div class="hs"><PlanCards plans={popularPostpaid} /></div>
				</div>
				<p style="text-align:center;margin-top:1.5rem"><a class="btn ghost" href="/plans/">전체 요금제 보기<Icon name="arrow" /></a></p>
					<p class="sub" style="margin-top:1rem">어떤 게 맞는지 모르겠다면 <a href={KAKAO_URL} target="_blank" rel="noopener">카카오톡</a>이나 <a href={PHONE_LINK}>전화</a>로 물어보세요.</p>
			</section>

			<TrustStrip />

			<a class="svband" href="/saving/">
				<span class="svb-t"><Icon name="wallet" />지금 통신비가 얼마예요?</span>
				<span class="svb-d">알뜰폰으로 바꾸면 한 달에 얼마나 아끼는지 계산해 보세요</span>
				<span class="svb-go">요금 절약 계산기<Icon name="arrow" /></span>
			</a>


			<Reviews />

			<section id="ways">
				<h2 class="sec">나에게 맞는 개통 방법</h2>
				<p class="sub">대부분은 셀프개통으로 끝나고, 일부는 방문 개통이 필요해요.</p>
				<div class="ways">
					<div class="way self">
						<span class="wtag">셀프개통 (비대면)</span>
						<h3>휴대폰으로 약 10분</h3>
						<ul>
							<li>만 19세 이상 내국인</li>
							<li>간편인증 수단과 신분증 필요</li>
							<li>신규가입 08:00~21:50, 번호이동 10:00~19:50</li>
							<li>유심은 편의점 구매 또는 퀵 배송 (유심비 8,800원)</li>
							<li>eSIM 개통도 가능 (선불은 LG망, 발급비 2,750원). <a href="/blog/esim-vs-usim/">eSIM 접수 순서 보기</a></li>
						</ul>
						<a class="btn self sm" href={SELF_ACTIVATION_URL} target="_blank" rel="noopener"><Icon name="rocket" />셀프개통 바로가기</a>
					</div>
					<div class="way visit">
						<span class="wtag">방문 개통 (사전 예약)</span>
						<h3>외국인, 미성년자 등</h3>
						<ul>
							<li>외국인과 미성년자는 대면 개통만 가능</li>
							<li>간편인증 수단이 없거나 앤텔레콤 회선을 이미 쓰는 경우</li>
							<li>준비물: 신분증, 유심비 1만원, 충전비, 휴대폰</li>
							<li>방문 전 반드시 예약 (유심은 지점에서 준비)</li>
						</ul>
						<a class="btn ghost sm" href="/region/">지역별 방문 개통 확인<Icon name="arrow" /></a>
					</div>
				</div>
			</section>

			<details class="fold" id="stuck">
				<summary><Icon name="chat" />개통하다 막히셨나요?</summary>
				<StuckHelp />
			</details>

			<section id="steps">
				<h2 class="sec">개통 절차</h2>
				<p class="sub">문의부터 개통 완료까지 담당자가 함께합니다.</p>
				<ol class="flow">
					<li>
						<span class="fi"><Icon name="chat" /></span>
						<small>STEP 1</small>
						<strong>문의와 상담</strong>
						<p>전화 또는 카카오톡으로 요금제와 개통 방식을 확인해요.</p>
						<span class="ft">전화, 카카오톡</span>
					</li>
					<li>
						<span class="fi"><Icon name="box" /></span>
						<small>STEP 2</small>
						<strong>유심 준비</strong>
						<p>퀵 배송으로 받거나 편의점에서 구매해요.</p>
						<span class="ft">퀵 배송 무료</span>
					</li>
					<li>
						<span class="fi"><Icon name="rocket" /></span>
						<small>STEP 3</small>
						<strong>셀프개통</strong>
						<p>안내에 따라 직접 개통해요. 막히면 바로 도움을 드려요.</p>
						<span class="ft">약 10분</span>
					</li>
					<li>
						<span class="fi"><Icon name="check" /></span>
						<small>STEP 4</small>
						<strong>사용 시작</strong>
						<p>개통 후 사용 방법까지 안내해 드려요. 선불은 개통 당일 충전을 잊지 마세요.</p>
						<span class="ft">개통 직후</span>
					</li>
				</ol>
				<p style="text-align:center;margin-top:1.5rem"><a class="btn self" href={SELF_ACTIVATION_URL} target="_blank" rel="noopener"><Icon name="rocket" />셀프개통 바로가기</a> <a class="btn ghost" href="/guide/">개통 과정 자세히 보기<Icon name="arrow" /></a></p>
				<details class="fold" id="prep">
					<summary><Icon name="check" />개통 전 준비물과 유심 구매처</summary>
					<p class="sub" style="margin-top:0.8rem">셀프개통은 준비물만 갖추면 약 10분이면 끝납니다.</p>
					<div class="prepcards">
					<a href="/guide/"><img src="/cards/self-prep.webp" alt="셀프개통 전 준비물 체크: 간편인증, 신분증, 사용 휴대폰, 유심" width="900" height="900" loading="lazy" /></a>
					<a href="/blog/usim-delivery/"><img src="/cards/sim-prep.webp" alt="KT 바로유심, LG 모두의 유심 원칩 구매처와 유심비 안내" width="900" height="900" loading="lazy" /></a>
				</div>
				</details>
			</section>

			<section id="regions">
				<h2 class="sec">지역별 선불폰 개통 안내</h2>
				<p class="sub">우리 동네 선불폰, 지역을 선택해 유심 준비 방법과 개통 안내를 확인하세요.</p>
				<div class="rsearch">
					<input id="rq" type="search" placeholder="동네, 구, 시 이름 검색 (예: 가산, 김해, 해운대)" autocomplete="off" aria-label="지역 검색" />
					<ul id="rres" hidden></ul>
				</div>
				<script type="application/json" id="regidx" set:html={JSON.stringify(regionIndex)} />
				<div class="rbtns">
					{REGIONS.map((r) => <a href={`/region/${r.slug}/`}><strong>{r.name}</strong><span>{r.name} 선불폰</span></a>)}
				</div>
				<p style="text-align:center;margin-top:1.2rem"><a class="btn ghost" href="/region/">지역별 안내 전체 보기<Icon name="arrow" /></a></p>
			</section>

			<section id="faq" class="band">
				<div class="sec-mascot" aria-hidden="true"><span>궁금한 건<br />먼저 여기서!</span><img src="/brand/mascot.webp" alt="" width="104" height="179" loading="lazy" /></div>
				<h2 class="sec">자주 묻는 질문</h2>
				<p class="sub">궁금한 점을 눌러 확인하세요.</p>
				{faqs.map((f) => (
					<details><summary>{f.q}</summary><p>{f.a}</p></details>
				))}
				<p style="text-align:center;margin-top:1.2rem"><a class="btn ghost" href="/faq/">질문 {faqTotal}개 전체 보기<Icon name="arrow" /></a></p>
			</section>

			<section id="guides">
				<h2 class="sec">개통 전에 읽어보세요</h2>
				<p class="sub">알뜰폰과 선불폰 개통에 도움이 되는 최신 글입니다.</p>
				<div class="posts">
					{latestPosts.map((p) => (
						<a class="post" href={`/blog/${p.id}/`}>
							<span class="pd">{fmtDate(p.data.pubDate)}</span>
							<strong>{p.data.title}</strong>
							<p>{p.data.description}</p>
							<span class="more">읽어보기<Icon name="arrow" /></span>
						</a>
					))}
				</div>
				<p style="text-align:center;margin-top:1.4rem"><a class="btn ghost" href="/blog/">블로그 글 {allPosts.length}편 전체 보기<Icon name="arrow" /></a></p>
			</section>

			{naverPosts.length > 0 && (
				<section id="naver">
					<h2 class="sec">네이버 블로그 최신 글</h2>
					<p class="sub">개통 관련 정보를 블로그에서도 확인하세요.</p>
					<ul class="nposts">
						{naverPosts.slice(0, 4).map((p) => (
							<li><span class="nmark" aria-hidden="true">N</span><a href={p.link} target="_blank" rel="noopener">{p.title}</a><time>{p.date.toISOString().slice(0, 10).replaceAll('-', '.')}</time></li>
						))}
					</ul>
					<p style="text-align:center"><a class="btn ghost" href={NAVER_BLOG_URL} target="_blank" rel="noopener">네이버 블로그 바로가기 →</a></p>
				</section>
			)}

			<section>
				<div class="final">
					<div class="stars" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
					<div class="final-in">
						<h2>지금 바로 상담받으세요</h2>
						<p>운영시간 {HOURS}<br /><small>{HOLIDAY_NOTE}</small></p>
						<div class="cta">
							<a class="btn self" href={SELF_ACTIVATION_URL} target="_blank" rel="noopener"><Icon name="rocket" />셀프개통 바로가기</a>
							<a class="btn" href={PHONE_LINK}><Icon name="phone" />{PHONE}</a>
							<a class="btn alt" href={KAKAO_URL} target="_blank" rel="noopener"><Icon name="chat" />카카오톡 문의</a>
						</div>
					</div>
					<a class="final-mascot" data-ask="mascot_final" href={KAKAO_URL} target="_blank" rel="noopener" aria-label="궁금한 점 고르고 상담하기"><img src="/brand/mascot-lg.webp" alt="" width="371" height="640" loading="lazy" /></a>
				</div>
				<div style="margin-top:1rem"><ChannelAdd /></div>
			</section>
		</main>
		<Footer />
		<style is:global>
			.hs-btn { position: absolute; top: 42%; z-index: 3; width: 2.6rem; height: 2.6rem; border: 0; border-radius: 50%; background: #fff; box-shadow: 0 4px 14px rgba(15, 18, 25, 0.22); font-size: 1.1rem; font-weight: 800; color: var(--accent); cursor: pointer; display: none; }
			.hs-btn.prev { left: -0.9rem; }
			.hs-btn.next { right: -0.9rem; }
			@media (hover: hover) and (min-width: 721px) { .hs-btn { display: block; } }
		</style>
		<script>
			// 선불/알뜰 탭 전환
			const ttabs = document.querySelectorAll<HTMLButtonElement>('.ttabs button');
			const tpanels = document.querySelectorAll<HTMLElement>('.tpanel');
			function openTool(key: string, scroll: boolean) {
				ttabs.forEach((b) => { const on = b.dataset.tt === key; b.classList.toggle('on', on); b.setAttribute('aria-selected', String(on)); });
				tpanels.forEach((pn) => { pn.hidden = pn.dataset.tp !== key; });
				if (scroll) document.getElementById('tools')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
			ttabs.forEach((b) => b.addEventListener('click', () => openTool(b.dataset.tt ?? 'finder', false)));
			const fromHash = () => { const h = location.hash; if (h === '#check' || h === '#finder') openTool(h.slice(1), true); };
			window.addEventListener('hashchange', fromHash);
			fromHash();
			const tabs = document.querySelectorAll<HTMLButtonElement>('.ftabs button');
			const panels = document.querySelectorAll<HTMLElement>('.fpanel');
			tabs.forEach((b) =>
				b.addEventListener('click', () => {
					tabs.forEach((x) => {
						const on = x === b;
						x.classList.toggle('on', on);
						x.setAttribute('aria-selected', String(on));
					});
					panels.forEach((p) => {
						p.hidden = p.dataset.p !== b.dataset.t;
						if (!p.hidden) p.querySelector('.plan-grid')?.scrollTo({ left: 0 });
					});
				}),
			);

			// 데스크톱용 좌우 이동 버튼
			document.querySelectorAll<HTMLElement>('.hs').forEach((hs) => {
				const grid = hs.querySelector<HTMLElement>('.plan-grid');
				if (!grid) return;
				const mk = (cls: string, label: string, dir: number) => {
					const btn = document.createElement('button');
					btn.type = 'button';
					btn.className = `hs-btn ${cls}`;
					btn.setAttribute('aria-label', dir < 0 ? '이전 요금제' : '다음 요금제');
					btn.textContent = label;
					btn.addEventListener('click', () => grid.scrollBy({ left: dir * 330, behavior: 'smooth' }));
					hs.appendChild(btn);
				};
				mk('prev', '‹', -1);
				mk('next', '›', 1);
			});
		</script>
		<script>
			const q = document.getElementById('rq') as HTMLInputElement | null;
			const res = document.getElementById('rres') as HTMLUListElement | null;
			const idx: { t: string; label: string; slug: string }[] = JSON.parse(document.getElementById('regidx')?.textContent ?? '[]');
			function find(v: string) {
				const k = v.trim().replace(/\s+/g, '');
				if (!k) return [];
				const seen = new Set<string>();
				const out: typeof idx = [];
				for (const e of idx) {
					const stem = e.t.replace(/(특별자치도|특별자치시|특별시|광역시|시|군|구)$/, '');
					if ((e.t.includes(k) || (stem && k.includes(stem) && stem.length > 1)) && !seen.has(e.label)) { seen.add(e.label); out.push(e); }
					if (out.length >= 6) break;
				}
				return out;
			}
			function show() {
				if (!q || !res) return;
				const v = q.value;
				if (!v.trim()) { res.hidden = true; return; }
				const m = find(v);
				res.innerHTML = m.length
					? m.map((e, i) => `<li><a href="/region/${e.slug}/" class="${i === 0 ? 'on' : ''}">${e.label} 선불폰 개통</a></li>`).join('')
					: '<li class="none">찾는 지역이 없어요. 아래에서 시·도를 눌러 보세요.</li>';
				res.hidden = false;
			}
			q?.addEventListener('input', show);
			q?.addEventListener('keydown', (ev) => {
				if (ev.key !== 'Enter') return;
				ev.preventDefault();
				const a = res?.querySelector<HTMLAnchorElement>('a');
				if (a) location.href = a.href;
			});
			document.addEventListener('click', (ev) => { if (res && !(ev.target as HTMLElement).closest('.rsearch')) res.hidden = true; });
		</script>
	</body>
</html>
