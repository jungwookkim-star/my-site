---
// 대신 챙겨 줄 분께 보내는 개통 준비 카드 (2026-11-17, 홈페이지 꾸미기 3번)
// 폰을 실제로 준비하는 사람(부모님 본인, 자녀와 함께 가는 보호자, 대신 가는 가족, 외국인 본인)이 따로 있을 때,
// 상황을 고르면 그분이 볼 카드 링크(/card/#parent 등)를 카톡으로 보낼 수 있습니다. 서버에 아무것도 저장하지 않고
// 주소 뒤(#)에는 상황 이름만 담습니다(개인정보, 임의의 글자 없음). 자바스크립트가 없어도 :target으로 카드가 보입니다.
// 사실 근거: 글 foreigner-minor-activation(미성년자, 외국인 서류와 순서, 회선 수, 예약 때 알려 줄 것),
// WhoPicker와 SituationTable(부모님 명의 본인인증, 간편인증 없으면 방문), PrepCard(신분증 종류), HoursBadge(접수 시간),
// 글 prepaid-charge-guide(개통한 날 충전).
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { KAKAO_CHAT_URL, PHONE, PHONE_LINK, HOURS } from '../consts';

const VISIT_STEPS = (who: string) => [
	`카톡이나 전화로 ${who} 개통이라고 알려 주세요.`,
	'방문할 사업장과 날짜를 예약해요. 상세 주소는 예약할 때 알려 드려요.',
	'위 "챙길 것"을 하나씩 준비해요.',
	'예약한 날 사업장에 가서 개통해요. 개통한 날 충전도 함께 해요.',
];
const RESERVE_INFO = '예약할 때 성함, 연락처, 방문하고 싶은 지역, 날짜와 시간, 고른 요금제를 알려 주시면 빨라요.';
const MINOR_DOCS = ['보호자(법정대리인) 신분증', '가족관계확인서', '자녀(미성년자) 신분증', '고객본인확인서'];
const VISIT_ITEMS = ['유심비 1만원 (유심은 사업장에서 준비돼요)', '요금 충전비', '쓸 휴대폰'];

const cards = [
	{
		key: 'parent',
		pick: '부모님 폰',
		pickSub: '부모님께 보내요',
		tag: '부모님 폰 개통',
		title: '부모님 폰, 이것만 챙겨 주세요',
		lead: '부모님 명의로 개통돼서 신분증 촬영, 안면인증, 간편인증은 부모님이 직접 하셔야 해요. 옆에서 도와주시면 약 10분이면 끝나요.',
		check: ['부모님 신분증 (주민등록증이나 운전면허증)', '부모님 간편인증 수단 1가지 (카카오, 토스, 네이버, PASS 등)', '안면인증이 되는 휴대폰', '유심 8,800원 (편의점에서 사거나 퀵 배송, 배송비 무료)'],
		steps: ['유심을 준비해요. 편의점에서 사거나 퀵 배송으로 받아요.', '휴대폰으로 셀프개통을 해요. 약 10분 걸리고, 인증은 부모님이 직접 해요.', '개통한 날 충전해요. 하지 않으면 다음 날 정지되거나 해지될 수 있어요.'],
		notes: ['셀프개통 접수 시간: 신규 08:00~21:50, 번호이동 10:00~19:50 (번호이동은 일요일과 신정, 설, 추석 당일에 접수하지 않아요)', '간편인증 수단이 없으면 예약한 뒤 방문해서 개통해요. 이때는 신분증, 유심비 1만원, 충전비, 쓸 휴대폰을 챙겨요.'],
		links: [{ t: '셀프개통 순서 보기', href: '/guide/' }, { t: '부모님 요금제 보기', href: '/blog/senior-welfare-plans/' }],
	},
	{
		key: 'minor',
		pick: '자녀 폰',
		pickSub: '보호자가 함께 가요',
		tag: '미성년자 개통, 보호자 방문',
		title: '자녀 폰, 보호자가 함께 가요',
		lead: '미성년자는 셀프개통이 안 되고, 예약한 뒤 사업장에 방문해서 개통해요.',
		check: [...MINOR_DOCS, ...VISIT_ITEMS],
		steps: VISIT_STEPS('미성년자'),
		notes: ['미성년자는 선불과 후불 각 1회선까지 개통할 수 있어요. 신용도에 따라 달라질 수 있어요.', RESERVE_INFO, '서류와 절차는 상황에 따라 달라질 수 있으니 방문 전에 상담으로 확인해 주세요.'],
		links: [{ t: '서류 자세히 보기', href: '/blog/foreigner-minor-activation/' }],
	},
	{
		key: 'minor-agent',
		pick: '자녀 폰',
		pickSub: '다른 가족이 대신 가요',
		tag: '미성년자 개통, 대리인 방문',
		title: '자녀 폰, 다른 가족이 대신 가요',
		lead: '보호자 대신 다른 가족이 가면 서류가 더 필요해요. 미성년자는 예약한 뒤 사업장에 방문해서 개통해요.',
		check: [...MINOR_DOCS, '인감증명서', '인감도장이 찍힌 위임장', '대신 가는 분(대리인) 신분증', ...VISIT_ITEMS],
		steps: VISIT_STEPS('미성년자'),
		notes: ['미성년자는 선불과 후불 각 1회선까지 개통할 수 있어요. 신용도에 따라 달라질 수 있어요.', RESERVE_INFO, '서류와 절차는 상황에 따라 달라질 수 있으니 방문 전에 상담으로 확인해 주세요.'],
		links: [{ t: '서류 자세히 보기', href: '/blog/foreigner-minor-activation/' }],
	},
	{
		key: 'foreign',
		pick: '외국인 가족, 친구 폰',
		pickSub: '외국인 본인께 보내요',
		tag: '외국인 개통',
		title: '외국인 가족, 친구 폰 개통',
		lead: '외국인은 셀프개통이 안 되고, 예약한 뒤 사업장에 방문해서 개통해요.',
		check: ['여권이나 외국인 등록증 (필요한 서류는 예약할 때 알려 드려요)', ...VISIT_ITEMS],
		steps: VISIT_STEPS('외국인'),
		notes: ['외국인은 1회선까지 개통할 수 있어요.', RESERVE_INFO],
		links: [{ t: '방문 개통 안내 보기', href: '/visit/' }],
		langs: [
			{ t: 'English', href: '/en/' },
			{ t: '中文', href: '/zh/' },
			{ t: 'Tiếng Việt', href: '/vi/' },
			{ t: '日本語', href: '/ja/' },
		],
	},
];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title="대신 챙겨 줄 분께 보내는 개통 카드 | 커넥트모바일" description="부모님 폰, 자녀 폰, 외국인 가족 폰처럼 실제로 준비하는 분이 따로 있을 때 준비물과 순서를 카드 한 장으로 보내세요." noindex={true} />
	</head>
	<body>
		<Header />
		<main class="cd" id="main">
			<section class="intro" id="cd-intro">
				<p class="kicker">개통 준비 카드</p>
				<h1>대신 챙겨 줄 분께 카드 한 장 보내세요</h1>
				<p class="lead">폰을 실제로 준비하는 사람이 따로 있을 때가 많아요. 상황을 고르면 그분이 볼 카드가 열려요. 카톡으로 보내면 끝이에요.</p>
			</section>

			<nav class="picks" aria-label="상황 고르기">
				{cards.map((c) => (
					<a class="pk" href={`#${c.key}`} data-key={c.key}>
						<b>{c.pick}</b>
						<span>{c.pickSub}</span>
					</a>
				))}
			</nav>

			{cards.map((c) => (
				<section class="ck" id={c.key} data-key={c.key} aria-labelledby={`${c.key}-h`}>
					<p class="tag">{c.tag}</p>
					<h2 id={`${c.key}-h`}>{c.title}</h2>
					<p class="ck-lead">{c.lead}</p>

					<h3>챙길 것 <span class="cnt" data-cnt></span></h3>
					<ul class="chk">
						{c.check.map((t, i) => (
							<li><label><input type="checkbox" data-i={i} /><span>{t}</span></label></li>
						))}
					</ul>

					<h3>이렇게 진행돼요</h3>
					<ol class="steps">
						{c.steps.map((t) => <li>{t}</li>)}
					</ol>

					<h3>알아 둘 것</h3>
					<ul class="notes">
						{c.notes.map((t) => <li>{t}</li>)}
					</ul>

					{c.langs && (
						<div class="langs">
							<p>본인 나라 말로 보기</p>
							<div>{c.langs.map((l) => <a href={l.href} lang={l.href.replace(/\//g, '')}>{l.t}</a>)}</div>
						</div>
					)}

					<div class="ask">
						<a class="kk" href={KAKAO_CHAT_URL} target="_blank" rel="noopener" data-card-ask={c.key}>카톡으로 물어보기</a>
						<a class="tel" href={PHONE_LINK}>{PHONE}</a>
					</div>
					<p class="hours">상담은 매일 {HOURS}에 운영해요.</p>
					<p class="more">{c.links.map((l) => <a href={l.href}>{l.t} ›</a>)}</p>

					<div class="send">
						<button type="button" class="share" data-share={c.key}>이 카드 카톡으로 보내기</button>
						<button type="button" class="copy" data-copy={c.key}>링크 복사</button>
					</div>
				</section>
			))}

			<p class="note">이 카드에는 이름, 전화번호 같은 개인정보가 담기지 않아요. 체크 표시는 이 폰에만 남아요.</p>
		</main>
		<Footer />

		<style>
			main.cd { max-width: 680px; margin: 0 auto; padding: 1.4rem 1rem 4rem; width: auto; }
			.intro { text-align: center; margin-bottom: 1.1rem; }
			.kicker { display: inline-block; margin: 0 0 0.4rem; font-size: 0.78rem; font-weight: 800; color: var(--accent); background: var(--surface-2); padding: 0.2rem 0.75rem; border-radius: 999px; }
			.intro h1 { font-size: clamp(1.45rem, 5vw, 1.9rem); line-height: 1.3; margin: 0 0 0.5rem; text-wrap: balance; }
			.intro .lead { margin: 0 auto; max-width: 34rem; color: rgb(var(--gray)); font-size: 0.98rem; line-height: 1.65; }
			.picks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; margin-bottom: 1.3rem; }
			.pk { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.9rem 1rem; border-radius: 14px; background: var(--surface); box-shadow: var(--box-shadow); text-decoration: none; color: inherit; border: 2px solid transparent; }
			.pk b { font-size: 1.02rem; }
			.pk span { font-size: 0.84rem; color: rgb(var(--gray)); }
			.pk:hover, .pk.on { border-color: var(--accent); }
			.pk.on b { color: var(--accent); }

			.ck { display: none; background: var(--surface); border-radius: 18px; box-shadow: var(--box-shadow); padding: 1.3rem 1.3rem 1.2rem; font-size: 1.06rem; scroll-margin-top: 5rem; }
			.ck:target { display: block; }
			.tag { display: inline-block; margin: 0 0 0.45rem; font-size: 0.8rem; font-weight: 800; color: #fff; background: var(--accent); padding: 0.22rem 0.75rem; border-radius: 999px; }
			.ck h2 { margin: 0 0 0.45rem; font-size: clamp(1.35rem, 4.6vw, 1.65rem); line-height: 1.3; text-wrap: balance; }
			.ck-lead { margin: 0 0 1rem; line-height: 1.7; }
			.ck h3 { display: flex; align-items: baseline; gap: 0.5rem; margin: 1.15rem 0 0.5rem; font-size: 1.08rem; color: var(--accent); }
			.cnt { font-size: 0.85rem; font-weight: 700; color: rgb(var(--gray)); }
			.chk { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
			.chk label { display: flex; align-items: flex-start; gap: 0.7rem; padding: 0.7rem 0.85rem; border-radius: 12px; background: var(--surface-3); cursor: pointer; line-height: 1.5; }
			.chk input { flex-shrink: 0; width: 1.35rem; height: 1.35rem; margin-top: 0.08rem; accent-color: var(--green); }
			.chk input:checked + span { color: rgb(var(--gray)); text-decoration: line-through; }
			.steps { margin: 0; padding-left: 1.4rem; display: grid; gap: 0.45rem; line-height: 1.6; }
			.steps li::marker { font-weight: 800; color: var(--accent); }
			.notes { margin: 0; padding: 0.8rem 1rem 0.8rem 2rem; border-radius: 12px; background: var(--tint-amber); box-shadow: inset 0 0 0 1.5px var(--line-amber); display: grid; gap: 0.4rem; font-size: 0.95rem; line-height: 1.6; }
			.langs { margin-top: 1rem; }
			.langs p { margin: 0 0 0.4rem; font-weight: 800; font-size: 0.92rem; }
			.langs div { display: flex; flex-wrap: wrap; gap: 0.45rem; }
			.langs a { padding: 0.45rem 0.9rem; border-radius: 999px; background: var(--surface-2); font-weight: 700; text-decoration: none; }
			.ask { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.2rem; }
			.ask a { flex: 1 1 150px; text-align: center; padding: 0.85rem 1rem; border-radius: 999px; font-weight: 800; text-decoration: none; font-size: 1.02rem; }
			.ask .kk { background: #fee500; color: #191919; }
			.ask .tel { background: var(--surface); color: var(--accent); box-shadow: inset 0 0 0 2px var(--accent); }
			.hours { margin: 0.6rem 0 0; text-align: center; font-size: 0.86rem; color: rgb(var(--gray)); }
			.more { margin: 0.5rem 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.3rem 1rem; font-size: 0.9rem; }
			.more a { font-weight: 700; color: var(--accent); }
			.send { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.1rem; padding-top: 1rem; border-top: 1px dashed var(--line); }
			.send button { flex: 1 1 150px; padding: 0.8rem 1rem; border-radius: 12px; border: 0; font: inherit; font-weight: 800; cursor: pointer; }
			.send .share { background: var(--accent); color: #fff; }
			.send .copy { background: var(--surface-2); color: var(--accent); }
			.note { margin: 1.2rem 0 0; font-size: 0.8rem; color: rgb(var(--gray)); text-align: center; line-height: 1.6; }
			main.cd.picked .intro { display: none; }
			main.cd.picked .picks { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.4rem; }
			main.cd.picked .pk { padding: 0.55rem 0.6rem; box-shadow: none; background: var(--surface-2); }
			main.cd.picked .pk b { font-size: 0.86rem; }
			main.cd.picked .pk span { font-size: 0.72rem; }
			@media (max-width: 560px) {
				main.cd.picked .picks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
			}
		</style>

		<script is:inline>
			(function () {
				var KEYS = ['parent', 'minor', 'minor-agent', 'foreign'];
				var main = document.getElementById('main');
				function gtag() { if (window.gtag) window.gtag.apply(null, arguments); }
				function toast(msg) {
					var t = document.createElement('div');
					t.textContent = msg;
					t.setAttribute('role', 'status');
					t.style.cssText = 'position:fixed;left:50%;bottom:5.5rem;transform:translateX(-50%);z-index:200;background:rgba(15,18,25,.92);color:#fff;padding:.6rem 1.1rem;border-radius:999px;font-size:.9rem;font-weight:700;max-width:calc(100% - 2rem);text-align:center';
					document.body.appendChild(t);
					setTimeout(function () { t.remove(); }, 2400);
				}
				function current() { var k = location.hash.replace(/^#/, ''); return KEYS.indexOf(k) >= 0 ? k : ''; }
				function urlOf(k) { return location.origin + location.pathname + '#' + k; }
				function store(k) { return 'card-check-' + k; }
				function count(sec) {
					var all = sec.querySelectorAll('.chk input');
					var on = sec.querySelectorAll('.chk input:checked');
					var c = sec.querySelector('[data-cnt]');
					if (c) c.textContent = on.length + ' / ' + all.length;
				}
				function show() {
					var k = current();
					main.classList.toggle('picked', !!k);
					document.querySelectorAll('.pk').forEach(function (a) { a.classList.toggle('on', a.dataset.key === k); });
					if (!k) return;
					var sec = document.getElementById(k);
					if (sec && !sec.dataset.ready) {
						sec.dataset.ready = '1';
						var saved = [];
						try { saved = JSON.parse(localStorage.getItem(store(k)) || '[]'); } catch (e) { saved = []; }
						sec.querySelectorAll('.chk input').forEach(function (box) {
							if (saved.indexOf(Number(box.dataset.i)) >= 0) box.checked = true;
							box.addEventListener('change', function () {
								var list = [];
								sec.querySelectorAll('.chk input:checked').forEach(function (b) { list.push(Number(b.dataset.i)); });
								try { localStorage.setItem(store(k), JSON.stringify(list)); } catch (e) {}
								count(sec);
							});
						});
						count(sec);
					}
					gtag('event', 'card_view', { page_path: location.pathname, card: k });
				}
				document.addEventListener('click', function (e) {
					var s = e.target.closest('[data-share]');
					var c = e.target.closest('[data-copy]');
					var k = (s && s.dataset.share) || (c && c.dataset.copy);
					if (!k) return;
					var url = urlOf(k);
					var title = (document.getElementById(k + '-h') || {}).textContent || '개통 준비 카드';
					function copy() {
						if (navigator.clipboard) {
							navigator.clipboard.writeText(url).then(function () { toast('링크를 복사했어요. 카톡 대화창에 붙여 넣어 보내 주세요.'); }, function () { window.prompt('링크를 복사해 주세요', url); });
						} else { window.prompt('링크를 복사해 주세요', url); }
					}
					if (s && navigator.share) {
						navigator.share({ title: title, text: title + ' (커넥트모바일 개통 준비 카드)', url: url }).then(function () {
							gtag('event', 'card_share', { page_path: location.pathname, card: k, method: 'share' });
						}, function (err) { if (!err || err.name !== 'AbortError') copy(); });
						return;
					}
					copy();
					gtag('event', 'card_share', { page_path: location.pathname, card: k, method: 'copy' });
				});
				window.addEventListener('hashchange', show);
				show();
			})();
		</script>
	</body>
</html>
