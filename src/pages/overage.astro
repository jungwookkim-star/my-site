---
import PageHead from '../components/PageHead.astro';
import VerifiedStamp from '../components/VerifiedStamp.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { items } from '../lib/planItems';
import { PHONE, PHONE_LINK, KAKAO_CHAT_URL } from '../consts';

// 선불 요금제의 제공량을 숫자로 풀어서 화면으로 넘깁니다. (요금 찾기와 같은 요금제 목록)
const pool = items
	.filter((i) => i.kind === 'prepaid')
	.map((i) => {
		const p = i.plan;
		const voice = p.voice.match(/^(\d+)분/);
		const sms = p.sms.match(/^(\d+)건/);
		const th = `${p.dataNote ?? ''} ${p.data}`.match(/최대\s*([\d.]+\s*[MK]bps)/);
		return {
			name: p.name,
			price: i.price,
			voiceMin: voice ? Number(voice[1]) : null, // null이면 통화 기본제공
			smsN: sms ? Number(sms[1]) : null, // null이면 문자 기본제공
			gb: Math.round(i.gb * 10) / 10,
			dataText: p.data,
			throttle: th ? th[1].replace(/\s/g, '') : null,
			exact: p.name === '선불 LTE 기본1', // 초과 요금이 공식 안내로 확인된 요금제(KT망 선불)
		};
	});
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title="선불폰 초과 요금 계산기 | 내 사용량이면 추가 요금이 나올까? | 커넥트모바일"
			description="통화, 문자, 데이터 사용량을 넣으면 선불 요금제별로 제공량을 넘는지, 넘으면 추가 요금이 얼마나 나오는지 미리 보여 드립니다. 앤텔레콤 공식 요금제 안내 기준."
		/>
		<style is:global>
			.ov-head { text-align: center; padding: 2rem 0 1rem; }
			.ov-head h1 { margin-bottom: 0.5rem; }
			.ov-head p { color: rgb(var(--gray)); margin: 0; font-size: 0.95rem; }
			.ov { background: var(--surface); border-radius: 20px; box-shadow: var(--box-shadow); padding: 1.5rem 1.3rem; max-width: 720px; margin: 1rem auto 0; }
			.ov-pre { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
			.ov-pre button { font: inherit; font-size: 0.85rem; font-weight: 700; padding: 0.4rem 0.9rem; border-radius: 999px; border: 1px solid var(--line); background: var(--surface-3); color: var(--accent); cursor: pointer; }
			.ov-pre button.on { background: var(--accent); color: #fff; border-color: var(--accent); }
			.ov-in { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.8rem; }
			.ov-in label { display: grid; gap: 0.3rem; font-weight: 800; font-size: 0.9rem; }
			.ov-in span.u { font-weight: 500; font-size: 0.78rem; color: rgb(var(--gray)); }
			.ov-in input { font: inherit; font-size: 1.2rem; font-weight: 800; padding: 0.5rem 0.8rem; border: 2px solid var(--line); border-radius: 12px; text-align: right; width: 100%; box-sizing: border-box; }
			.ov-in input:focus { outline: none; border-color: var(--accent); }
			.ov-msg { margin: 1.2rem 0 0.8rem; padding: 0.8rem 1rem; border-radius: 14px; background: var(--tint-green); color: var(--green); font-weight: 800; font-size: 0.95rem; line-height: 1.5; }
			.ov-list { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
			.ov-row { border-radius: 14px; background: var(--surface-3); padding: 0.7rem 1rem; display: grid; gap: 0.2rem; }
			.ov-row.best { background: var(--tint-green); box-shadow: inset 0 0 0 2px var(--line-green); }
			.ov-top { display: flex; justify-content: space-between; align-items: baseline; gap: 0.8rem; flex-wrap: wrap; }
			.ov-top b { font-size: 0.98rem; }
			.ov-tot { font-weight: 800; color: var(--accent); font-size: 1.05rem; }
			.ov-tot.q { color: var(--warn); font-size: 0.9rem; }
			.ov-sub { font-size: 0.82rem; color: rgb(var(--gray-dark)); }
			.ov-chip { display: inline-block; font-size: 0.72rem; font-weight: 800; padding: 0.1rem 0.55rem; border-radius: 999px; margin-right: 0.35rem; }
			.ov-chip.ok { background: var(--tint-green); color: var(--green); }
			.ov-chip.th { background: var(--tint-amber); color: var(--amber); }
			.ov-chip.ex { background: var(--tint-warn); color: var(--warn); }
			.ov-chip.un { background: var(--surface-2); color: var(--ink); }
			.ov-note { font-size: 0.8rem; color: rgb(var(--gray)); line-height: 1.65; margin: 1.1rem 0 0; }
			.ov-act { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
			.ov-act a { flex: 1 1 150px; text-align: center; padding: 0.7rem 1rem; border-radius: 999px; font-weight: 800; text-decoration: none; }
			.ov-act .kk { background: #fee500; color: #191919; }
			.ov-act .pl { background: var(--surface); color: var(--accent); box-shadow: inset 0 0 0 2px var(--accent); }
		</style>
	</head>
	<body>
		<Header />
		<main class="wide" id="main">
			<PageHead title="초과 요금 계산기" sub="내 사용량이면 추가 요금이 나올까요? 선불 요금제별로 미리 확인해 보세요." />

			<div class="ov">
				<div class="ov-pre" role="group" aria-label="사용량 예시">
					<button type="button" data-v="150" data-s="30" data-d="0.2">통화 위주</button>
					<button type="button" data-v="100" data-s="50" data-d="2">가볍게 인터넷</button>
					<button type="button" data-v="300" data-s="100" data-d="15">영상과 SNS 많이</button>
				</div>
				<div class="ov-in">
					<label>한 달 통화<span class="u">분 (대략)</span><input id="ov-v" type="number" inputmode="numeric" min="0" max="20000" value="100" /></label>
					<label>한 달 문자<span class="u">건 (대략)</span><input id="ov-s" type="number" inputmode="numeric" min="0" max="20000" value="50" /></label>
					<label>한 달 데이터<span class="u">GB (대략)</span><input id="ov-d" type="number" inputmode="decimal" min="0" max="500" step="0.1" value="2" /></label>
				</div>

				<div class="ov-msg" id="ov-msg" role="status" aria-live="polite"></div>
				<ol class="ov-list" id="ov-list"></ol>

				<p class="ov-note">
					초과 요금은 앤텔레콤 공식 요금제 안내에 적힌 KT망 선불 기준(음성 1초당 1.98원, 단문 22원, 데이터 약 22.5원/MB, 부가세 포함)으로 계산해요.
					문자는 단문 기준이고, 장문과 MMS는 더 비싸요. 요금제에 "기본제공"으로 적힌 통화와 문자도 과다 사용 기준이 있어요.
					L망 선불은 요금제마다 초과 요금이 달라서 금액은 계산하지 않고 "제공량을 넘는지"만 알려 드려요. 실제 요금은 앤텔레콤 이용약관을 확인하세요.
					<a href="/blog/prepaid-overage-fee/">초과 요금 자세히 보기</a>
				</p>
				<VerifiedStamp align="left" />
				<div class="ov-act">
					<a class="kk" href={KAKAO_CHAT_URL} target="_blank" rel="noopener" id="ov-ask">이 사용량으로 상담하기</a>
					<a class="pl" href="/plans/">요금제 전체 보기</a>
				</div>
			</div>
		</main>
		<Footer />
		<script is:inline define:vars={{ pool }}>
			(function () {
				var RATE = { voiceSec: 1.98, sms: 22, dataMb: 22.5 };
				var $ = function (id) { return document.getElementById(id); };
				var won = function (n) { return Math.round(n).toLocaleString('ko-KR') + '원'; };
				var num = function (el) { var n = parseFloat(el.value); return isFinite(n) && n > 0 ? n : 0; };
				var last = null;
				// 데이터를 다 쓴 뒤 속도(Mbps). 추천은 제공량 이내이거나, 소진 후에도 3Mbps 이상 유지되는 요금제만 합니다.
				var mbps = function (t) { var m = /([\d.]+)([MK])bps/.exec(t || ''); return m ? (m[2] === 'K' ? parseFloat(m[1]) / 1000 : parseFloat(m[1])) : 99; };
				function calc(p, v, s, d) {
					var ov = p.voiceMin !== null ? Math.max(0, v - p.voiceMin) : 0;
					var os = p.smsN !== null ? Math.max(0, s - p.smsN) : 0;
					var od = Math.max(0, d - p.gb);
					var chargeData = od > 0 && !p.throttle;
					var parts = [];
					if (ov > 0) parts.push('통화 ' + Math.round(ov) + '분 초과');
					if (os > 0) parts.push('문자 ' + Math.round(os) + '건 초과');
					if (od > 0) parts.push('데이터 ' + (Math.round(od * 10) / 10) + 'GB 초과');
					var r = { p: p, parts: parts, extra: 0, state: 'ok' };
					if (ov > 0 || os > 0 || chargeData) {
						if (p.exact) {
							r.extra = ov * 60 * RATE.voiceSec + os * RATE.sms + (chargeData ? od * 1024 * RATE.dataMb : 0);
							r.state = 'ex';
						} else r.state = 'un';
					} else if (od > 0) r.state = 'th';
					r.total = r.state === 'un' ? Infinity : p.price + r.extra;
					return r;
				}
				function render() {
					var v = num($('ov-v')), s = num($('ov-s')), d = num($('ov-d'));
					var rows = pool.map(function (p) { return calc(p, v, s, d); });
					rows.sort(function (a, b) { return a.total - b.total || a.p.price - b.p.price; });
					var best = rows.find(function (r) { return r.total !== Infinity && (r.state !== 'th' || mbps(r.p.throttle) >= 3); });
					var list = $('ov-list');
					list.innerHTML = '';
					rows.forEach(function (r) {
						var li = document.createElement('li');
						li.className = 'ov-row' + (best && r === best ? ' best' : '');
						var top = document.createElement('div'); top.className = 'ov-top';
						var b = document.createElement('b'); b.textContent = r.p.name;
						var t = document.createElement('span');
						t.className = 'ov-tot' + (r.state === 'un' ? ' q' : '');
						t.textContent = r.state === 'un' ? '제공량을 넘어요' : (r.extra > 0 ? '약 ' + won(r.total) : won(r.total));
						top.appendChild(b); top.appendChild(t);
						var sub = document.createElement('div'); sub.className = 'ov-sub';
						var chip = document.createElement('span');
						var txt;
						if (r.state === 'ok') { chip.className = 'ov-chip ok'; chip.textContent = '추가 요금 없음'; txt = '월 ' + won(r.p.price) + ', 제공량 이내예요.'; }
						else if (r.state === 'th') { chip.className = 'ov-chip th'; chip.textContent = mbps(r.p.throttle) < 1 ? '속도 많이 느려짐' : '속도제한'; txt = '월 ' + won(r.p.price) + '. 데이터를 다 쓰면 최대 ' + r.p.throttle + '로 계속 쓸 수 있고 추가 요금은 없어요.'; }
						else if (r.state === 'ex') { chip.className = 'ov-chip ex'; chip.textContent = '초과 요금'; txt = '월 ' + won(r.p.price) + ' + 초과 약 ' + won(r.extra) + ' (' + r.parts.join(', ') + ')'; }
						else { chip.className = 'ov-chip un'; chip.textContent = '요금 확인 필요'; txt = r.parts.join(', ') + '. 초과 요금은 요금제 안내를 확인하거나 문의해 주세요.'; }
						sub.appendChild(chip); sub.appendChild(document.createTextNode(txt));
						li.appendChild(top); li.appendChild(sub);
						list.appendChild(li);
					});
					var msg = $('ov-msg');
					if (best) {
						var extra = best.extra > 0 ? ' (초과 요금 포함 약 ' + won(best.total) + ')' : '';
						msg.textContent = '이 사용량에 가장 저렴한 요금제: ' + best.p.name + ', 월 ' + won(best.p.price) + extra + (best.state === 'th' ? '. 데이터를 다 쓰면 속도가 느려져요.' : '');
					} else msg.textContent = '이 사용량은 선불 요금제 대부분의 제공량을 넘어요. 상담으로 맞는 요금제를 찾아 드릴게요.';
					last = { v: v, s: s, d: d, best: best ? best.p.name : '' };
					var g = window.gtag;
					clearTimeout(render.t);
					render.t = setTimeout(function () { if (g) g('event', 'overage_calc', { page_path: location.pathname, best: last.best || 'none' }); }, 1500);
				}
				['ov-v', 'ov-s', 'ov-d'].forEach(function (id) { $(id).addEventListener('input', function () { document.querySelectorAll('.ov-pre button').forEach(function (b) { b.classList.remove('on'); }); render(); }); });
				document.querySelectorAll('.ov-pre button').forEach(function (b) {
					b.addEventListener('click', function () {
						$('ov-v').value = b.dataset.v; $('ov-s').value = b.dataset.s; $('ov-d').value = b.dataset.d;
						document.querySelectorAll('.ov-pre button').forEach(function (x) { x.classList.toggle('on', x === b); });
						render();
					});
				});
				$('ov-ask').addEventListener('click', function () {
					if (!last) return;
					var t = '요금제 상담 부탁드려요.\n(한 달 사용량: 통화 ' + last.v + '분 / 문자 ' + last.s + '건 / 데이터 ' + last.d + 'GB)' + (last.best ? '\n(계산기 추천: ' + last.best + ')' : '');
					try { navigator.clipboard.writeText(t).then(function () {
						var el = document.createElement('div'); el.className = 'ask-toast'; el.textContent = '사용량이 복사됐어요. 카톡 채팅창에 붙여넣기 해 주세요.';
						document.body.appendChild(el); setTimeout(function () { el.remove(); }, 4000);
					}, function () {}); } catch (e) { /* 복사를 못 해도 채팅창은 열립니다 */ }
					if (window.gtag) window.gtag('event', 'overage_ask', { page_path: location.pathname });
				});
				render();
			})();
		</script>
	</body>
</html>
