---
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import Layout from '../layouts/BlogPost.astro';
import { SITE_TITLE, ADDRESS, HOURS, PHONE } from '../consts';
---

<Layout
	title="센터 소개"
	description={`${SITE_TITLE} 소개`}
	pubDate={new Date('September 29 2026')}
	heroImage={AboutHeroImage}
>
	<p>{SITE_TITLE}는 선불·후불 휴대폰 개통을 도와드리는 센터입니다. (센터 소개 문구를 여기에 적어주세요.)</p>
	<ul>
		<li>전화: {PHONE}</li>
		<li>운영시간: {HOURS}</li>
		<li>개통 지역: {ADDRESS}</li>
	</ul>
</Layout>
