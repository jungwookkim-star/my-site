---
import Icon from '../components/Icon.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import StuckHelp from '../components/StuckHelp.astro';
import ShareButton from '../components/ShareButton.astro';
import ActivationCode from '../components/ActivationCode.astro';
import Header from '../components/Header.astro';
import { PHONE, PHONE_LINK, KAKAO_URL, SELF_ACTIVATION_URL, HOURS, HOLIDAY_NOTE } from '../consts';

const steps = [
	{
		title: '상담 · 요금제 선택',
		time: '전화·카카오톡으로 진행',
		desc: '전화나 카카오톡으로 사용 패턴을 알려주시면 맞는 요금제를 골라 드립니다. 홈의 "내게 맞는 요금제 찾기"로 미리 후보를 좁혀 오셔도 좋습니다.',
		tips: ['선불과 알뜰(후불) 중 어떤 방식이 맞는지 같이 정합니다.', '번호이동인지 신규 개통인지 알려주세요.', '미납·연체 이력이 있다면 상담 때 먼저 말씀해 주세요. 외국인·미성년자는 셀프개통이 아니라 대면 개통(예약)으로 진행합니다.'],
	},
	{
		title: '유심 준비 (퀵 배송·편의점)',
		time: '퀵 배송은 대부분 2시간 이내',
		desc: '서울·수도권·광역시·제주는 주소와 연락처를 알려주시면 퀵 배송(주문 10:00~22:00, 배송비 무료)으로 보내 드리고, 그 외 지역은 편의점에서 유심을 구매하시면 됩니다. 유심비는 8,800원입니다.',
		tips: ['유심이 내 휴대폰에 맞는지 상담 때 기종을 알려주세요.', '개통 전에 기존 휴대폰의 유심을 미리 빼지 마세요.', '명절 연휴에는 개통이 일부 제한될 수 있습니다.'],
	},
	{
		title: '셀프개통 진행',
		time: '약 10분',
		desc: '유심을 받은 뒤 셀프개통 페이지에서 안내에 따라 안면인증과 간편인증으로 본인 확인을 하고 개통을 진행합니다. 처음이어도 화면 안내를 따라가면 됩니다.',
		tips: ['안면인증이 가능한 휴대폰, 간편인증 수단, 신분증을 미리 준비하세요.', '셀프개통에는 필요하지 않지만, 멤버십 앱에서 개통할 때는 태블릿 소유자 회원번호 2936849를 입력합니다.', '안정적인 인터넷 환경에서 진행하세요.', '막히면 멈추고 바로 전화나 카카오톡으로 문의하세요.'],
	},
	{
		title: '유심 장착 · 사용 시작',
		time: '개통 직후',
		desc: '개통이 끝나면 새 유심을 휴대폰에 끼우고 전원을 다시 켜 사용을 시작합니다. 통화·문자·데이터가 되는지 확인해 보세요.',
		tips: ['선불 요금제는 개통 당일 충전이 필요합니다. 충전하지 않으면 다음 날 번호가 정지되거나 해지될 수 있는 것으로 안내됩니다.', '데이터가 안 잡히면 재부팅 후 설정(APN 등)을 확인하세요.', '필요한 설정은 문의하시면 안내해 드립니다.'],
	},
];

const checklist = [
	'본인 명의 신분증',
	'유심을 지원하는 휴대폰 (기종은 상담 때 확인)',
	'안면인증이 가능한 휴대폰과 간편인증 수단',
	'번호이동이라면 기존 통신사 정보',
	'유심을 받을 주소와 연락처',
];

const cases = [
	{ t: '번호이동 · 신규 개통', d: '둘 다 상담 가능합니다. 기존 번호를 그대로 쓰고 싶다면 상담 때 알려주세요.' },
	{ t: '미납·연체가 있어요', d: '선불 요금제는 다른 통신사 미납이 있어도 개통할 수 있는 것으로 안내됩니다. 알뜰(후불)은 타사 체납이 있으면 개통할 수 없으니 상담으로 확인하세요.' },
	{ t: '외국인이에요', d: '대면 개통만 가능합니다. 가산 사업장(가산아스크타워)은 방문 전에 반드시 예약해 주세요.' },
	{ t: '미성년자예요', d: '대면 개통만 가능합니다. 법정대리인 서류가 필요하고, 방문 전에 반드시 예약해 주세요.' },
	{ t: '대면으로 개통하고 싶어요', d: '서울 금천구 가산동 가산아스크타워 사업장에서 대면 개통이 가능하고, 방문 전에 반드시 예약해야 합니다. 전국 시·도별 대면 사업장(세종 제외)은 지역별 안내에서 확인할 수 있고, 모두 사전 예약이 필요해요.' },
];

const selfSteps = [	'셀프개통 페이지에 접속해서 "개통하기" 선택',	'준비한 유심에 맞춰 KT 또는 LG 통신망 선택',	'안면인증 진행',	'가능한 간편인증 수단으로 본인 확인',	'가입 유형 선택 (신규가입 또는 번호이동)',	'가입 정보와 유심 정보 입력',	'사용 목적에 맞는 선불 요금제 선택',	'입력 내용 확인 후 개통 가능 여부 사전 체크 (번호이동은 새 번호를 고르는 단계가 없음)',	'개통 완료 후 요금 충전, 유심 장착',	'휴대폰 재부팅 후 통화·문자·데이터 테스트',];
const howTo = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: '알뜰폰 유심 준비부터 셀프개통까지',
	description: '상담부터 유심 준비, 셀프개통, 사용 시작까지 4단계로 안내합니다.',
	step: steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.desc })),
};
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title="알뜰폰 개통 과정 안내: 상담부터 셀프개통까지 4단계 | 커넥트모바일"
			description="상담, 유심 준비, 10분 셀프개통, 사용 시작까지 개통 과정을 단계별로 안내합니다. 준비물 체크리스트와 상황별 안내도 확인하세요."
			jsonLd={[howTo]}
		/>
		<style>
			.head { text-align: center; padding: 2rem 0 1rem; }
			.head h1 { margin-bottom: 0.5rem; }
			.head p { color: rgb(var(--gray)); margin: 0; }
			.summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.8rem; margin: 2rem 0 0; padding: 0; list-style: none; }
			.summary li { background: #fff; border-radius: 14px; box-shadow: var(--box-shadow); padding: 0.9rem 1rem; font-size: 0.9rem; }
			.summary strong { display: block; color: var(--accent); font-size: 0.8rem; }
			h2.sec { text-align: center; margin: 3.5rem 0 1.5rem; }
			.tl { list-style: none; margin: 0; padding: 0; position: relative; }
			.tl::before { content: ''; position: absolute; left: 1.15rem; top: 0.5rem; bottom: 0.5rem; width: 2px; background: linear-gradient(#2337ff, #7c3aed); opacity: 0.25; }
			.tl > li { position: relative; padding-left: 3.4rem; margin-bottom: 1.4rem; }
			.num { position: absolute; left: 0; top: 0; width: 2.3rem; height: 2.3rem; border-radius: 50%; background: linear-gradient(135deg, #2337ff, #7c3aed); color: #fff; font-weight: 800; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(35, 55, 255, 0.3); }
			.step { background: #fff; border-radius: 14px; box-shadow: var(--box-shadow); padding: 1.2rem 1.3rem; }
			.step h3 { margin: 0 0 0.2rem; font-size: 1.15rem; }
			.time { display: inline-block; font-size: 0.78rem; font-weight: 700; color: var(--accent); background: #eef1ff; padding: 0.1rem 0.6rem; border-radius: 999px; margin-bottom: 0.6rem; }
			.step p { margin: 0 0 0.6rem; font-size: 0.95rem; }
			.step ul { margin: 0; padding-left: 1.1rem; }
			.step li { font-size: 0.88rem; color: rgb(var(--gray-dark)); }
			.resultbox { background: #fff; border-radius: 14px; box-shadow: var(--box-shadow); border-left: 5px solid #12b76a; padding: 1rem 1.3rem; margin-top: 1.2rem; }
			.resultbox p { margin: 0.4rem 0 0.8rem; font-size: 0.92rem; color: rgb(var(--gray-dark)); }
			.resultbox .rb { display: flex; gap: 0.6rem; flex-wrap: wrap; }
			.resultbox .btn { padding: 0.55rem 1.1rem; font-size: 0.9rem; }
			.selfsteps { background: #fff; border-radius: 14px; box-shadow: var(--box-shadow); padding: 1rem 1.3rem; margin-top: 1.4rem; }
			.selfsteps summary { cursor: pointer; font-weight: 700; }
			.selfsteps ol { margin: 0.8rem 0 0.4rem; padding-left: 1.3rem; }
			.selfsteps li { font-size: 0.93rem; margin-bottom: 0.35rem; }
			.selfsteps p { margin: 0.5rem 0 0; font-size: 0.85rem; color: rgb(var(--gray)); }
			.two { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
			.box { background: #fff; border-radius: 14px; box-shadow: var(--box-shadow); padding: 1.2rem 1.3rem; }
			.box h3 { margin: 0 0 0.6rem; font-size: 1.1rem; }
			.simphoto { margin: 0 auto; max-width: 720px; }
			.simphoto img { width: 100%; height: auto; border-radius: 14px; box-shadow: var(--box-shadow); margin: 0; }
			.simphoto figcaption { text-align: center; font-size: 0.88rem; color: rgb(var(--gray)); margin-top: 0.6rem; }
			.cardgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 1rem; }
			.cardgrid img { width: 100%; height: auto; border-radius: 14px; box-shadow: var(--box-shadow); margin: 0; }
			.check { list-style: none; margin: 0; padding: 0; }
			.check li { position: relative; padding-left: 1.7rem; margin-bottom: 0.5rem; font-size: 0.93rem; }
			.check li::before { content: '✓'; position: absolute; left: 0; top: 0; width: 1.25rem; height: 1.25rem; border-radius: 50%; background: #e8f5ee; color: #0b7a70; font-weight: 800; font-size: 0.75rem; display: flex; align-items: center; justify-content: center; }
			.cases dt { font-weight: 700; margin-top: 0.7rem; font-size: 0.93rem; }
			.cases dt:first-child { margin-top: 0; }
			.cases dd { margin: 0.15rem 0 0; font-size: 0.88rem; color: rgb(var(--gray-dark)); }
			.more { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.8rem; }
			.more a { display: block; background: #fff; border-radius: 14px; box-shadow: var(--box-shadow); padding: 1rem 1.1rem; text-decoration: none; font-weight: 700; font-size: 0.93rem; color: rgb(var(--black)); }
			.more a:hover { color: var(--accent); }
			.help { text-align: center; background: #fff; border-radius: 16px; box-shadow: var(--box-shadow); padding: 2rem 1rem; margin-top: 3rem; }
			.help h2 { margin: 0 0 0.4rem; font-size: 1.4rem; }
			.help p { color: rgb(var(--gray)); margin: 0 0 1rem; font-size: 0.92rem; }
			.cta { display: flex; gap: 0.7rem; justify-content: center; flex-wrap: wrap; }
			.btn { display: inline-block; padding: 0.7rem 1.4rem; border-radius: 999px; text-decoration: none; font-weight: 700; background: var(--accent); color: #fff; }
			.btn.self { background: #ff3b30; }
			.btn.alt { background: #fee500; color: #191919; }
			@media (max-width: 720px) { .cta { flex-direction: column; } .cta .btn { text-align: center; } }
		</style>
	</head>
	<body>
		<Header />
		<main id="main" class="wide">
			<div class="head">
				<h1>알뜰폰 개통 과정 안내</h1>
				<p>상담부터 사용 시작까지, 어떤 순서로 진행되는지 미리 확인하세요.</p>
			</div>

			<ul class="summary">
				<li><strong>STEP 1</strong>상담·요금제 선택</li>
				<li><strong>STEP 2</strong>유심 준비</li>
				<li><strong>STEP 3</strong>셀프개통 (약 10분)</li>
				<li><strong>STEP 4</strong>유심 장착·사용 시작</li>
			</ul>

			<h2 class="sec">단계별로 자세히 볼게요</h2>
			<ol class="tl">
				{steps.map((s, i) => (
					<li>
						<span class="num">{i + 1}</span>
						<div class="step">
							<h3>{s.title}</h3>
							<span class="time">{s.time}</span>
							<p>{s.desc}</p>
							<ul>{s.tips.map((t) => <li>{t}</li>)}</ul>
						</div>
					</li>
				))}
			</ol>

			<details class="selfsteps">
				<summary>셀프개통 화면은 이런 순서로 진행돼요 (10단계)</summary>
				<ol>{selfSteps.map((s) => <li>{s}</li>)}</ol>
				<p>셀프개통 페이지: <a href="https://www.n-telecom.co.kr/connect" target="_blank" rel="noopener">www.n-telecom.co.kr/connect</a></p>
			</details>

			<div class="resultbox">
				<strong>신청한 뒤에는 결과를 확인하세요</strong>
				<p>셀프개통을 신청하면 처리에 약 5~10분이 걸리고, 접수번호로 결과를 조회할 수 있어요. 셀프개통 로그인 화면의 "개통결과 조회"에서 확인하고, 카카오톡 채널로 접수 여부를 알려 주시면 충전 방법까지 안내해 드립니다.</p>
				<div class="rb"><a class="btn self sm" href={SELF_ACTIVATION_URL} target="_blank" rel="noopener"><Icon name="rocket" />개통결과 조회하러 가기</a><a class="btn alt sm" href={KAKAO_URL} target="_blank" rel="noopener"><Icon name="chat" />접수 여부 알리기</a></div>
			</div>

			<div style="margin-top:2rem"><ActivationCode /></div>

			<h2 class="sec">개통하다 막히셨나요?</h2>
			<StuckHelp />

			<h2 class="sec">시작 전에 확인하세요</h2>
			<div class="two">
				<div class="box">
					<h3>준비물 체크리스트</h3>
					<ul class="check">{checklist.map((c) => <li>{c}</li>)}</ul>
					<p style="font-size:0.82rem;color:rgb(var(--gray));margin:0.8rem 0 0">개통 유형에 따라 필요한 서류나 인증 방식이 다를 수 있어, 상담 때 정확히 안내해 드립니다.</p>
				</div>
				<div class="box">
					<h3>이런 경우에도 상담 가능해요</h3>
					<dl class="cases">
						{cases.map((c) => <><dt>{c.t}</dt><dd>{c.d}</dd></>)}
					</dl>
				</div>
			</div>

			<p class="note" style="text-align:center;margin-top:2rem">실물 유심 대신 <strong>eSIM</strong>으로도 개통할 수 있어요. 선불 eSIM은 LG망에서 가능하고 발급비는 2,750원입니다. <a href="/blog/esim-vs-usim/">eSIM 접수 순서 보기</a></p>

			<h2 class="sec">편의점 유심은 이렇게 생겼어요</h2>
			<figure class="simphoto">
				<img src="/cards/sim-photo.webp" alt="편의점 유심 진열대: KT 바로유심 카드 8,800원, LGU+ 모두의 ONE 유심 원칩 8,800원" width="1100" height="825" loading="lazy" />
				<figcaption>KT 바로유심(왼쪽)과 LG 모두의 유심 원칩(오른쪽). 구매 전에 포장에 적힌 상품명으로 통신망을 꼭 확인하세요.</figcaption>
			</figure>

			<h2 class="sec">한눈에 보는 준비물 카드</h2>
			<div class="cardgrid">
				<img src="/cards/self-prep.webp" alt="셀프개통 전 준비물 체크: 간편인증 1가지, 신분증, 사용 휴대폰, 셀프개통 가능한 유심" width="900" height="900" loading="lazy" />
				<img src="/cards/sim-prep.webp" alt="KT 바로유심과 LG 모두의 유심 원칩 구매처와 유심비 8,800원 안내" width="900" height="900" loading="lazy" />
				<img src="/cards/visit-activation.webp" alt="방문 개통 준비물과 예약 시 보낼 내용, 진행 방법" width="900" height="900" loading="lazy" />
			</div>

			<p style="text-align:center;margin-top:2.5rem"><ShareButton title="알뜰폰 셀프개통 과정 안내 | 커넥트모바일" label="개통 안내 공유하기" /></p>

			<h2 class="sec">함께 보면 좋은 글</h2>
			<div class="more">
				<a href="/blog/usim-delivery/">알뜰폰 유심 받는 방법 (퀵 배송·편의점)</a>
				<a href="/blog/self-activation-10min/">셀프개통 방법: 10분이면 끝</a>
				<a href="/blog/self-activation-troubleshooting/">셀프개통이 안 될 때 확인할 것 6가지</a>
				<a href="/blog/self-activation-face-auth/">안면인증이 안 될 때 촬영 요령</a>
				<a href="/blog/usim-number-input/">셀프개통 유심번호 입력 방법</a>
				<a href="/blog/esim-vs-usim/">eSIM과 실물 유심 차이 비교</a>
				<a href="/blog/visit-activation-reservation/">방문 개통 예약 방법과 준비물</a>
