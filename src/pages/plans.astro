---
import Icon from '../components/Icon.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PlanCards from '../components/PlanCards.astro';
import { ktPrepaid, lgPrepaid } from '../data/prepaidPlans';
import { postpaidPartners } from '../data/postpaidPlans';
import { ktPrepaidMore, lgPrepaidMore, lgPostpaid } from '../data/morePlans';
import { PHONE, PHONE_LINK, KAKAO_URL, SELF_ACTIVATION_URL } from '../consts';

const postpaid = [
	{ src: '/plans/postpaid-milli.webp', alt: 'KT망 밀리의 서재 요금제' },
	{ src: '/plans/postpaid-naverpay.webp', alt: 'KT망 네이버페이 결합 요금제' },
	{ src: '/plans/postpaid-coupang.webp', alt: 'KT망 쿠팡캐시 결합 요금제' },
	{ src: '/plans/postpaid-cu.webp', alt: 'KT망 CU 결합 요금제' },
	{ src: '/plans/postpaid-daiso.webp', alt: 'KT망 다이소 결합 요금제' },
	{ src: '/plans/postpaid-oliveyoung.webp', alt: 'KT망 올리브영 결합 요금제' },
];
const prepaid = [
	{ src: '/cards/kt-prepaid-table.webp', alt: 'KT 선불 요금제 표 - 선불 LTE기본1, 396, 459 등' },
	{ src: '/cards/lg-prepaid-table.webp', alt: 'LG 선불 요금제 표 - L망 선불 기본1, 396, 5G 20GB+ 등' },
];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title="선불폰 요금제 비교 KT·LG 선불·알뜰 요금 | 커넥트모바일" description="KT망·LG망 선불폰 요금제와 KT망 알뜰 결합 요금제를 한눈에 비교하세요. 월 12,100원부터, 약정·위약금 없음." />
		<style>
			.tabs { position: sticky; top: 0; z-index: 5; padding: 0.5rem 0; background: #f5f7fb; display: flex; gap: 0.5rem; justify-content: center; margin: 1rem 0 2rem; }
			.tabs a { padding: 0.5rem 1.2rem; border-radius: 999px; background: rgb(var(--gray-light)); text-decoration: none; color: var(--black); font-weight: 700; }
			.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 1.2rem; }
			.grid img { width: 100%; height: auto; border-radius: 12px; box-shadow: var(--box-shadow); margin: 0; }
			h2 { text-align: center; margin-top: 3rem; scroll-margin-top: 4.5rem; }
			.filter { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-top: 1.5rem; }
			.more { background: #fff; border-radius: 12px; box-shadow: var(--box-shadow); padding: 0.9rem 1.2rem; margin-top: 1.2rem; }
			.more summary { cursor: pointer; font-weight: 700; }
			.more[open] summary { margin-bottom: 1rem; }
			.imgs { background: #fff; border-radius: 12px; box-shadow: var(--box-shadow); padding: 0.9rem 1.2rem; margin-top: 2rem; }
			.imgs summary { cursor: pointer; font-weight: 700; }
			.imgs .grid { margin-top: 1rem; }
			.filter button { border: 0; padding: 0.5rem 1.2rem; border-radius: 999px; background: rgb(var(--gray-light)); font: inherit; font-size: 0.95rem; font-weight: 700; cursor: pointer; }
			.filter button.on { background: var(--accent); color: #fff; }
			.group[hidden] { display: none; }
			.carrier { margin: 2.5rem 0 1rem; font-size: 1.3rem; }
			.note { text-align: center; font-size: 0.85rem; color: rgb(var(--gray)); }
			.cta { text-align: center; margin-top: 2rem; }
			.btn { display: inline-block; margin: 0.3rem; padding: 0.7rem 1.4rem; border-radius: 999px; text-decoration: none; font-weight: 700; background: var(--accent); color: #fff; }
			.btn.alt { background: #fee500; color: #191919; }
			.btn.self { background: #ff3b30; color: #fff; }
		</style>
	</head>
	<body>
		<Header />
		<main class="wide">
			<h1 style="text-align:center">요금제 안내</h1>
			<p class="note"><a href="/#finder">어떤 요금제가 맞는지 모르겠다면? 내게 맞는 요금제 찾기 →</a></p>
			<div class="tabs"><a href="#postpaid">알뜰 요금제</a><a href="#prepaid">선불 요금제</a></div>

			<h2 id="postpaid">알뜰 요금제 (후불)</h2>
			<p class="note">통화·문자 기본제공 요금제입니다. 제휴처를 골라 확인하세요. L망 후불은 아래 "더 보기"에서 볼 수 있어요.</p>
			<div class="filter" data-scope="post" role="group" aria-label="제휴처 선택">
				<button type="button" data-f="all" class="on">전체</button>
				{postpaidPartners.map((p) => <button type="button" data-f={p.key}>{p.name}</button>)}
			</div>
			{postpaidPartners.map((p) => (
				<div class="group" data-scope="post" data-key={p.key}>
					<h3 class="carrier">{p.name} 제휴 요금제</h3>
					<PlanCards plans={p.plans} compare />
				</div>
			))}
			<details class="more lgpost">
				<summary>LG(L)망 알뜰(후불) 요금제 더 보기 ({lgPostpaid.length}개)</summary>
				<PlanCards plans={lgPostpaid} compare />
			</details>
			<details class="imgs">
				<summary>제휴 혜택 상세 이미지 보기</summary>
				<p class="note">이미지를 누르면 크게 볼 수 있습니다.</p>
				<div class="grid">
					{postpaid.map((i) => <a href={i.src} target="_blank" rel="noopener" aria-label={i.alt + " 크게 보기"}><img src={i.src} alt={i.alt} loading="lazy" /></a>)}
				</div>
			</details>

			<h2 id="prepaid">선불 요금제</h2>
			<div class="grid">
				{prepaid.map((i) => <a href={i.src} target="_blank" rel="noopener" aria-label={i.alt + " 크게 보기"}><img src={i.src} alt={i.alt} loading="lazy" /></a>)}
			</div>

			<div class="filter" data-scope="pre" role="group" aria-label="통신사 선택">
				<button type="button" data-f="all" class="on">전체</button>
				<button type="button" data-f="kt">KT망</button>
				<button type="button" data-f="lg">LG(L)망</button>
			</div>
			<div class="group" data-scope="pre" data-key="kt">
				<h3 class="carrier">KT망 선불 요금제</h3>
				<PlanCards plans={ktPrepaid} compare />
				<details class="more">
					<summary>KT망 선불 요금제 더 보기 ({ktPrepaidMore.length}개)</summary>
					<PlanCards plans={ktPrepaidMore} compare />
				</details>
			</div>
			<div class="group" data-scope="pre" data-key="lg">
				<h3 class="carrier">LG(L)망 선불 요금제</h3>
				<PlanCards plans={lgPrepaid} compare />
				<details class="more">
					<summary>LG(L)망 선불 요금제 더 보기 ({lgPrepaidMore.length}개)</summary>
					<PlanCards plans={lgPrepaidMore} compare />
				</details>
			</div>

			<p class="note">※ 요금제 및 제공량은 통신사 사정에 따라 변경될 수 있습니다. 위 요금은 앤텔레콤 공식 요금제 페이지를 기준으로 2026년 10월 1일에 확인한 내용입니다.<br />더 많은 요금제는 <a href="https://info.n-telecom.co.kr/ntelecom-asp/products/all.asp" target="_blank" rel="noopener">앤텔레콤 공식 요금제 페이지</a>에서 확인하실 수 있고, 어떤 요금제가 맞을지는 상담으로 안내해 드립니다.</p>
			<div class="cta">
				<a class="btn self" href={SELF_ACTIVATION_URL} target="_blank" rel="noopener"><Icon name="rocket" />셀프개통 바로가기</a>
				<a class="btn" href={PHONE_LINK}><Icon name="phone" />{PHONE}</a>
				<a class="btn alt" href={KAKAO_URL} target="_blank" rel="noopener"><Icon name="chat" />카카오톡 문의</a>
			</div>
		</main>
		<Footer />
		<script>
				document.querySelectorAll<HTMLElement>(".filter").forEach((bar) => {
					const scope = bar.dataset.scope;
					const btns = bar.querySelectorAll<HTMLButtonElement>("button");
					const groups = document.querySelectorAll<HTMLElement>(`.group[data-scope="${scope}"]`);
					btns.forEach((b) => b.addEventListener("click", () => {
						btns.forEach((x) => x.classList.toggle("on", x === b));
						groups.forEach((g) => { g.hidden = b.dataset.f !== "all" && g.dataset.key !== b.dataset.f; });
					}));
				});
		</script>
	</body>
</html>
