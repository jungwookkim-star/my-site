---
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { PHONE_LINK, PHONE, KAKAO_URL, SELF_ACTIVATION_URL } from '../consts';

import { terms, type Term } from '../data/glossaryTerms';

const cats = ['전체', ...Array.from(new Set(terms.map((t) => t.cat)))];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'DefinedTermSet',
	name: '알뜰폰·선불폰 용어 설명',
	hasDefinedTerm: terms.map((t) => ({ '@type': 'DefinedTerm', name: t.term, description: t.desc })),
};
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title="알뜰폰, 선불폰 용어 설명 | 속도제어, 번호이동, 유심 뜻 | 커넥트모바일"
			description="속도제어, 일 기본료, 번호이동, 유심과 eSIM, APN까지 알뜰폰, 선불폰을 고를 때 헷갈리는 용어를 쉽게 풀어드립니다."
			jsonLd={[schema]}
		/>
		<style>
			.head { text-align: center; padding: 2rem 0 1rem; }
			.head h1 { margin-bottom: 0.5rem; }
			.head p { color: rgb(var(--gray)); margin: 0; }
			.search { max-width: 520px; margin: 1.5rem auto 0.8rem; }
			.search input { width: 100%; box-sizing: border-box; border: 2px solid rgb(var(--gray-light)); border-radius: 999px; padding: 0.75rem 1.2rem; font: inherit; font-size: 1rem; background: var(--surface); }
			.search input:focus { outline: none; border-color: var(--accent); }
			.chips { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-bottom: 1.8rem; }
			.chips button { border: 0; padding: 0.45rem 1.1rem; border-radius: 999px; background: rgb(var(--gray-light)); font: inherit; font-size: 0.9rem; font-weight: 700; cursor: pointer; }
			.chips button.on { background: var(--accent); color: #fff; }
			.list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr)); gap: 1rem; }
			.term { background: var(--surface); border-radius: 14px; box-shadow: var(--box-shadow); padding: 1.1rem 1.3rem; scroll-margin-top: 4rem; }
			.term[hidden] { display: none; }
			.term h2 { margin: 0 0 0.2rem; font-size: 1.1rem; line-height: 1.35; }
			.term h2 small { font-weight: 500; color: rgb(var(--gray)); font-size: 0.8rem; margin-left: 0.3rem; }
			.term .cat { display: inline-block; font-size: 0.72rem; font-weight: 700; color: var(--accent); background: var(--surface-2); padding: 0.05rem 0.55rem; border-radius: 999px; margin-bottom: 0.5rem; }
			.term p { margin: 0; font-size: 0.93rem; color: rgb(var(--gray-dark)); }
			.empty { text-align: center; color: rgb(var(--gray)); margin: 2rem 0; }
			.help { text-align: center; background: var(--surface); border-radius: 16px; box-shadow: var(--box-shadow); padding: 2rem 1rem; margin-top: 3rem; }
			.help h2 { margin: 0 0 0.4rem; font-size: 1.4rem; }
			.help p { color: rgb(var(--gray)); margin: 0 0 1rem; font-size: 0.92rem; }
			.cta { display: flex; gap: 0.7rem; justify-content: center; flex-wrap: wrap; }
			.btn { display: inline-block; padding: 0.7rem 1.4rem; border-radius: 999px; text-decoration: none; font-weight: 700; background: var(--accent); color: #fff; }
			.btn.self { background: #d92d20; }
			.btn.alt { background: #fee500; color: #191919; }
			@media (max-width: 720px) { .cta { flex-direction: column; } .cta .btn { text-align: center; } }
		</style>
	</head>
	<body>
		<Header />
		<main id="main" class="wide">
			<PageHead title="알뜰폰, 선불폰 용어 설명" sub="요금제를 고를 때 헷갈리는 말을 쉽게 풀어 드립니다." />

			<div class="search">
				<input id="q" type="search" placeholder="궁금한 용어를 검색해 보세요 (예: 속도제어)" aria-label="용어 검색" />
			</div>
			<div class="chips" id="chips">
				{cats.map((c, i) => <button type="button" data-c={c} class={i === 0 ? 'on' : ''}>{c}</button>)}
			</div>

			<div class="list" id="list">
				{terms.map((t) => (
					<section class="term" data-cat={t.cat} data-text={`${t.term} ${t.en ?? ''} ${t.desc}`.toLowerCase()} id={`t-${t.term.replace(/[^가-힣a-zA-Z0-9]+/g, '-')}`}>
						<span class="cat">{t.cat}</span>
						<h2>{t.term}{t.en && <small>{t.en}</small>}</h2>
						<p>{t.desc}</p>
					</section>
				))}
			</div>
			<p class="empty" id="empty" hidden>찾는 용어가 없어요. 카카오톡이나 전화로 물어봐 주세요.</p>

			<div class="help">
				<h2>더 궁금한 점이 있으세요?</h2>
				<p>용어가 헷갈리거나 나에게 맞는 요금제가 고민이라면 편하게 문의하세요.</p>
				<div class="cta">
					<a class="btn self" href={SELF_ACTIVATION_URL} target="_blank" rel="noopener"><Icon name="rocket" />셀프개통 바로가기</a>
					<a class="btn alt" href={KAKAO_URL} target="_blank" rel="noopener"><Icon name="chat" />카카오톡 문의</a>
					<a class="btn" href={PHONE_LINK}><Icon name="phone" />{PHONE}</a>
				</div>
			</div>
		</main>
		<Footer />
		<script>
			const input = document.getElementById('q') as HTMLInputElement;
			const chips = document.querySelectorAll<HTMLButtonElement>('#chips button');
			const items = document.querySelectorAll<HTMLElement>('.term');
			const empty = document.getElementById('empty')!;
			let cat = '전체';
			function apply() {
				const q = input.value.trim().toLowerCase();
				let shown = 0;
				items.forEach((el) => {
					const ok = (cat === '전체' || el.dataset.cat === cat) && (!q || (el.dataset.text ?? '').includes(q));
					el.hidden = !ok;
					if (ok) shown++;
				});
				empty.hidden = shown > 0;
			}
			input.addEventListener('input', apply);
			chips.forEach((b) => b.addEventListener('click', () => {
				cat = b.dataset.c ?? '전체';
				chips.forEach((x) => x.classList.toggle('on', x === b));
				apply();
			}));
		</script>
	</body>
</html>
