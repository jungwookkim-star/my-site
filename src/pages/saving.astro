---
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { items } from '../lib/planItems';
import { PHONE, PHONE_LINK, KAKAO_URL } from '../consts';

// 계산에 필요한 값만 화면으로 넘깁니다. (요금 찾기와 같은 요금제 목록·사용량 기준)
const pool = items.map((i) => ({
	name: i.plan.name,
	kind: i.kind,
	tier: i.tier,
	price: i.price,
	data: i.plan.data,
	voice: i.plan.voice,
	sms: i.plan.sms,
}));
const minPrice = Math.min(...items.map((i) => i.price)).toLocaleString('ko-KR');
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title="알뜰폰 요금 절약 계산기 | 지금 통신비 얼마나 줄일 수 있을까? | 커넥트모바일"
			description="지금 내는 통신비를 입력하면 사용량에 맞는 선불, 알뜰 요금제의 월 요금과 절약 금액을 바로 계산해 드립니다. 약정, 위약금 없는 알뜰폰 개통센터 커넥트모바일."
		/>
		<style is:global>
			.sv-head { text-align: center; padding: 2rem 0 1rem; }
			.sv-head h1 { margin-bottom: 0.5rem; }
			.sv-head p { color: rgb(var(--gray)); margin: 0; font-size: 0.95rem; }
			.sv { background: var(--surface); border-radius: 20px; box-shadow: var(--box-shadow); padding: 1.6rem 1.4rem; max-width: 680px; margin: 1rem auto 0; border: 1px solid rgba(var(--gray), 0.1); }
			.sv label.sv-l { display: block; font-weight: 800; margin: 0 0 0.5rem; }
			.sv-sub { display: block; font-weight: 500; font-size: 0.82rem; color: rgb(var(--gray)); margin-top: 0.1rem; }
			.sv-amt { display: flex; align-items: center; gap: 0.5rem; }
			.sv-amt input { flex: 1; min-width: 0; font: inherit; font-size: 1.4rem; font-weight: 800; padding: 0.6rem 1rem; border: 2px solid var(--line); border-radius: 14px; background: var(--surface); text-align: right; }
			.sv-amt input:focus { outline: none; border-color: var(--accent); }
			.sv-amt span { font-weight: 800; font-size: 1.1rem; }
			.sv-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.7rem 0 1.4rem; }
			.sv-chips button { font: inherit; font-size: 0.85rem; font-weight: 700; padding: 0.35rem 0.85rem; border-radius: 999px; border: 1px solid var(--line); background: var(--surface-3); color: var(--accent); cursor: pointer; }
			.sv-chips button:hover { background: var(--surface-2); }
			.sv-tiers { display: grid; gap: 0.5rem; margin-bottom: 1.4rem; }
			.sv-tiers label { display: flex; gap: 0.7rem; align-items: flex-start; padding: 0.75rem 0.9rem; border: 2px solid var(--line); border-radius: 14px; cursor: pointer; transition: border-color 0.15s, background 0.15s; }
			.sv-tiers label:has(input:checked) { border-color: var(--accent); background: var(--surface-3); }
			.sv-tiers input { margin-top: 0.3rem; accent-color: var(--accent); }
			.sv-tiers b { display: block; }
			.sv-tiers small { color: rgb(var(--gray)); font-size: 0.8rem; }
			.sv-out { border-top: 1px dashed var(--line); padding-top: 1.2rem; }
			.sv-empty { text-align: center; color: rgb(var(--gray)); margin: 0.5rem 0; }
			.sv-cards { display: grid; gap: 0.8rem; }
			.sv-card { border-radius: 16px; padding: 1.1rem 1.2rem; background: var(--surface-3); border: 2px solid transparent; }
			.sv-card.good { background: var(--tint-green); border-color: var(--line-green); }
			.sv-card .sv-k { display: inline-block; font-size: 0.75rem; font-weight: 800; padding: 0.12rem 0.65rem; border-radius: 999px; background: var(--surface); color: var(--accent); }
			.sv-card.good .sv-k { color: var(--green); }
			.sv-card h3 { margin: 0.5rem 0 0.2rem; font-size: 1.08rem; }
			.sv-meta { margin: 0 0 0.7rem; font-size: 0.85rem; color: rgb(var(--gray-dark)); }
			.sv-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
			.sv-price { font-size: 1.35rem; font-weight: 800; color: var(--accent); }
			.sv-save { font-weight: 800; color: var(--green); }
			.sv-save small { display: block; font-weight: 600; color: rgb(var(--gray)); font-size: 0.8rem; text-align: right; }
			.sv-no { font-weight: 700; color: rgb(var(--gray)); font-size: 0.9rem; }
			.sv-msg { margin: 0.2rem 0 0.9rem; padding: 0.8rem 1rem; border-radius: 12px; background: var(--tint-amber); font-size: 0.9rem; }
			.sv-cta { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.9rem; }
			.sv-cta .btn { display: inline-block; font-size: 0.9rem; font-weight: 700; padding: 0.6rem 1.1rem; border-radius: 999px; text-decoration: none; text-align: center; background: var(--accent); color: #fff; box-shadow: 0 4px 12px rgba(35, 55, 255, 0.22); }
			.sv-cta .btn.alt { background: #fee500; color: #191919; box-shadow: 0 4px 12px rgba(254, 229, 0, 0.45); }
			.sv-cta .btn.ghost { background: var(--surface); color: var(--accent); box-shadow: inset 0 0 0 2px var(--accent); }
			.sv-cta .btn .ic { margin-right: 0.35em; }
			.sv-notes { max-width: 680px; margin: 1.5rem auto 0; font-size: 0.85rem; color: rgb(var(--gray-dark)); }
			.sv-notes h2 { font-size: 1rem; margin: 0 0 0.5rem; }
			.sv-notes ul { padding-left: 1.1rem; margin: 0; }
			.sv-notes li { margin-bottom: 0.4rem; }
			@media (max-width: 720px) {
				.sv { padding: 1.2rem 1rem; }
				.sv-cta .btn { flex: 1 1 100%; }
				.sv-save small { text-align: left; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main">
			<PageHead title="알뜰폰으로 바꾸면 얼마나 아낄까?" sub="지금 내는 통신비를 넣으면, 사용량에 맞는 요금제와 절약 금액을 바로 계산해 드려요." />

			<div class="sv" id="sv">
				<label class="sv-l" for="bill">한 달에 내는 통신비<span class="sv-sub">단말기 할부금은 빼고, 통신 요금만 넣어 주세요.</span></label>
				<div class="sv-amt">
					<input id="bill" type="text" inputmode="numeric" autocomplete="off" placeholder="예: 55,000" aria-describedby="sv-hint" />
					<span>원</span>
				</div>
				<div class="sv-chips" role="group" aria-label="금액 빠른 선택">
					{[30000, 40000, 50000, 60000, 70000, 80000, 100000].map((v) => <button type="button" data-v={v}>{(v / 10000).toLocaleString('ko-KR')}만 원</button>)}
				</div>

				<span class="sv-l" id="sv-use" style="display:block;font-weight:800;margin-bottom:0.5rem">주로 어떻게 쓰세요?</span>
				<div class="sv-tiers" role="radiogroup" aria-labelledby="sv-use">
					<label><input type="radio" name="tier" value="1" /><span><b>통화·문자 위주</b><small>데이터는 거의 안 써요</small></span></label>
					<label><input type="radio" name="tier" value="2" checked /><span><b>가볍게 인터넷</b><small>메신저, 검색, 지도 정도</small></span></label>
					<label><input type="radio" name="tier" value="3" /><span><b>영상·SNS를 많이 봐요</b><small>데이터를 넉넉하게 쓰고 싶어요</small></span></label>
				</div>

				<div class="sv-out" id="sv-out" aria-live="polite">
					<p class="sv-empty" id="sv-hint">금액을 입력하면 결과가 여기에 나타나요.</p>
				</div>
			</div>

			<div class="sv-notes">
				<h2>계산하기 전에 알아두세요</h2>
				<ul>
					<li>입력하신 금액과 요금제의 <b>월 요금을 단순 비교</b>한 계산이에요. 단말기 할부금, 선택약정·결합 할인, 부가서비스에 따라 실제 차이는 달라질 수 있어요.</li>
					<li>선불 요금제는 <b>개통 당일 요금 충전</b>이 필요해요.</li>
					<li>알뜰(후불) 요금제는 다른 통신사에 체납이 있으면 개통할 수 없어요. 선불은 개통할 수 있는 것으로 안내돼요.</li>
					<li>요금제와 제공량은 통신사 사정에 따라 바뀔 수 있어요. 개통 전 최신 내용은 상담으로 확인해 주세요.</li>
					<li>커넥트모바일 요금제는 약정·위약금이 없고, 선불 요금제는 월 {minPrice}원부터 시작해요.</li>
				</ul>
				<p style="margin-top:1rem"><a href="/#check">나는 셀프개통이 될까? 진단하기</a> · <a href="/plans/">전체 요금제 보기</a> · <a href={KAKAO_URL} target="_blank" rel="noopener">카카오톡 문의</a> · <a href={PHONE_LINK}>{PHONE}</a></p>
			</div>

			<script type="application/json" id="sv-pool" set:html={JSON.stringify(pool)} />
		</main>
		<Footer />

		<script define:vars={{ kakao: KAKAO_URL }}>
			const pool = JSON.parse(document.getElementById('sv-pool').textContent);
			const input = document.getElementById('bill');
			const out = document.getElementById('sv-out');
			const KIND = { prepaid: '선불', alddeul: '알뜰(후불)' };
			const won = (n) => n.toLocaleString('ko-KR') + '원';
			const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };

			function track(name, params) {
				const gtag = window.gtag;
				if (gtag) gtag('event', name, { page_path: location.pathname, ...params });
			}

			function cheapest(tier, kind) {
				const c = pool.filter((p) => p.tier === tier && p.kind === kind);
				return c.length ? c.sort((a, b) => a.price - b.price)[0] : null;
			}

			let lastKey = '';
			function render() {
				const bill = Number(input.value.replace(/[^0-9]/g, ''));
				const tier = Number(document.querySelector('input[name="tier"]:checked').value);
				out.replaceChildren();
				if (!bill || bill < 5000) {
					out.append(el('p', 'sv-empty', bill ? '5,000원 이상으로 입력해 주세요.' : '금액을 입력하면 결과가 여기에 나타나요.'));
					return;
				}
				const picks = ['prepaid', 'alddeul'].map((k) => cheapest(tier, k)).filter(Boolean);
				const cards = el('div', 'sv-cards');
				let anySaving = false;
				for (const p of picks) {
					const saving = bill - p.price;
					const good = saving > 0;
					if (good) anySaving = true;
					const card = el('div', 'sv-card' + (good ? ' good' : ''));
					card.append(el('span', 'sv-k', KIND[p.kind]));
					card.append(el('h3', '', p.name));
					card.append(el('p', 'sv-meta', `데이터 ${p.data} · 음성 ${p.voice} · 문자 ${p.sms}`));
					const row = el('div', 'sv-row');
					row.append(el('span', 'sv-price', `월 ${won(p.price)}`));
					if (good) {
						const s = el('span', 'sv-save', `월 ${won(saving)} 절약`);
						s.append(el('small', '', `1년이면 약 ${won(saving * 12)}`));
						row.append(s);
					} else {
						row.append(el('span', 'sv-no', '지금 요금과 비슷하거나 더 높아요'));
					}
					card.append(row);
					cards.append(card);
				}
				if (!anySaving) {
					out.append(el('p', 'sv-msg', '지금 내시는 요금이 이미 충분히 저렴해요. 이 사용량이라면 굳이 바꾸지 않으셔도 괜찮습니다. 데이터를 더 쓰고 싶거나 조건이 궁금하시면 상담으로 확인해 보세요.'));
				}
				out.append(cards);
				const cta = el('div', 'sv-cta');
				const a1 = el('a', 'btn alt'); a1.href = kakao; a1.target = '_blank'; a1.rel = 'noopener'; a1.textContent = '카카오톡으로 문의';
				const a2 = el('a', 'btn ghost'); a2.href = '/plans/'; a2.textContent = '전체 요금제 보기';
				const a3 = el('a', 'btn ghost'); a3.href = '/#check'; a3.textContent = '개통 가능 여부 진단';
				cta.append(a1, a2, a3);
				out.append(cta);

				const key = `${tier}|${Math.round(bill / 10000)}`;
				if (key !== lastKey) { lastKey = key; track('savings_calc', { tier: String(tier), bill_bucket: String(Math.round(bill / 10000) * 10000), saved: anySaving ? 'yes' : 'no' }); }
			}

			input.addEventListener('input', () => {
				const digits = input.value.replace(/[^0-9]/g, '').slice(0, 7);
				input.value = digits ? Number(digits).toLocaleString('ko-KR') : '';
				render();
			});
			document.querySelectorAll('.sv-chips button').forEach((b) => b.addEventListener('click', () => {
				input.value = Number(b.dataset.v).toLocaleString('ko-KR');
				render();
			}));
			document.querySelectorAll('input[name="tier"]').forEach((r) => r.addEventListener('change', render));
		</script>
	</body>
</html>
