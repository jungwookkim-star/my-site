---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title="블로그 | 커넥트모바일" description="알뜰폰 개통, 번호이동, 요금제 비교 등 개통 전에 알아두면 좋은 정보를 모았습니다." />
		<style>
			main { width: 960px; }
			h1 { text-align: center; margin-bottom: 0.3rem; }
			.lead { text-align: center; color: rgb(var(--gray)); margin: 0 0 2rem; font-size: 0.95rem; }
			ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.2rem; list-style: none; margin: 0; padding: 0; }
			li { display: flex; }
			li a { display: flex; flex-direction: column; flex: 1; background: #fff; border-radius: 14px; box-shadow: var(--box-shadow); padding: 1.2rem 1.3rem; text-decoration: none; transition: transform 0.15s; }
			li a:hover { transform: translateY(-3px); }
			.title { margin: 0 0 0.6rem; color: rgb(var(--black)); font-size: 1.1rem; line-height: 1.4; }
			.desc { margin: 0 0 0.8rem; color: rgb(var(--gray-dark)); font-size: 0.88rem; line-height: 1.55; flex: 1; }
			.date { margin: 0; color: rgb(var(--gray)); font-size: 0.8rem; }
			li a:hover .title { color: var(--accent); }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>블로그</h1>
			<p class="lead">알뜰폰 개통 전에 알아두면 좋은 정보를 모았습니다.</p>
			<ul>
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<h2 class="title">{post.data.title}</h2>
								<p class="desc">{post.data.description}</p>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
