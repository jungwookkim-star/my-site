---
import Icon from '../../components/Icon.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { REGIONS } from '../../data/regions';
import { PHONE, PHONE_LINK, KAKAO_URL, SELF_ACTIVATION_URL, HOURS } from '../../consts';

export function getStaticPaths() {
	return REGIONS.map((region) => ({ params: { slug: region.slug }, props: { region } }));
}
const { region } = Astro.props;
const title = `${region.name} 알뜰폰 선불·알뜰 요금제 개통 | 커넥트모바일`;
const description = `${region.full} 어디서나 비대면으로 선불·알뜰 요금제 휴대폰 개통 상담. ${region.cities.slice(0, 3).join(', ')} 등 ${region.name} 지역 고객도 전화·카카오톡으로 간편하게 문의하세요.`;
const faqs = [
	{ q: `${region.name}에 살아도 개통할 수 있나요?`, a: `네. 커넥트모바일은 전국 어디서나 비대면으로 상담과 개통을 도와드립니다. ${region.full} 지역 고객도 동일하게 이용하실 수 있습니다.` },
	{ q: `${region.name}에서 유심은 어떻게 받나요?`, a: region.quick ? `${region.name}은 퀵 배송을 이용할 수 있습니다. 주문 10:00~22:00, 배송비 무료이며 지역에 따라 다르지만 대부분 2시간 이내에 받아보실 수 있습니다(일부 지역은 제외될 수 있어 상담 시 확인해 드립니다). 가까운 편의점에서 유심을 구매할 수도 있습니다. 유심비는 8,800원이고, 수령 후 약 10분이면 셀프개통이 가능합니다.` : `${region.name}은 퀵 배송 지역(서울·수도권·광역시·제주)이 아니라서, 가까운 편의점에서 유심을 구매해 개통하시면 됩니다. KT 바로유심은 CU·이마트24·GS25·세븐일레븐, LG 모두의 유심 원칩은 이마트24·배민B마트에서 구매할 수 있고 유심비는 8,800원입니다. 구매 후 약 10분이면 셀프개통이 가능합니다.` },
	{ q: `${region.name}에서 직접 방문해야 하나요?`, a: '직접 방문하지 않고 전화나 카카오톡으로 상담하실 수 있습니다. 개통 방식은 상담 시 안내해 드립니다.' },
	{ q: `${region.name} 거주자도 미납·연체 이력이 있거나 외국인, 미성년자면 개통이 어렵나요?`, a: '선불 요금제는 다른 통신사 미납이 있어도 개통할 수 있는 것으로 안내되어 있고, 알뜰(후불)은 조건이 달라 상담이 필요합니다. 외국인·미성년자는 비대면 셀프개통이 안 되고 대면 개통(예약 후 방문)만 가능합니다. 자세한 조건은 상담 시 안내해 드립니다.' },
	{ q: `${region.name}에서 외국인·미성년자는 어디서 개통하나요?`, a: region.centers.length ? `대면 개통만 가능하며 ${region.name}의 ${region.centers.join(', ')}에 사업장이 있습니다. 방문 전에 반드시 예약해야 하고, 상세 주소는 예약 시 안내해 드립니다.` : `${region.name}에는 대면 개통 사업장이 없어 가까운 지역 사업장으로 안내해 드립니다. 방문 전에 반드시 예약해야 합니다.` },
	{ q: '요금제에는 약정이나 위약금이 있나요?', a: '커넥트모바일 요금제는 약정 NO, 위약금 NO 입니다. 유심비는 8,800원이며, 퀵 배송으로 받으시면 배송비는 없습니다.' },
	{ q: '선불과 알뜰 요금제 중 어떤 걸 골라야 하나요?', a: '요금을 먼저 내는 선불, 사용 후 내는 알뜰 요금제(후불)가 있습니다. 상황에 맞는 방식을 상담으로 안내해 드립니다.' },
];
const faqSchema = {	'@context': 'https://schema.org',	'@type': 'FAQPage',	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),};
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={title} description={description} jsonLd={[faqSchema]} />
		<style>
			.hero { text-align: center; padding: 2.5rem 0 1.5rem; }
			.hero h1 { font-size: 2rem; margin-bottom: 0.5rem; }
			.hero p { color: rgb(var(--gray)); margin: 0; }
			.cta { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem; }
			.btn { display: inline-block; padding: 0.7rem 1.4rem; border-radius: 999px; text-decoration: none; font-weight: 700; background: var(--accent); color: #fff; }
			.btn.alt { background: #fee500; color: #191919; }
			.btn.self { background: #ff3b30; color: #fff; }
			.btn.ghost { background: #fff; color: var(--accent); box-shadow: inset 0 0 0 2px var(--accent); }
			section { margin-top: 3rem; }
			h2.sec { text-align: center; }
			.chips { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
			.chips span, .chips a { background: #fff; box-shadow: var(--box-shadow); padding: 0.3rem 0.9rem; border-radius: 999px; font-size: 0.9rem; text-decoration: none; color: var(--black); }
			.chips a:hover { background: #eef1ff; }
			details { background: #fff; border-radius: 12px; box-shadow: var(--box-shadow); padding: 0.9rem 1.2rem; margin-bottom: 0.7rem; }
			summary { cursor: pointer; font-weight: 700; }
			details p { margin: 0.6rem 0 0; font-size: 0.92rem; }
			ul.pts { padding-left: 1.2rem; }
			.local { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.8rem; margin-top: 1rem; }
			.local div { background: #fff; box-shadow: var(--box-shadow); border-radius: 12px; padding: 1rem 1.1rem; }
			.local p { margin: 0.4rem 0 0; font-size: 0.9rem; color: rgb(var(--gray)); }
		</style>
	</head>
	<body>
		<Header />
		<main class="wide">
			<div class="hero">
				<h1>{region.name} 알뜰폰 선불·알뜰 요금제 개통</h1>
				<p>{region.full} 어디서나 비대면으로 간편하게 개통해 드립니다.</p>
				<div class="cta">
					<a class="btn self" href={SELF_ACTIVATION_URL} target="_blank" rel="noopener"><Icon name="rocket" />셀프개통 바로가기</a>
					<a class="btn" href={PHONE_LINK}><Icon name="phone" />전화 상담 {PHONE}</a>
					<a class="btn alt" href={KAKAO_URL} target="_blank" rel="noopener"><Icon name="chat" />카카오톡 문의</a>
				</div>
			</div>

			<section>
				<h2 class="sec">{region.name} 지역 개통 상담</h2>
				<p style="text-align:center">아래 지역을 포함해 {region.full} 전 지역에서 상담하실 수 있습니다.</p>
				<div class="chips">
					{region.cities.map((c) => <span>{c} 선불폰 개통</span>)}
				</div>
			</section>

			<section>
				<h2 class="sec">{region.name}에서 개통하는 방법</h2>
				<div class="local">
					<div><strong>유심 준비</strong><p>{region.quick ? '퀵 배송(주문 10:00~22:00, 배송비 무료) 또는 편의점 구매. 유심비 8,800원.' : '가까운 편의점에서 유심 구매. 유심비 8,800원.'}</p></div>
					<div><strong>셀프개통</strong><p>신규가입 08:00~21:50, 번호이동 10:00~19:50. 약 10분이면 끝납니다.</p></div>
					<div><strong>대면 개통</strong><p>{region.centers.length ? `외국인·미성년자는 ${region.name}의 ${region.centers.slice(0, 3).join(', ')}${region.centers.length > 3 ? ' 등' : ''} 사업장에서 대면 개통할 수 있습니다. 방문 전 예약이 필수입니다.` : '세종에는 대면 개통 사업장이 없어 대전·충남·충북 등 가까운 지역 사업장으로 안내해 드립니다. 방문 전 예약이 필수입니다.'}</p></div>
				</div>
			</section>

			<section>
				<h2 class="sec">{region.name} 대면 개통 가능 지역</h2>
				<p style="text-align:center">외국인·미성년자는 셀프개통이 안 되고 대면 개통만 가능합니다. 아래 지역에 사업장이 있으며, <strong>반드시 사전에 예약</strong>하고 방문해야 합니다.</p>
				{region.centers.length > 0 ? (
					<div class="chips">{region.centers.map((c) => <span>{c}</span>)}</div>
				) : (
					<p style="text-align:center">{region.name}에는 등록된 대면 개통 사업장이 없습니다. 가까운 지역 사업장은 상담으로 안내해 드립니다.</p>
				)}
				<p style="text-align:center;font-size:0.88rem;color:rgb(var(--gray))">상세 주소와 방문 시간은 예약 시 안내해 드립니다. 전화 {PHONE} 또는 카카오톡으로 예약해 주세요.</p>
			</section>

			<section>
				<h2 class="sec">{region.name} 고객이 선택하는 이유</h2>
				<ul class="pts">
					<li>약정 NO · 위약금 NO 요금제 안내</li>
					<li>KT망·LG망 선불 요금제와 KT망 알뜰 결합 요금제 취급</li>
					<li>{region.quick ? '유심 퀵 배송 또는 편의점 구매, 약 10분 셀프개통' : '편의점에서 유심 구매, 약 10분 셀프개통'}</li>
				<li>선불은 타 통신사 미납도 개통 가능, 외국인·미성년자는 서류 확인 후 개통</li>
				<li>방문 없이 전화·카카오톡으로 상담하고 개통</li>
					<li>운영시간 {HOURS}</li>
				</ul>
				<p style="text-align:center"><a class="btn ghost" href="/plans">요금제 전체 보기 →</a></p>
			</section>

			<section>
				<h2 class="sec">{region.name} 개통 자주 묻는 질문</h2>
				{faqs.map((f) => (
					<details><summary>{f.q}</summary><p>{f.a}</p></details>
				))}
			</section>

			<section>
				<h2 class="sec">다른 지역도 확인하세요</h2>
				<div class="chips">
					{REGIONS.filter((r) => r.slug !== region.slug).map((r) => <a href={`/region/${r.slug}/`}>{r.name}</a>)}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
